@model OkulTakipSistemi.Models.OkulUcreti

@{
    ViewData["Title"] = "Okul Ücreti Ekle";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            Okul Ücreti Tanımla
        </h2>

        <p class="text-muted">
            Okul ücretini peşin veya taksitli olarak belirleyebilirsiniz.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <!-- OKUL -->

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Okul
                    </label>

                    <select asp-for="OkulId"
                            class="form-select"
                            required>

                        <option value="">
                            -- Okul Seçin --
                        </option>

                        @foreach (var okul in ViewBag.Okullar)
                        {
                            <option value="@okul.Id">
                                @okul.Ad
                            </option>
                        }

                    </select>

                    <span asp-validation-for="OkulId"
                          class="text-danger">
                    </span>

                </div>


                <!-- TOPLAM ÜCRET -->

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Toplam Okul Ücreti
                    </label>

                    <div class="input-group">

                        <input asp-for="ToplamUcret"
                               id="ToplamUcret"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0"
                               required />

                        <span class="input-group-text">
                            ₺
                        </span>

                    </div>

                    <span asp-validation-for="ToplamUcret"
                          class="text-danger">
                    </span>

                </div>


                <!-- ÖDEME ŞEKLİ -->

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Ödeme Şekli
                    </label>

                    <select asp-for="OdemeSekli"
                            id="OdemeSekli"
                            class="form-select">

                        <option value="Taksitli">
                            Taksitli Ödeme
                        </option>

                        <option value="Pesin">
                            Peşin Ödeme
                        </option>

                    </select>

                </div>


                <!-- TAKSİT SAYISI -->

                <div class="mb-3"
                     id="taksitAlani">

                    <label class="form-label fw-semibold">
                        Kaç Ay Taksit?
                    </label>

                    <select asp-for="TaksitAySayisi"
                            id="TaksitAySayisi"
                            class="form-select">

                        <option value="2">
                            2 Ay
                        </option>

                        <option value="3">
                            3 Ay
                        </option>

                        <option value="4">
                            4 Ay
                        </option>

                        <option value="5">
                            5 Ay
                        </option>

                        <option value="6">
                            6 Ay
                        </option>

                        <option value="7">
                            7 Ay
                        </option>

                        <option value="8">
                            8 Ay
                        </option>

                        <option value="9">
                            9 Ay
                        </option>

                        <option value="10">
                            10 Ay
                        </option>

                        <option value="11">
                            11 Ay
                        </option>

                        <option value="12" selected>
                            12 Ay
                        </option>

                    </select>

                    <small class="text-muted">
                        Toplam ücretin kaç ayda ödeneceğini seçin.
                    </small>

                </div>


                <!-- BAŞLANGIÇ AYI -->

                <div class="mb-3"
                     id="baslangicAyiAlani">

                    <label class="form-label fw-semibold">
                        Ödeme Başlangıç Ayı
                    </label>

                    <select asp-for="BaslangicAyi"
                            id="BaslangicAyi"
                            class="form-select">

                        <option value="1">
                            Ocak
                        </option>

                        <option value="2">
                            Şubat
                        </option>

                        <option value="3">
                            Mart
                        </option>

                        <option value="4">
                            Nisan
                        </option>

                        <option value="5">
                            Mayıs
                        </option>

                        <option value="6">
                            Haziran
                        </option>

                        <option value="7">
                            Temmuz
                        </option>

                        <option value="8">
                            Ağustos
                        </option>

                        <option value="9" selected>
                            Eylül
                        </option>

                        <option value="10">
                            Ekim
                        </option>

                        <option value="11">
                            Kasım
                        </option>

                        <option value="12">
                            Aralık
                        </option>

                    </select>

                </div>


                <!-- GEÇERLİLİK TARİHİ -->

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Geçerlilik Tarihi
                    </label>

                    <input asp-for="GecerlilikTarihi"
                           class="form-control"
                           type="date"
                           required />

                </div>


                <!-- AÇIKLAMA -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Açıklama
                    </label>

                    <textarea asp-for="Aciklama"
                              class="form-control"
                              rows="3"
                              placeholder="Örneğin: 2026-2027 eğitim öğretim yılı"></textarea>

                </div>


                <!-- ÖDEME PLANI -->

                <div class="alert alert-info">

                    <strong>Ödeme Planı:</strong>

                    <div id="hesaplama"
                         class="mt-2">
                    </div>

                </div>


                <!-- BUTONLAR -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        Ücreti Kaydet ve Ödeme Planını Oluştur

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Vazgeç

                    </a>

                </div>

            </form>

        </div>
    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function hesapla() {

            var toplam =
                parseFloat(
                    document.getElementById("ToplamUcret").value
                ) || 0;

            var odemeSekli =
                document.getElementById("OdemeSekli").value;

            var ay =
                parseInt(
                    document.getElementById("TaksitAySayisi").value
                ) || 12;


            if (odemeSekli === "Pesin") {

                document.getElementById("hesaplama").innerHTML =
                    "Toplam " +
                    toplam.toLocaleString("tr-TR", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }) +
                    " ₺ <strong>peşin</strong> olarak ödenecektir.";

            }
            else {

                var aylik = toplam / ay;

                document.getElementById("hesaplama").innerHTML =
                    "Toplam " +
                    toplam.toLocaleString("tr-TR", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }) +
                    " ₺ / " +
                    ay +
                    " ay = <strong>" +
                    aylik.toLocaleString("tr-TR", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }) +
                    " ₺ / ay</strong>";

            }
        }


        function odemeSekliDegisti() {

            var odemeSekli =
                document.getElementById("OdemeSekli").value;

            var taksitAlani =
                document.getElementById("taksitAlani");

            var baslangicAlani =
                document.getElementById("baslangicAyiAlani");


            if (odemeSekli === "Pesin") {

                taksitAlani.style.display = "none";

                baslangicAlani.style.display = "none";

                // Backend peşin ödemeyi 1 taksit olarak kabul edecek.
                document.getElementById("TaksitAySayisi").value = "1";

            }
            else {

                taksitAlani.style.display = "block";

                baslangicAlani.style.display = "block";

                if (
                    document.getElementById("TaksitAySayisi").value === "1"
                ) {
                    document.getElementById("TaksitAySayisi").value = "12";
                }
            }

            hesapla();
        }


        document
            .getElementById("ToplamUcret")
            .addEventListener("input", hesapla);


        document
            .getElementById("TaksitAySayisi")
            .addEventListener("change", hesapla);


        document
            .getElementById("OdemeSekli")
            .addEventListener("change", odemeSekliDegisti);


        odemeSekliDegisti();

    </script>
}
