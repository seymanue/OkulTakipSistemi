@model IEnumerable<OkulTakipSistemi.Models.OkulUcreti>

@{
    ViewData["Title"] = "Okul Ücretleri";
}

<style>
    .school-fee-page {
        min-height: calc(100vh - 80px);
        padding: 30px 32px 50px;
        background: #f4f7fb;
    }

    .school-fee-inner {
        max-width: 1450px;
        margin: 0 auto;
    }

    /* BAŞLIK */

    .school-fee-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
        padding: 26px 30px;
        border: 1px solid #d9eaf8;
        border-radius: 20px;
        background: linear-gradient(135deg, #eaf5ff 0%, #d8ecff 55%, #c7e3fb 100%);
        box-shadow: 0 8px 25px rgba(26, 64, 99, 0.07);
    }

    .school-fee-title-area {
        display: flex;
        align-items: center;
        gap: 17px;
    }

    .school-fee-title-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 54px;
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 5px 15px rgba(25, 87, 145, 0.10);
        font-size: 26px;
    }

    .school-fee-header h1 {
        margin: 0 0 5px;
        color: #163b61;
        font-size: 27px;
        font-weight: 800;
    }

    .school-fee-header p {
        margin: 0;
        color: #607b95;
        font-size: 14px;
    }

    /* MESAJ */

    .school-fee-alert {
        margin-bottom: 22px;
        padding: 15px 18px;
        border: 1px solid #bfe6d0;
        border-radius: 14px;
        background: #effbf4;
        color: #26734d;
        box-shadow: 0 5px 15px rgba(32, 102, 68, 0.05);
    }

    /* KART */

    .school-fee-card {
        overflow: hidden;
        margin-bottom: 22px;
        border: 1px solid #e3eaf1;
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 8px 25px rgba(26, 64, 99, 0.06);
    }

    .school-fee-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 21px 24px;
        border-bottom: 1px solid #edf1f5;
    }

    .school-fee-card-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        border-radius: 13px;
        background: #e8f4ff;
        font-size: 21px;
    }

    .school-fee-card-title {
        color: #173d62;
        font-size: 17px;
        font-weight: 750;
    }

    .school-fee-card-subtitle {
        margin-top: 3px;
        color: #8798aa;
        font-size: 12px;
    }

    .school-fee-card-body {
        padding: 22px 24px;
    }

    .school-fee-add-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 19px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #1971c2, #2688d8);
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 6px 16px rgba(25, 113, 194, 0.20);
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .school-fee-add-button:hover {
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 9px 20px rgba(25, 113, 194, 0.27);
    }

    /* TABLO */

    .school-fee-table-card {
        overflow: hidden;
        border: 1px solid #e3eaf1;
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 8px 25px rgba(26, 64, 99, 0.06);
    }

    .school-fee-table-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 21px 24px;
        border-bottom: 1px solid #edf1f5;
    }

    .school-fee-table-wrap {
        overflow-x: auto;
    }

    .school-fee-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

    .school-fee-table thead th {
        padding: 14px 24px;
        border: none;
        background: #f7faff;
        color: #70849a;
        font-size: 12px;
        font-weight: 750;
        letter-spacing: .2px;
        text-transform: uppercase;
    }

    .school-fee-table tbody td {
        padding: 18px 24px;
        border-top: 1px solid #edf1f5;
        color: #294a68;
        font-size: 14px;
        vertical-align: middle;
    }

    .school-fee-table tbody tr {
        transition: background .18s ease;
    }

    .school-fee-table tbody tr:hover {
        background: #f8fbfe;
    }

    .school-name {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
    }

    .school-name-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: #e8f4ff;
        font-size: 18px;
    }

    .school-fee-amount {
        color: #173d62;
        font-size: 15px;
        font-weight: 800;
    }

    .school-fee-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .school-fee-edit,
    .school-fee-delete {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 82px;
        padding: 8px 12px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: all .18s ease;
    }

    .school-fee-edit {
        border: 1px solid #c8e1f7;
        background: #f1f8ff;
        color: #1971c2;
    }

    .school-fee-edit:hover {
        background: #e1f1ff;
        color: #0d5b9e;
    }

    .school-fee-delete {
        border: 1px solid #f2caca;
        background: #fff6f6;
        color: #c94c4c;
        cursor: pointer;
    }

    .school-fee-delete:hover {
        background: #ffebeb;
        color: #ad3636;
    }

    .school-fee-empty {
        margin: 22px 24px;
        padding: 28px 20px;
        border: 1px dashed #cbd9e6;
        border-radius: 15px;
        background: #f8fbfe;
        color: #7d91a5;
        text-align: center;
        font-size: 14px;
    }

    @@media (max-width: 800px) {
        .school-fee-page {
            padding: 20px 15px 40px;
        }

        .school-fee-header {
            align-items: flex-start;
            padding: 22px;
        }

        .school-fee-header h1 {
            font-size: 23px;
        }

        .school-fee-table thead th,
        .school-fee-table tbody td {
            padding-left: 16px;
            padding-right: 16px;
        }

        .school-fee-actions {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 500px) {
        .school-fee-title-icon {
            display: none;
        }

        .school-fee-header {
            padding: 20px;
        }

        .school-fee-card-header,
        .school-fee-table-header {
            padding: 18px;
        }

        .school-fee-card-body {
            padding: 18px;
        }
    }
</style>

<div class="school-fee-page">

    <div class="school-fee-inner">

        <!-- BAŞLIK -->

        <div class="school-fee-header">

            <div class="school-fee-title-area">

                <div class="school-fee-title-icon">
                    🏫
                </div>

                <div>
                    <h1>Okul Ücretleri</h1>

                    <p>
                        Okulların yıllık eğitim ücretlerini belirleyin.
                    </p>
                </div>

            </div>

        </div>


        <!-- BAŞARILI MESAJ -->

        @if (TempData["Basarili"] != null)
        {
            <div class="school-fee-alert"
                 role="alert">

                <strong>Başarılı:</strong>
                @TempData["Basarili"]

            </div>
        }


        <!-- YENİ OKUL ÜCRETİ -->

        <div class="school-fee-card">

            <div class="school-fee-card-header">

                <div class="school-fee-card-icon">
                    💰
                </div>

                <div>
                    <div class="school-fee-card-title">
                        Okul Yıllık Ücreti Belirle
                    </div>

                    <div class="school-fee-card-subtitle">
                        Seçtiğiniz okul için yıllık eğitim ücretini tanımlayın.
                    </div>
                </div>

            </div>

            <div class="school-fee-card-body">

                <a asp-action="Create"
                   class="school-fee-add-button">
                    ＋ Okul Ücreti Belirle
                </a>

            </div>

        </div>


        <!-- TANIMLI ÜCRETLER -->

        <div class="school-fee-table-card">

            <div class="school-fee-table-header">

                <div class="school-fee-card-icon">
                    📋
                </div>

                <div>
                    <div class="school-fee-card-title">
                        Tanımlanan Okul Ücretleri
                    </div>

                    <div class="school-fee-card-subtitle">
                        Sistemde kayıtlı yıllık okul ücretleri.
                    </div>
                </div>

            </div>

            @if (!Model.Any())
            {
                <div class="school-fee-empty">
                    Henüz okul için yıllık ücret belirlenmemiş.
                </div>
            }
            else
            {
                <div class="school-fee-table-wrap">

                    <table class="school-fee-table">

                        <thead>
                            <tr>
                                <th>Okul</th>
                                <th>Yıllık Ücret</th>
                                <th style="text-align:right;">İşlem</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var ucret in Model)
                            {
                                <tr>

                                    <td>
                                        <div class="school-name">

                                            <div class="school-name-icon">
                                                🏫
                                            </div>

                                            <span>
                                                @(ucret.Okul?.Ad ?? "Okul belirtilmemiş")
                                            </span>

                                        </div>
                                    </td>

                                    <td>
                                        <span class="school-fee-amount">
                                            @ucret.ToplamUcret.ToString("N2") ₺
                                        </span>
                                    </td>

                                    <td>

                                        <div class="school-fee-actions">

                                            <a asp-action="Edit"
                                               asp-route-id="@ucret.Id"
                                               class="school-fee-edit">
                                                Düzenle
                                            </a>

                                            <button type="button"
                                                    class="school-fee-delete"
                                                    data-school-id="@ucret.OkulId"
                                                    data-school-name="@ucret.Okul?.Ad"
                                                    onclick="okulSilmeOnayi(this);">
                                                Sil
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

<style>
    .okul-silme-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(15, 35, 55, 0.50);
        backdrop-filter: blur(5px);
    }

    .okul-silme-modal-overlay.aktif {
        display: flex;
    }

    .okul-silme-modal {
        width: min(500px, 100%);
        padding: 34px;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 25px 70px rgba(22, 59, 97, 0.24);
        text-align: center;
        animation: okulSilmeModalAc 0.2s ease-out;
    }

    .okul-silme-modal-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: #fff1f1;
        font-size: 31px;
    }

    .okul-silme-modal h3 {
        margin: 0 0 10px;
        color: #163b61;
        font-size: 23px;
        font-weight: 800;
    }

    .okul-silme-modal p {
        margin: 0 auto;
        max-width: 410px;
        color: #607b95;
        font-size: 14px;
        line-height: 1.65;
    }

    .okul-silme-modal-okul {
        margin: 17px auto 0;
        padding: 12px 18px;
        border-radius: 13px;
        background: #eef6ff;
        color: #1769aa;
        font-size: 15px;
        font-weight: 800;
        max-width: 360px;
        word-break: break-word;
    }

    .okul-silme-modal-uyari {
        margin-top: 16px;
        padding: 11px 14px;
        border-radius: 12px;
        background: #fff8e8;
        color: #8a6418;
        font-size: 13px;
        font-weight: 600;
    }

    .okul-silme-modal-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 25px;
    }

    .okul-silme-modal-btn {
        min-width: 125px;
        padding: 11px 20px;
        border: 0;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .okul-silme-modal-vazgec {
        background: #eef3f8;
        color: #526b82;
    }

    .okul-silme-modal-vazgec:hover {
        background: #e2eaf2;
        transform: translateY(-1px);
    }

    .okul-silme-modal-sil {
        background: #dc3545;
        color: #ffffff;
    }

    .okul-silme-modal-sil:hover {
        background: #c82333;
        transform: translateY(-1px);
    }

    @@keyframes okulSilmeModalAc {
        from {
            opacity: 0;
            transform: translateY(10px) scale(0.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>

<div id="okulSilmeModal" class="okul-silme-modal-overlay">

    <div class="okul-silme-modal" role="dialog" aria-modal="true">

        <div class="okul-silme-modal-icon">
            🗑️
        </div>

        <h3>Okulu Silmek Üzeresiniz</h3>

        <p>
            Aşağıdaki okulu ve ona bağlı tüm kayıtları kalıcı olarak silmek
            istediğinizden emin misiniz?
        </p>

        <div id="okulSilmeAdi" class="okul-silme-modal-okul"></div>

        <div class="okul-silme-modal-uyari">
            ⚠️ Bu işlem geri alınamaz.
        </div>

        <form asp-action="DeleteSchool"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="okulSilmeId"
                   name="id" />

            <div class="okul-silme-modal-actions">

                <button type="button"
                        class="okul-silme-modal-btn okul-silme-modal-vazgec"
                        onclick="okulSilmeIptal();">
                    Vazgeç
                </button>

                <button type="submit"
                        class="okul-silme-modal-btn okul-silme-modal-sil">
                    Okulu Sil
                </button>

            </div>

        </form>

    </div>

</div>

<script>
    function okulSilmeOnayi(button) {
        const okulId = button.getAttribute("data-school-id");
        const okulAdi = button.getAttribute("data-school-name");

        document.getElementById("okulSilmeId").value = okulId;
        document.getElementById("okulSilmeAdi").textContent = "🏫 " + okulAdi;
        document.getElementById("okulSilmeModal").classList.add("aktif");
    }

    function okulSilmeIptal() {
        document.getElementById("okulSilmeId").value = "";
        document.getElementById("okulSilmeModal").classList.remove("aktif");
    }

    document.getElementById("okulSilmeModal").addEventListener("click", function (event) {
        if (event.target === this) {
            okulSilmeIptal();
        }
    });

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            okulSilmeIptal();
        }
    });
</script>
