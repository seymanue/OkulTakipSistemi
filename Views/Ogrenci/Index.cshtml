@model IEnumerable<OkulTakipSistemi.Models.Ogrenci>

@{
    ViewData["Title"] = "Öğrenci Yönetimi";

    var ogrenciler = Model?.ToList() ?? new List<OkulTakipSistemi.Models.Ogrenci>();
    var toplam = ogrenciler.Count;
}

<style>
    .student-page {
        padding: 32px;
        background: #f7f8fc;
        min-height: calc(100vh - 70px);
    }

    .student-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
    }

    .page-title-area h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 750;
        color: #171927;
        letter-spacing: -0.5px;
    }

    .page-title-area p {
        margin: 7px 0 0;
        color: #777b8c;
        font-size: 14px;
    }

    .new-student-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #4f35d8;
        color: white !important;
        text-decoration: none;
        padding: 13px 20px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 650;
        transition: all .2s ease;
        box-shadow: 0 5px 14px rgba(79,53,216,.20);
    }

    .new-student-btn:hover {
        background: #4128c5;
        transform: translateY(-1px);
        box-shadow: 0 7px 18px rgba(79,53,216,.25);
    }

    /* İSTATİSTİK */

    .stats-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 18px;
        margin-bottom: 22px;
    }

    .stat-card {
        background: white;
        border: 1px solid #ececf3;
        border-radius: 14px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 3px 12px rgba(20,20,50,.035);
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
        background: #eeebff;
    }

    .stat-label {
        color: #858898;
        font-size: 12px;
        margin-bottom: 4px;
    }

    .stat-value {
        color: #1b1c2b;
        font-size: 22px;
        font-weight: 750;
    }

    /* ANA KART */

    .students-card {
        background: white;
        border: 1px solid #ececf3;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(20,20,50,.045);
        overflow: hidden;
    }

    /* ARAMA */

    .table-toolbar {
        padding: 18px 22px;
        border-bottom: 1px solid #eeeeF4;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .search-box {
        position: relative;
        width: 390px;
        max-width: 100%;
    }

    .search-box span {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9296a7;
        font-size: 16px;
    }

    .search-box input {
        width: 100%;
        height: 43px;
        border: 1px solid #e1e2ea;
        border-radius: 9px;
        padding: 0 15px 0 40px;
        font-size: 13px;
        outline: none;
        transition: .2s;
        box-sizing: border-box;
        color: #252637;
        background: #fbfbfd;
    }

    .search-box input:focus {
        border-color: #6652df;
        background: white;
        box-shadow: 0 0 0 3px rgba(102,82,223,.08);
    }

    .student-count {
        color: #747789;
        font-size: 13px;
        white-space: nowrap;
    }

    .student-count strong {
        color: #292a3b;
    }

    /* TABLO */

    .table-wrapper {
        overflow-x: auto;
    }

    .students-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 750px;
    }

    .students-table thead th {
        background: #fafafe;
        color: #7c7f90;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        padding: 14px 20px;
        text-align: left;
        border-bottom: 1px solid #eeeeF4;
        white-space: nowrap;
    }

    .students-table tbody tr {
        transition: background .15s ease;
    }

    .students-table tbody tr:hover {
        background: #fafaff;
    }

    .students-table tbody td {
        padding: 17px 20px;
        border-bottom: 1px solid #f0f0f4;
        color: #3b3d4d;
        font-size: 13px;
        vertical-align: middle;
    }

    .students-table tbody tr:last-child td {
        border-bottom: none;
    }

    .student-number {
        color: #4f35d8;
        font-weight: 700;
        font-size: 13px;
    }

    .student-name {
        display: flex;
        align-items: center;
        gap: 11px;
        font-weight: 600;
        color: #242535;
    }

    .student-avatar {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #eeebff;
        color: #4f35d8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 750;
        font-size: 12px;
        flex-shrink: 0;
    }

    .school-name {
        color: #505264;
        font-weight: 500;
    }

    .class-badge {
        display: inline-flex;
        align-items: center;
        background: #f1f1f7;
        color: #4c4e60;
        border-radius: 7px;
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 600;
    }

    /* BUTONLAR */

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1px solid #e6e6ed;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none;
        font-size: 14px;
        transition: all .18s ease;
    }

    .edit-btn {
        background: #f4f2ff;
        color: #5540d0;
    }

    .edit-btn:hover {
        background: #e8e4ff;
        border-color: #d8d1ff;
    }

    .delete-btn {
        background: #fff4f4;
        color: #c14d4d;
    }

    .delete-btn:hover {
        background: #ffe8e8;
        border-color: #ffcfcf;
    }

    /* BOŞ DURUM */

    .empty-state {
        text-align: center;
        padding: 70px 20px;
        color: #858898;
    }

    .empty-icon {
        font-size: 42px;
        margin-bottom: 12px;
    }

    .empty-state h3 {
        color: #292a3b;
        margin: 0 0 6px;
        font-size: 17px;
    }

    .empty-state p {
        margin: 0;
        font-size: 13px;
    }

    /* RESPONSIVE */

    @@media (max-width: 900px) {

        .student-page {
            padding: 20px;
        }

        .page-header {
            align-items: flex-start;
            gap: 15px;
        }

        .table-toolbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .search-box {
            width: 100%;
        }
    }

    @@media (max-width: 600px) {

        .student-page {
            padding: 14px;
        }

        .page-header {
            flex-direction: column;
        }

        .new-student-btn {
            width: 100%;
            justify-content: center;
        }

        .page-title-area h1 {
            font-size: 25px;
        }
    }
</style>


<div class="student-page">

    <div class="student-container">

        <!-- HEADER -->

        <div class="page-header">

            <div class="page-title-area">

                <h1>Öğrenci Yönetimi</h1>

                <p>
                    Sistemde kayıtlı öğrencileri görüntüleyin ve yönetin.
                </p>

            </div>

            <a asp-action="Create"
               class="new-student-btn">

                <span>＋</span>

                Yeni Öğrenci

            </a>

        </div>


        <!-- İSTATİSTİK -->

        <div class="stats-grid">

            <div class="stat-card">

                <div class="stat-icon">
                    👥
                </div>

                <div>

                    <div class="stat-label">
                        Toplam Öğrenci
                    </div>

                    <div class="stat-value">
                        @toplam
                    </div>

                </div>

            </div>

        </div>


        <!-- TABLO -->

        <div class="students-card">

            <div class="table-toolbar">

                <div class="search-box">

                    <span>⌕</span>

                    <input type="text"
                           id="studentSearch"
                           placeholder="Öğrenci, okul veya sınıf ara..."
                           autocomplete="off" />

                </div>

                <div class="student-count">

                    Toplam
                    <strong id="visibleCount">
                        @toplam
                    </strong>
                    öğrenci

                </div>

            </div>


            <div class="table-wrapper">

                @if (ogrenciler.Any())
                {
                    <table class="students-table">

                        <thead>

                            <tr>

                                <th>Öğrenci No</th>

                                <th>Ad Soyad</th>

                                <th>Okul</th>

                                <th>Sınıf</th>

                                <th>İşlemler</th>

                            </tr>

                        </thead>


                        <tbody id="studentTableBody">

                            @foreach (var ogrenci in ogrenciler)
                            {
                                var initials = "";

                                if (!string.IsNullOrWhiteSpace(ogrenci.AdSoyad))
                                {
                                    var parts = ogrenci.AdSoyad
                                        .Split(
                                            ' ',
                                            StringSplitOptions.RemoveEmptyEntries
                                        );

                                    if (parts.Length >= 2)
                                    {
                                        initials =
                                            parts[0]
                                                .Substring(0, 1)
                                                .ToUpper() +

                                            parts[^1]
                                                .Substring(0, 1)
                                                .ToUpper();
                                    }
                                    else
                                    {
                                        initials =
                                            parts[0]
                                                .Substring(0, 1)
                                                .ToUpper();
                                    }
                                }


                                <tr class="student-row"
                                    data-search="@($"{ogrenci.OgrenciNo} {ogrenci.AdSoyad} {ogrenci.Sinif?.Ad} {ogrenci.Sinif?.Okul?.Ad}")">

                                    <!-- ÖĞRENCİ NO -->

                                    <td>

                                        <span class="student-number">
                                            @ogrenci.OgrenciNo
                                        </span>

                                    </td>


                                    <!-- AD SOYAD -->

                                    <td>

                                        <div class="student-name">

                                            <div class="student-avatar">
                                                @initials
                                            </div>

                                            <span>
                                                @ogrenci.AdSoyad
                                            </span>

                                        </div>

                                    </td>


                                    <!-- OKUL -->

                                    <td>

                                        <span class="school-name">

                                            @(ogrenci.Sinif?.Okul?.Ad
                                                ?? "Okul bilgisi yok")

                                        </span>

                                    </td>


                                    <!-- SINIF -->

                                    <td>

                                        @if (ogrenci.Sinif != null)
                                        {
                                            <span class="class-badge">

                                                @ogrenci.Sinif.Ad

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Sınıf yok
                                            </span>
                                        }

                                    </td>


                                    <!-- İŞLEMLER -->

                                    <td>

                                        <div class="action-buttons">

                                            <!-- DÜZENLE -->

                                            <a asp-action="Edit"
                                               asp-route-id="@ogrenci.Id"
                                               class="action-btn edit-btn"
                                               title="Düzenle">

                                                ✎

                                            </a>


                                            <!-- SİL -->

                                            <form asp-action="Delete"
                                                  method="post"
                                                  style="display:inline;"
                                                  onsubmit="return confirm('Bu öğrenciyi silmek istediğinize emin misiniz?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@ogrenci.Id" />

                                                <button type="submit"
                                                        class="action-btn delete-btn"
                                                        title="Sil">

                                                    ▫

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
                }
                else
                {
                    <div class="empty-state">

                        <div class="empty-icon">
                            👨‍🎓
                        </div>

                        <h3>
                            Henüz öğrenci bulunmuyor
                        </h3>

                        <p>
                            Yeni bir öğrenci kaydı oluşturarak başlayabilirsiniz.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("studentSearch");

        const rows =
            document.querySelectorAll(".student-row");

        const visibleCount =
            document.getElementById("visibleCount");


        if (searchInput) {

            searchInput.addEventListener(
                "input",
                function () {

                    const searchText =
                        this.value
                            .toLocaleLowerCase("tr-TR")
                            .trim();

                    let count = 0;


                    rows.forEach(function (row) {

                        const data =
                            (row.dataset.search || "")
                                .toLocaleLowerCase("tr-TR");


                        const matches =
                            data.includes(searchText);


                        row.style.display =
                            matches ? "" : "none";


                        if (matches) {
                            count++;
                        }

                    });


                    if (visibleCount) {

                        visibleCount.textContent =
                            count;

                    }

                }
            );

        }

    });

</script>