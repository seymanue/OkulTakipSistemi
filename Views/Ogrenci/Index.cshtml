@model IEnumerable<OkulTakipSistemi.Models.Ogrenci>

@{
    ViewData["Title"] = "Öğrenci Yönetimi";

    var ogrenciler = Model?.ToList() ?? new List<OkulTakipSistemi.Models.Ogrenci>();
    var okullar = ViewBag.Okullar as List<OkulTakipSistemi.Models.Okul>
        ?? new List<OkulTakipSistemi.Models.Okul>();
    var siniflar = ViewBag.Siniflar as List<OkulTakipSistemi.Models.Sinif>
        ?? new List<OkulTakipSistemi.Models.Sinif>();

    int? seciliOkulId = ViewBag.SeciliOkulId as int?;
    int? seciliSinifId = ViewBag.SeciliSinifId as int?;
}

<style>
    .student-management-page {
        min-height: calc(100vh - 70px);
        padding: 32px;
        background: linear-gradient(135deg, #eef6ff 0%, #f5f9ff 45%, #ffffff 100%);
    }

    .student-management-container {
        max-width: 1250px;
        margin: 0 auto;
    }

    .student-header {
        margin-bottom: 25px;
    }

    .student-header h1 {
        margin: 0;
        color: #102a56;
        font-size: 30px;
        font-weight: 750;
    }

    .student-header p {
        margin: 8px 0 0;
        color: #6d7d95;
        font-size: 14px;
    }

    .selection-card {
        background: white;
        border: 1px solid #dce8f7;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 8px 25px rgba(31, 76, 128, .08);
        margin-bottom: 22px;
    }

    .selection-title {
        color: #173b6d;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .selection-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #405574;
        font-size: 13px;
        font-weight: 650;
    }

    .form-group select {
        width: 100%;
        height: 46px;
        border: 1px solid #cfdaea;
        border-radius: 10px;
        padding: 0 13px;
        background: #fbfdff;
        color: #253b59;
        font-size: 14px;
        outline: none;
        cursor: pointer;
    }

    .form-group select:focus {
        border-color: #3978c9;
        box-shadow: 0 0 0 3px rgba(57, 120, 201, .10);
        background: white;
    }

    .students-card {
        background: white;
        border: 1px solid #dce8f7;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(31, 76, 128, .07);
    }

    .students-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e7eef7;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .students-card-title {
        color: #173b6d;
        font-size: 17px;
        font-weight: 700;
    }

    .student-count {
        color: #6d7d95;
        font-size: 13px;
    }

    .student-count strong {
        color: #245b99;
    }

    .students-table {
        width: 100%;
        border-collapse: collapse;
    }

    .students-table th {
        background: #f4f8fd;
        color: #657994;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        padding: 15px 24px;
        text-align: left;
        border-bottom: 1px solid #e5edf7;
    }

    .students-table td {
        padding: 17px 24px;
        border-bottom: 1px solid #edf2f8;
        color: #273d5a;
        font-size: 14px;
    }

    .students-table tbody tr {
        transition: background .15s ease;
    }

    .students-table tbody tr:hover {
        background: #f8fbff;
    }

    .students-table tbody tr:last-child td {
        border-bottom: none;
    }

    .student-number {
        color: #2866a8;
        font-weight: 700;
    }

    .student-name {
        font-weight: 600;
        color: #1d3553;
    }

    .empty-state {
        padding: 65px 20px;
        text-align: center;
        color: #7b8ba1;
    }

    .empty-icon {
        font-size: 42px;
        margin-bottom: 12px;
    }

    .empty-state h3 {
        margin: 0 0 7px;
        color: #29415f;
        font-size: 17px;
    }

    .empty-state p {
        margin: 0;
        font-size: 13px;
    }

    .select-warning {
        margin-top: 18px;
        padding: 13px 15px;
        border-radius: 10px;
        background: #f4f8fd;
        color: #667991;
        font-size: 13px;
    }

    @@media (max-width: 700px) {
        .student-management-page {
            padding: 18px;
        }

        .selection-grid {
            grid-template-columns: 1fr;
        }

        .students-card {
            overflow-x: auto;
        }

        .students-table {
            min-width: 500px;
        }

        .student-header h1 {
            font-size: 25px;
        }
    }

    .page-title-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
        padding: 26px 30px;
        border: 1px solid #d9eaf8;
        border-radius: 20px;
        background: linear-gradient(135deg, #eaf5ff 0%, #d8ecff 55%, #c7e3fb 100%);
        box-shadow: 0 8px 25px rgba(26, 64, 99, 0.07);
    }

    .page-title-content {
        display: flex;
        align-items: center;
        gap: 17px;
        min-width: 0;
    }

    .page-title-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 54px;
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 5px 15px rgba(25, 87, 145, 0.10);
        font-size: 26px;
    }

    .page-title-box h1,
    .page-title-box h2 {
        margin: 0 0 5px;
        color: #163b61;
        font-size: 27px;
        font-weight: 800;
    }

    .page-title-box p {
        margin: 0;
        color: #607b95;
        font-size: 14px;
    }

    .page-title-action {
        flex-shrink: 0;
    }

    @@media (max-width: 700px) {
        .page-title-box {
            align-items: flex-start;
            flex-direction: column;
            padding: 22px;
        }

        .page-title-action {
            width: 100%;
        }
    }

</style>

<div class="student-management-page">

    <div class="student-management-container">

        <div class="page-title-box">

            <div class="page-title-content">
                <div class="page-title-icon">
                    👨‍🎓
                </div>

                <div>
                    <h1>Öğrenci Yönetimi</h1>
                    <p>Okul ve sınıf seçerek öğrencileri görüntüleyin.</p>
                </div>
            </div>

        </div>

        <div class="selection-card">

            <div class="selection-title">
                Öğrenci Listesi
            </div>

            <form method="get" asp-action="Index">

                <div class="selection-grid">

                    <div class="form-group">
                        <label for="okulId">Okul</label>

                        <select id="okulId"
                                name="okulId"
                                onchange="okulDegisti(this.value)">

                            <option value="">Okul seçiniz</option>

                            @foreach (var okul in okullar)
                            {
                                if (seciliOkulId == okul.Id)
                                {
                                    <option value="@okul.Id" selected>
                                        @okul.Ad — @okul.Adres
                                    </option>
                                }
                                else
                                {
                                    <option value="@okul.Id">
                                        @okul.Ad — @okul.Adres
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <div class="form-group">
                        <label for="sinifId">Sınıf</label>

                        <select id="sinifId"
                                name="sinifId"
                                onchange="sinifDegisti(this.value)"
                                @(seciliOkulId.HasValue ? "" : "disabled")>

                            <option value="">Sınıf seçiniz</option>

                            @foreach (var sinif in siniflar)
                            {
                                if (seciliSinifId == sinif.Id)
                                {
                                    <option value="@sinif.Id" selected>
                                        @sinif.Ad
                                    </option>
                                }
                                else
                                {
                                    <option value="@sinif.Id">
                                        @sinif.Ad
                                    </option>
                                }
                            }

                        </select>
                    </div>

                </div>

            </form>

            @if (!seciliOkulId.HasValue)
            {
                <div class="select-warning">
                    Önce bir okul seçiniz.
                </div>
            }
            else if (!seciliSinifId.HasValue)
            {
                <div class="select-warning">
                    Öğrencileri görmek için bir sınıf seçiniz.
                </div>
            }

        </div>

        @if (seciliSinifId.HasValue)
        {
            <div class="students-card">

                <div class="students-card-header">

                    <div class="students-card-title">
                        Öğrenciler
                    </div>

                    <div class="student-count">
                        <strong>@ogrenciler.Count</strong> öğrenci
                    </div>

                </div>

                @if (ogrenciler.Any())
                {
                    <table class="students-table">

                        <thead>
                            <tr>
                                <th>Öğrenci No</th>
                                <th>Öğrenci Adı Soyadı</th>
                                <th>Veli Adı</th>
                                <th>Veli Telefonu</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var ogrenci in ogrenciler)
                            {
                                <tr>
                                    <td>
                                        <span class="student-number">
                                            @ogrenci.OgrenciNo
                                        </span>
                                    </td>

                                    <td>
                                        <span class="student-name">
                                            @ogrenci.AdSoyad
                                        </span>
                                    </td>

                                    @{
                                        var veli = ((IEnumerable<OkulTakipSistemi.Models.OgrenciVeli>)ViewBag.Veliler)
                                            .FirstOrDefault(x => x.OgrenciId == ogrenci.Id)?.Veli;
                                    }

                                    <td>
                                        @(veli?.AdSoyad ?? "-")
                                    </td>

                                    <td>
                                        @(veli?.Telefon ?? "-")
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">👨‍🎓</div>

                        <h3>Bu sınıfta öğrenci bulunmuyor</h3>

                        <p>Seçtiğiniz sınıfa kayıtlı öğrenci bulunamadı.</p>
                    </div>
                }

            </div>
        }

    </div>

</div>

<script>

    function okulDegisti(okulId) {

        if (!okulId) {
            window.location.href = '@Url.Action("Index", "Ogrenci")';
            return;
        }

        window.location.href =
            '@Url.Action("Index", "Ogrenci")' +
            '?okulId=' + encodeURIComponent(okulId);
    }

    function sinifDegisti(sinifId) {

        const okulId =
            document.getElementById("okulId").value;

        if (!sinifId) {
            window.location.href =
                '@Url.Action("Index", "Ogrenci")' +
                '?okulId=' + encodeURIComponent(okulId);

            return;
        }

        window.location.href =
            '@Url.Action("Index", "Ogrenci")' +
            '?okulId=' + encodeURIComponent(okulId) +
            '&sinifId=' + encodeURIComponent(sinifId);
    }

</script>
