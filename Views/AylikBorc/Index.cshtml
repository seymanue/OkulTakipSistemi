@model IEnumerable<OkulTakipSistemi.Models.AylikBorc>

@{
    ViewData["Title"] = "Ödeme Planları";

    string AyAdi(int ay)
    {
        return ay switch
        {
            1 => "Ocak",
            2 => "Şubat",
            3 => "Mart",
            4 => "Nisan",
            5 => "Mayıs",
            6 => "Haziran",
            7 => "Temmuz",
            8 => "Ağustos",
            9 => "Eylül",
            10 => "Ekim",
            11 => "Kasım",
            12 => "Aralık",
            _ => ""
        };
    }
}

<div class="container-fluid py-4">

    <div class="mb-4">

        <h2 class="fw-bold">
            Öğrenci Ödeme Planları
        </h2>

        <p class="text-muted">
            Öğrencilerin aylık okul ücretlerini ve ödeme durumlarını
            buradan takip edebilirsiniz.
        </p>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Henüz oluşturulmuş bir ödeme planı bulunmuyor.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>Öğrenci</th>

                                <th>Okul</th>

                                <th>Ay</th>

                                <th>Yıl</th>

                                <th>Borç</th>

                                <th>Ödenen</th>

                                <th>Kalan</th>

                                <th>Durum</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var borc in Model)
                            {
                                <tr>

                                    <td>

                                        <div class="fw-semibold">

                                            @borc.OgrenciKaydi?.Ogrenci?.AdSoyad

                                        </div>

                                        <small class="text-muted">

                                            No:
                                            @borc.OgrenciKaydi?.Ogrenci?.OgrenciNo

                                        </small>

                                    </td>

                                    <td>
                                        @borc.OgrenciKaydi?.Okul?.Ad
                                    </td>

                                    <td>
                                        @AyAdi(borc.Ay)
                                    </td>

                                    <td>
                                        @borc.Yil
                                    </td>

                                    <td>
                                        <strong>
                                            @borc.Tutar.ToString("N2") ₺
                                        </strong>
                                    </td>

                                    <td>
                                        @borc.OdenenTutar.ToString("N2") ₺
                                    </td>

                                    <td>

                                        @if (borc.KalanTutar <= 0)
                                        {
                                            <span>
                                                0,00 ₺
                                            </span>
                                        }
                                        else
                                        {
                                            <strong>
                                                @borc.KalanTutar.ToString("N2") ₺
                                            </strong>
                                        }

                                    </td>

                                    <td>

                                        @if (borc.Odendi)
                                        {
                                            <span class="badge bg-success">
                                                Ödendi
                                            </span>
                                        }
                                        else if (borc.OdenenTutar > 0)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Kısmi Ödeme
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Ödenmedi
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>