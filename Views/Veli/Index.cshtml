@model IEnumerable<OkulTakipSistemi.Models.Veli>

@{
    ViewData["Title"] = "Veliler";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Veliler</h2>
            <p class="text-muted">
                Velileri ve bağlı oldukları öğrencileri yönetin.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Veli Ekle
        </a>
    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-hover">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ad Soyad</th>
                    <th>Telefon</th>
                    <th>Yakınlık</th>
                    <th>Öğrenci</th>
                    <th>İşlemler</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var veli in Model)
                {
                    <tr>

                        <td>@veli.Id</td>

                        <td>@veli.AdSoyad</td>

                        <td>@veli.Telefon</td>

                        <td>@veli.Yakinlik</td>

                        <td>
                            @if (veli.OgrenciVeliler != null &&
                                 veli.OgrenciVeliler.Any())
                            {
                                foreach (var baglanti in veli.OgrenciVeliler)
                                {
                                    if (baglanti.Ogrenci != null)
                                    {
                                        <strong>
                                            @baglanti.Ogrenci.AdSoyad
                                        </strong>

                                        <br />

                                        <small class="text-muted">
                                            (@baglanti.Ogrenci.OgrenciNo)
                                        </small>
                                    }
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    Öğrenci atanmadı
                                </span>
                            }
                        </td>

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@veli.Id"
                               class="btn btn-warning btn-sm">
                                ✏️ Düzenle
                            </a>

                            <form asp-action="Delete"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Bu veliyi silmek istediğinize emin misiniz?');">

                                <input type="hidden"
                                       name="id"
                                       value="@veli.Id" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    🗑️ Sil
                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
