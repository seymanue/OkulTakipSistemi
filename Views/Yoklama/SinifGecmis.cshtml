    background: linear-gradient(
        135deg,
        #8f4f32 0%,
        #a95f3b 50%,
        #b96c43 100%
    ) !important;

    background-color: #a95f3b !important;
    background-image: linear-gradient(
        135deg,
        #8f4f32 0%,
        #a95f3b 50%,
        #b96c43 100%
    ) !important;

    border: none !important;
    border-radius: 17px !important;
    box-shadow: 0 8px 22px rgba(91,48,31,.14) !important;
}

.attendance-history-page .page-header h1,
.attendance-history-page .history-header h1 {
    margin: 0 !important;
    color: #fff8f1 !important;
