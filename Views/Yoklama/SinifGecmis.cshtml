    color: #fff8f1 !important;
    border: 1px solid rgba(255,245,235,.4) !important;
    box-shadow: none !important;
}

/* KARTLAR */
.attendance-history-page .class-grid,
.attendance-history-page .history-grid {
    width: 100% !important;
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 18px !important;
}

.attendance-history-page .class-card,
.attendance-history-page .history-card {
    min-height: 190px !important;
    padding: 22px !important;
    background: rgba(255,255,255,.82) !important;
    border: 1px solid rgba(155,89,59,.16) !important;
    border-radius: 16px !important;
    box-shadow: 0 7px 20px rgba(91,48,31,.09) !important;
}

.attendance-history-page .class-icon,
.attendance-history-page .history-icon {
    background: #ead4c5 !important;
    color: #9b593b !important;
}

.attendance-history-page .class-card a,
.attendance-history-page .history-card a {
    background: #a95f3b !important;
    background-image: none !important;
    color: #fff8f1 !important;
    border-color: #a95f3b !important;
}

@@media (max-width: 900px) {
    .attendance-history-page {
        padding: 20px !important;
    }

    .attendance-history-page .class-grid,
    .attendance-history-page .history-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
}

@@media (max-width: 600px) {
    .attendance-history-page {
        padding: 16px !important;
    }

    .attendance-history-page .class-grid,
    .attendance-history-page .history-grid {
        grid-template-columns: 1fr !important;
    }
}
</style>

