@model List<OkulTakipSistemi.Models.YoklamaGecmisViewModel>

@{
    ViewData["Title"] = "Yoklama Geçmişi";
    var sinif = ViewBag.Sinif as OkulTakipSistemi.Models.Sinif;
}

<style>
    * {
        box-sizing: border-box;
    }

    .yoklama-history-page {
        min-height: calc(100vh - 100px);
        padding: 42px 0 65px;
        background:
            radial-gradient(circle at 8% 10%, rgba(224, 151, 100, .18), transparent 30%),
            radial-gradient(circle at 92% 80%, rgba(210, 169, 91, .16), transparent 32%),
            linear-gradient(135deg, #f8f1e9 0%, #f5e9df 48%, #efe0d2 100%);
    }

    .history-container {
        width: min(1100px, calc(100% - 40px));
        margin: 0 auto;
    }

    /* ÜST BAŞLIK */

    .history-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;

        padding: 27px 30px;
        margin-bottom: 25px;

        background: rgba(255, 251, 247, .92);
        border: 1px solid #e5d4c7;
        border-radius: 20px;

        box-shadow: 0 10px 30px rgba(91, 55, 39, .08);
    }

    .history-header h1 {
        margin: 0;
        color: #50372d;
        font-size: 28px;
        font-weight: 750;
    }

    .history-header p {
        margin: 7px 0 0;
        color: #8a7165;
        font-size: 14px;
    }

    .history-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-height: 44px;
        padding: 10px 17px;

        background: #8e5137;
        color: #fffaf6 !important;

        border: 1px solid #8e5137;
        border-radius: 11px;

        text-decoration: none;
        font-size: 13px;
        font-weight: 650;
        white-space: nowrap;

        transition: .2s ease;
    }

    .history-back:hover {
        background: #75412d;
        border-color: #75412d;
        color: #fff !important;
        transform: translateY(-1px);
    }

    /* MESAJLAR */

    .history-message {
        padding: 15px 18px;
        margin-bottom: 18px;

        border-radius: 13px;
        font-size: 13px;
        font-weight: 600;
    }

    .history-success {
        background: #f2e4d8;
        border: 1px solid #dfc2ae;
        color: #75432f;
    }

    .history-warning {
        background: #f8edcf;
        border: 1px solid #e5d19a;
        color: #765a20;
    }

    /* YOKLAMA KARTI */

    .attendance-card {
        margin-bottom: 20px;
        overflow: hidden;

        background: rgba(255, 253, 250, .96);
        border: 1px solid #e4d6cb;
        border-radius: 18px;

        box-shadow: 0 8px 25px rgba(91, 55, 39, .07);
    }

    .attendance-header {
        min-height: 76px;
        padding: 18px 22px;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;

        background: #fffaf6;
        border-bottom: 1px solid #eadfd7;
    }

    .attendance-title {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        color: #5a3c30;
        font-size: 17px;
        font-weight: 750;
    }

    .attendance-title svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: #a45d3c;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .attendance-date {
        display: block;
        margin-top: 5px;
        color: #927b70;
        font-size: 12px;
    }

    /* YOKLAMA AÇIKLAMASI */

    .attendance-note-history {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 9px;
        padding: 8px 11px;
        background: #fbf1e5;
        border: 1px solid #ead5c1;
        border-radius: 9px;
        max-width: 720px;
    }

    .attendance-note-label {
        color: #8e5137;
        font-size: 11px;
        font-weight: 750;
    }

    .attendance-note-text {
        color: #72594c;
        font-size: 12px;
        line-height: 1.45;
    }

    /* DÜZENLE */

    .edit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;

        min-height: 40px;
        padding: 9px 15px;

        background: #b8784f;
        color: #fffaf6 !important;

        border: 1px solid #b8784f;
        border-radius: 10px;

        text-decoration: none;
        font-size: 12px;
        font-weight: 650;

        transition: .2s ease;
        white-space: nowrap;
    }

    .edit-btn:hover {
        background: #956044;
        border-color: #956044;
        color: #fff !important;
        transform: translateY(-1px);
    }

    /* TABLO */

    .attendance-body {
        width: 100%;
        overflow-x: auto;
    }

    .attendance-table {
        width: 100%;
        min-width: 650px;
        border-collapse: collapse;
    }

    .attendance-table th {
        padding: 14px 18px;

        background: #f7eee7;
        border-bottom: 1px solid #e3d4c9;

        color: #735546;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .7px;
        text-transform: uppercase;
        text-align: left;
    }

    .attendance-table td {
        padding: 14px 18px;

        background: #fffdfb;
        border-bottom: 1px solid #eee4dc;

        color: #735f55;
        font-size: 13px;
    }

    .attendance-table tr:last-child td {
        border-bottom: none;
    }

    .attendance-table tbody tr:hover td {
        background: #fcf5ef;
    }

    .student-name {
        color: #50372d !important;
        font-weight: 650;
    }

    /* DURUM */

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-width: 82px;
        padding: 6px 11px;

        border-radius: 20px;

        font-size: 11px;
        font-weight: 750;
    }

    .status-present {
        background: #f1dfd3;
        color: #855035;
        border: 1px solid #e0c4b3;
    }

    .status-absent {
        background: #f4e7c9;
        color: #80621f;
        border: 1px solid #e4d19c;
    }

    /* ÖĞRENCİ YOK */

    .no-student {
        padding: 25px;
        text-align: center;

        background: #f8edcf;
        color: #765a20;

        font-size: 13px;
    }

    /* BOŞ DURUM */

    .history-empty {
        padding: 55px 25px;
        text-align: center;

        background: rgba(255, 253, 250, .96);
        border: 1px solid #e4d6cb;
        border-radius: 18px;

        box-shadow: 0 8px 25px rgba(91, 55, 39, .07);
    }

    .history-empty-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 17px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #f3dfd1;
        border: 1px solid #e2c2ae;
        border-radius: 17px;

        color: #995534;
    }

    .history-empty-icon svg {
        width: 31px;
        height: 31px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .history-empty strong {
        display: block;
        margin-bottom: 6px;
        color: #51372c;
        font-size: 16px;
    }

    .history-empty span {
        color: #927b70;
        font-size: 13px;
    }

    @@media (max-width: 768px) {

        .yoklama-history-page {
            padding: 25px 0 45px;
        }

        .history-container {
            width: min(100% - 30px, 650px);
        }

        .history-header {
            flex-direction: column;
            align-items: flex-start;
            padding: 23px;
        }

        .history-back {
            width: 100%;
        }

        .attendance-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .edit-btn {
            width: 100%;
        }
    }
</style>

<div class="yoklama-history-page">

    <div class="history-container">
<div class="history-header">
<div>

                <h1>
                    @(sinif?.Ad ?? "Sınıf") Yoklama Geçmişi
                </h1>

                @if (sinif?.Okul != null)
                {
                    <p>
                        Okul: @sinif.Okul.Ad
                    </p>
                }
                else
                {
                    <p>
                        Sınıfa ait geçmiş yoklamalar
                    </p>
                }

            </div>

            <a asp-controller="Yoklama"
               asp-action="Gecmis"
               class="history-back">
                ← Sınıflara Dön
            </a>

        </div>

        @if (TempData["Basari"] != null)
        {
            <div class="history-message history-success">
                ✓ @TempData["Basari"]
            </div>
        }

        @if (TempData["Hata"] != null)
        {
            <div class="history-message history-warning">
                ⚠ @TempData["Hata"]
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="history-empty">

                <div class="history-empty-icon">

                    <svg viewBox="0 0 24 24">
                        <rect x="5" y="3" width="14" height="18" rx="2" />
                        <path d="M8 7h8" />
                        <path d="M8 11h8" />
                        <path d="M8 15h5" />
                    </svg>

                </div>

                <strong>
                    Henüz yoklama bulunmamaktadır.
                </strong>

                <span>
                    Bu sınıfa ait alınmış bir yoklama henüz bulunmuyor.
                </span>

            </div>
        }
        else
        {
            @foreach (var yoklama in Model)
            {
                <div class="attendance-card">

                    <div class="attendance-header">

                        <div>

                            <span class="attendance-title">

                                <svg viewBox="0 0 24 24">
                                    <rect x="5" y="3" width="14" height="18" rx="2" />
                                    <path d="M8 7h8" />
                                    <path d="M8 11h8" />
                                    <path d="M8 15h5" />
                                </svg>

                                Yoklama

                            </span>

                            <span class="attendance-date">
                                @yoklama.Tarih.ToString("dd.MM.yyyy HH:mm")
                            </span>

                            @if (!string.IsNullOrWhiteSpace(yoklama.Aciklama))
                            {
                                <div class="attendance-note-history">
                                    <span class="attendance-note-label">Açıklama</span>
                                    <span class="attendance-note-text">@yoklama.Aciklama</span>
                                </div>
                            }

                        </div>

                        <a asp-controller="Yoklama"
                           asp-action="Duzenle"
                           asp-route-id="@yoklama.YoklamaId"
                           class="edit-btn">
                            Düzenle
                        </a>

                    </div>

                    <div class="attendance-body">

                        @if (yoklama.Ogrenciler == null ||
                             !yoklama.Ogrenciler.Any())
                        {
                            <div class="no-student">
                                Bu yoklamada öğrenci kaydı bulunmamaktadır.
                            </div>
                        }
                        else
                        {
                            <table class="attendance-table">

                                <thead>
                                    <tr>
                                        <th style="width:150px;">
                                            Öğrenci No
                                        </th>

                                        <th>
                                            Ad Soyad
                                        </th>

                                        <th style="width:180px;">
                                            Durum
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var ogrenci in yoklama.Ogrenciler)
                                    {
                                        <tr>

                                            <td>
                                                @ogrenci.OgrenciNo
                                            </td>

                                            <td class="student-name">
                                                @ogrenci.AdSoyad
                                            </td>

                                            <td>

                                                @if (ogrenci.Geldi)
                                                {
                                                    <span class="status-badge status-present">
                                                        ✓ Geldi
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge status-absent">
                                                        ✕ Gelmedi
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>
                        }

                    </div>

                </div>
            }
        }

    </div>

</div>

<style>
/* =====================================================
   SINIF YOKLAMA GEÇMİŞİ
   ===================================================== */

html,
body {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    min-width: 0 !important;
