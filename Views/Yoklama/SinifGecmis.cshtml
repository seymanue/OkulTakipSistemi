    font-size: 28px !important;
    font-weight: 700 !important;
}

.attendance-history-page .page-header p,
.attendance-history-page .history-header p {
    color: #f3d8c5 !important;
}

/* GERİ BUTONU */
.attendance-history-page .back-btn {
    background: #a95f3b !important;
