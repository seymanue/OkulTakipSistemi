@model List<OkulTakipSistemi.Models.Ogrenci>

@{
    ViewData["Title"] = "Yoklama Al";
    var secilenSinif = ViewBag.Sinif as OkulTakipSistemi.Models.Sinif;
}

<div class="attendance-page">

    <!-- BAŞLIK -->
    <div class="attendance-header">

        <div>
            <div class="page-kicker">
                ÖĞRETMEN PANELİ
            </div>

            <h1>Yoklama Al</h1>

            <p>
                <strong>@secilenSinif?.Ad</strong>
                sınıfı için bugünkü yoklamayı alın.
            </p>
        </div>

        <a asp-controller="Ogretmen"
           asp-action="Yoklama"
           class="back-button">
            ← Geri Dön
        </a>

    </div>

    @if (TempData["Basari"] != null)
    {
        <div style="margin: 20px 0; padding: 14px 18px; border-radius: 10px; background: #e8f5e9; color: #2e7d32;">
            ✓ @TempData["Basari"]
        </div>
    }

    @if (TempData["YoklamaUyari"] != null)
    {
        <div style="margin: 20px 0; padding: 14px 18px; border-radius: 10px; background: #fff3cd; color: #856404;">
            ⚠️ @TempData["YoklamaUyari"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <!-- BOŞ SINIF -->
        <div class="attendance-card">

            <div class="empty-students">

                <h3>Öğrenci Bulunamadı</h3>

                <p>
                    Bu sınıfta kayıtlı öğrenci bulunmamaktadır.
                </p>

            </div>

        </div>
    }
    else
    {
        <form asp-controller="Yoklama"
              asp-action="Kaydet"
              method="post">

            <input type="hidden"
                   name="sinifId"
                   value="@secilenSinif?.Id" />


            <!-- ANA KART -->
            <div class="attendance-card">

                <!-- KART BAŞLIĞI -->
                <div class="attendance-card-header">

                    <div>
                        <h2>Öğrenci Listesi</h2>

                        <p>
                            Katılım durumunu öğrenciler için seçiniz.
                        </p>
                    </div>

                    <div class="student-count">
                        @Model.Count Öğrenci
                    </div>

                </div>


                <!-- ÖĞRENCİLER -->
                <div class="student-list">

                    @foreach (var ogrenci in Model)
                    {
                        <div class="student-row">

                            <!-- ÖĞRENCİ BİLGİSİ -->
                            <div class="student-info">

                                <div class="student-icon">

                                    <svg viewBox="0 0 24 24">
                                        <circle cx="12"
                                                cy="8"
                                                r="3" />

                                        <path d="M5 21c0-3.5 3-6 7-6s7 2.5 7 6" />
                                    </svg>

                                </div>

                                <div>

                                    <strong>
                                        @ogrenci.AdSoyad
                                    </strong>

                                    <span>
                                        Öğrenci No: @ogrenci.OgrenciNo
                                    </span>

                                </div>

                            </div>


                            <!-- YOKLAMA -->
                            <div class="attendance-actions">

                                <input type="hidden"
                                       name="durumlar[@ogrenci.Id]"
                                       value="true"
                                       class="attendance-value" />

                                <button type="button"
                                        class="attendance-button present active"
                                        onclick="this.parentElement.querySelector('.attendance-value').value='true'; this.classList.add('active'); this.nextElementSibling.classList.remove('active');">
                                    ✓
                                </button>

                                <button type="button"
                                        class="attendance-button absent"
                                        onclick="this.parentElement.querySelector('.attendance-value').value='false'; this.classList.add('active'); this.previousElementSibling.classList.remove('active');">
                                    ✕
                                </button>

                            </div>

                        </div>
                    }

                </div>


                <!-- ALT BÖLÜM -->
                <div class="attendance-footer">



                    <button type="submit"
                            class="save-attendance">

                        Yoklamayı Kaydet

                    </button>

                </div>

            </div>

        </form>
    }

</div>
