@model IEnumerable<OkulTakipSistemi.Models.Ogrenci>

@{
    ViewData["Title"] = "Yoklama Düzenle";

    var sinif = ViewBag.Sinif as OkulTakipSistemi.Models.Sinif;
    var yoklama = ViewBag.Yoklama as OkulTakipSistemi.Models.Yoklama;
    var detaylar = ViewBag.Detaylar as Dictionary<int, bool>;
}

<style>
    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
        font-family: Arial, Helvetica, sans-serif;
        color: #4f382d;
        background: #f7f0e9;
    }

    body {
        min-height: 100vh;
    }

    .edit-attendance-page {
        min-height: 100vh;
        padding: 42px 25px 60px;
        background:
            radial-gradient(circle at 8% 8%, rgba(244, 181, 116, .24), transparent 30%),
            radial-gradient(circle at 92% 18%, rgba(207, 117, 65, .16), transparent 32%),
            radial-gradient(circle at 55% 100%, rgba(238, 202, 137, .18), transparent 38%),
            #f7f0e9;
    }

    .edit-container {
        width: min(1100px, 100%);
        margin: 0 auto;
    }

    .edit-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 28px 30px;
        margin-bottom: 24px;
        background: rgba(255, 252, 249, .96);
        border: 1px solid #ead8c9;
        border-radius: 20px;
        box-shadow: 0 12px 32px rgba(111, 72, 50, .08);
    }

    .edit-header h1 {
        margin: 0 0 7px;
        color: #4f3328;
        font-size: 30px;
        font-weight: 800;
    }

    .edit-header p {
        margin: 0;
        color: #81695d;
        font-size: 14px;
    }

    .edit-header p strong {
        color: #b65d2d;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 19px;
        border-radius: 11px;
        background: #8f5237;
        border: 1px solid #8f5237;
        color: #fffaf6 !important;
        text-decoration: none !important;
        font-weight: 700;
        white-space: nowrap;
    }

    .back-button:hover {
        background: rgba(255,248,241,.22);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(126,72,42,.22);
    }

    .description-card {
        display: flex;
        align-items: flex-start;
        gap: 22px;
        padding: 28px 30px;
        margin-bottom: 24px;
        background: rgba(255, 252, 249, .96);
        border: 1px solid #ead8c9;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(111, 72, 50, .07);
    }

    .description-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ffe6cc, #ffd3aa);
        border: 1px solid #f2c49b;
        border-radius: 15px;
        color: #c45f25;
    }

    .description-icon svg {
        width: 29px;
        height: 29px;
        fill: none;
        stroke: #c45f25;
        stroke-width: 1.8;
    }

    .description-content {
        flex: 1;
        min-width: 0;
    }

    .description-content label {
        display: block;
        margin-bottom: 7px;
        color: #4f3328;
        font-size: 19px;
        font-weight: 750;
    }

    .description-content p {
        margin: 0 0 16px;
        color: #81695d;
        font-size: 14px;
        line-height: 1.55;
    }

    .description-content input {
        width: 100%;
        min-height: 58px;
        padding: 15px 17px;
        background: #fffdfa;
        border: 1px solid #dfcdbd;
        border-radius: 11px;
        color: #4f3328;
        font-size: 15px;
        outline: none;
    }

    .description-content input:focus {
        border-color: #d27a42;
        box-shadow: 0 0 0 4px rgba(210, 122, 66, .12);
    }

    .description-content input::placeholder {
        color: #a39187;
    }

    .students-card {
        overflow: hidden;
        background: rgba(255, 252, 249, .97);
        border: 1px solid #ead8c9;
        border-radius: 20px;
        box-shadow: 0 12px 32px rgba(111, 72, 50, .08);
    }

    .students-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 27px 30px;
        background: linear-gradient(135deg, #fff4e9, #fffaf4);
        border-bottom: 1px solid #eee0d4;
    }

    .students-header h2 {
        margin: 0 0 6px;
        color: #4f3328;
        font-size: 23px;
    }

    .students-header p {
        margin: 0;
        color: #81695d;
        font-size: 13px;
    }

    .student-count {
        padding: 10px 15px;
        border-radius: 999px;
        background: #fff0cf;
        color: #a96818;
        font-size: 13px;
        font-weight: 750;
        white-space: nowrap;
    }

    .student-list {
        padding: 0 30px;
    }

    .student-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 22px 0;
        border-bottom: 1px solid #eee2d8;
    }

    .student-row:last-child {
        border-bottom: 0;
    }

    .student-name {
        margin-bottom: 5px;
        color: #4f3328;
        font-size: 16px;
        font-weight: 750;
    }

    .student-no {
        color: #92796b;
        font-size: 13px;
    }

    .attendance-actions {
        display: flex;
        gap: 10px;
    }

    .status-option {
        position: relative;
        cursor: pointer;
    }

    .status-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .status-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 92px;
        min-height: 46px;
        padding: 0 15px;
        border-radius: 11px;
        border: 1px solid #dfcdbd;
        background: #fffdfa;
        color: #80685b;
        font-weight: 700;
        transition: .2s ease;
    }

    .status-option input:checked + .status-button.present {
        background: #f28c28 !important;
        border-color: #e47716 !important;
        color: #ffffff !important;
        box-shadow: 0 6px 16px rgba(226, 119, 22, .25) !important;
        transform: translateY(-1px) !important;
    }

    .status-option input:checked + .status-button.absent {
        background: #f28c28 !important;
        border-color: #e47716 !important;
        color: #ffffff !important;
        box-shadow: 0 6px 16px rgba(226, 119, 22, .25) !important;
        transform: translateY(-1px) !important;
    }

    .edit-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 30px;
        background: #fbf1e8;
        border-top: 1px solid #eee0d4;
    }

    .edit-info {
        color: #80685b;
        font-size: 13px;
    }

    .save-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 48px;
        padding: 0 23px;
        border: 0;
        border-radius: 11px;
        background: linear-gradient(135deg, #e8894f, #c96832);
        color: #fff !important;
        font-weight: 750;
        cursor: pointer;
        box-shadow: 0 7px 18px rgba(196, 95, 37, .20);
    }

    .save-button svg {
        width: 19px;
        height: 19px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
    }

    .empty-state {
        padding: 50px 25px;
        text-align: center;
        color: #80685b;
    }

    @@media (max-width: 700px) {
        .edit-attendance-page {
            padding: 25px 15px 40px;
        }

        .edit-header,
        .description-card,
        .students-header,
        .edit-footer {
            padding: 20px;
        }

        .edit-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .description-card {
            gap: 15px;
        }

        .description-icon {
            width: 48px;
            height: 48px;
            flex-basis: 48px;
        }

        .student-list {
            padding: 0 20px;
        }

        .student-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .attendance-actions {
            width: 100%;
        }

        .status-option,
        .status-button {
            flex: 1;
            width: 100%;
        }

        .edit-footer {
            align-items: stretch;
            flex-direction: column;
        }
    }
</style>

<div class="edit-attendance-page">
    <div class="edit-container">

        <div class="edit-header">
            <div>
                <h1>Yoklama Düzenle</h1>
                <p><strong>@sinif?.Ad</strong> sınıfının kayıtlı yoklamasını düzenleyebilirsiniz.</p>
            </div>

            <a asp-controller="Yoklama"
               asp-action="SinifGecmis"
               asp-route-id="@sinif?.Id"
               class="back-button">
                ← Yoklama Geçmişine Dön
            </a>
        </div>

        <form asp-controller="Yoklama"
              asp-action="DuzenleKaydet"
              method="post">

            <input type="hidden" name="yoklamaId" value="@yoklama?.Id" />

            <div class="description-card">
                <div class="description-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                    </svg>
                </div>

                <div class="description-content">
                    <label for="aciklama">Yoklama Açıklaması</label>

                    <p>
                        Bu yoklamanın hangi ders veya tarih için alındığını
                        belirtebilirsiniz.
                    </p>

                    <input type="text"
                           id="aciklama"
                           name="aciklama"
                           maxlength="500"
                           value="@yoklama?.Aciklama"
                           placeholder="Örn: 15 Eylül Salı gününün yoklamasıdır." />
                </div>
            </div>

            <div class="students-card">

                <div class="students-header">
                    <div>
                        <h2>Öğrenciler</h2>
                        <p>Her öğrencinin yoklama durumunu değiştirebilirsiniz.</p>
                    </div>

                    <div class="student-count">
                        @(Model?.Count() ?? 0) Öğrenci
                    </div>
                </div>

                <div class="student-list">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var ogrenci in Model)
                        {
                            var mevcutDurum =
                                detaylar != null &&
                                detaylar.ContainsKey(ogrenci.Id)
                                    ? detaylar[ogrenci.Id]
                                    : false;

                            <div class="student-row">

                                <div>
                                    <div class="student-name">
                                        @ogrenci.AdSoyad
                                    </div>

                                    <div class="student-no">
                                        Öğrenci No: @ogrenci.OgrenciNo
                                    </div>
                                </div>

                                <div class="attendance-actions">

                                    <label class="status-option">
                                        <input type="radio"
                                               name="durumlar[@ogrenci.Id]"
                                               value="true"
                                               @(mevcutDurum ? "checked" : "") />

                                        <span class="status-button present">
                                            ✓ Geldi
                                        </span>
                                    </label>

                                    <label class="status-option">
                                        <input type="radio"
                                               name="durumlar[@ogrenci.Id]"
                                               value="false"
                                               @(!mevcutDurum ? "checked" : "") />

                                        <span class="status-button absent">
                                            ✕ Gelmedi
                                        </span>
                                    </label>

                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            Bu yoklamada öğrenci bulunmamaktadır.
                        </div>
                    }
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="edit-footer">
                        <div class="edit-info">
                            Yaptığınız değişiklikleri kontrol ettikten sonra kaydedebilirsiniz.
                        </div>

                        <button type="submit" class="save-button">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                <polyline points="7 3 7 8 15 8"></polyline>
                            </svg>
                            Yoklamayı Güncelle
                        </button>
                    </div>
                }
            </div>
        </form>

    </div>
</div>

