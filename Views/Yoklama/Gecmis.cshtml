@model IEnumerable<OkulTakipSistemi.Models.Sinif>

@{
    ViewData["Title"] = "Yoklama Listesi";
}

<style>
    .yoklama-page {
        min-height: calc(100vh - 100px);
        background: #f3f8f5;
        padding: 45px 0;
    }

    .page-header {
        background: #198754;
        color: white;
        border-radius: 18px;
        padding: 28px 32px;
        margin-bottom: 30px;
        box-shadow: 0 8px 20px rgba(25, 135, 84, 0.15);
    }

    .page-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
    }

    .page-header p {
        margin: 7px 0 0;
        opacity: .9;
        font-size: 15px;
    }

    .back-btn {
        background: white;
        color: #198754;
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: .2s ease;
    }

    .back-btn:hover {
        background: #e9f5ef;
        color: #146c43;
        transform: translateY(-1px);
    }

    .class-card {
        background: white;
        border: 1px solid #dceee4;
        border-radius: 18px;
        padding: 24px;
        height: 100%;
        box-shadow: 0 5px 15px rgba(0,0,0,.05);
        transition: .2s ease;
    }

    .class-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
        border-color: #b9dcc8;
    }

    .class-top {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .class-icon {
        width: 50px;
        height: 50px;
        flex-shrink: 0;
        border-radius: 14px;
        background: #e9f7ef;
        color: #198754;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .class-info h4 {
        margin: 0;
        color: #146c43;
        font-size: 19px;
        font-weight: 700;
    }

    .school-name {
        margin-top: 5px;
        color: #7a857f;
        font-size: 13px;
    }

    .class-divider {
        height: 1px;
        background: #edf1ee;
        margin: 20px 0;
    }

    .history-btn {
        width: 100%;
        min-height: 43px;
        border-radius: 10px;
        padding: 10px 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        background: #edf8f2;
        color: #198754;
        border: 1px solid #cce8d8;
        transition: .2s ease;
    }

    .history-btn:hover {
        background: #dff2e7;
        color: #146c43;
        border-color: #b9dcc8;
    }

    .empty-message {
        background: white;
        border: 1px solid #dceee4;
        border-radius: 16px;
        padding: 40px 25px;
        color: #6c757d;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0,0,0,.04);
    }

    .empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #edf3ef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .empty-message strong {
        display: block;
        color: #344039;
        font-size: 16px;
        margin-bottom: 6px;
    }

    .empty-message span {
        font-size: 14px;
        color: #89938d;
    }

    @@media (max-width: 768px) {
        .yoklama-page {
            padding: 25px 0;
        }

        .page-header {
            padding: 22px;
        }

        .page-header .d-flex {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 18px;
        }

        .back-btn {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="yoklama-page">

    <div class="container">

        <div class="page-header">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <div style="font-size:12px; font-weight:800; letter-spacing:1.5px; opacity:.85; margin-bottom:6px;">
                        YOKLAMA
                    </div>

                    <h1>Yoklama Listesi</h1>

                    <p>
                        Yoklama geçmişini görüntülemek istediğiniz sınıfı seçiniz.
                    </p>
                </div>

                <a asp-controller="Home"
                   asp-action="OgretmenPanel"
                   class="back-btn">
                    ← Ana Sayfaya Dön
                </a>

            </div>

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                @foreach (var sinif in Model)
                {
                    <div class="col-md-6 col-lg-4">

                        <div class="class-card">

                            <div class="class-top">

                                <div class="class-icon">
                                    📋
                                </div>

                                <div class="class-info">

                                    <h4>
                                        @sinif.Ad
                                    </h4>

                                    @if (sinif.Okul != null)
                                    {
                                        <div class="school-name">
                                            Okul: @sinif.Okul.Ad
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="school-name">
                                            Okul bilgisi bulunmuyor
                                        </div>
                                    }

                                </div>

                            </div>

                            <div class="class-divider"></div>

                            <a asp-controller="Yoklama"
                               asp-action="SinifGecmis"
                               asp-route-id="@sinif.Id"
                               class="history-btn">

                                📋 Yoklama Geçmişini Gör

                                <span>→</span>

                            </a>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-message">

                <div class="empty-icon">
                    📋
                </div>

                <strong>
                    Size atanmış sınıf bulunmamaktadır.
                </strong>

                <span>
                    Yoklama geçmişini görüntüleyebilmek için önce bir sınıfa atanmanız gerekir.
                </span>

            </div>
        }

    </div>

</div>
