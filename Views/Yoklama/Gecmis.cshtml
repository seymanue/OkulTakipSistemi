<style>
* {
    box-sizing: border-box;
}

html,
body {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    min-width: 0 !important;
    background: #f5eee8 !important;
    color: #4f3328 !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif !important;
}

/* BU SAYFADA ÜST NAVBAR YOK */
body:has(.yoklama-history-page) > header {
    display: none !important;
}

body:has(.yoklama-history-page) > .container-fluid {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
}

body:has(.yoklama-history-page) main {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* ANA ALAN */
.yoklama-history-page {
    width: 100% !important;
    min-height: 100vh !important;
    margin: 0 !important;
    padding: 28px 32px 45px !important;
    background: #f5eee8 !important;
}

.history-container {
    width: min(1120px, 100%) !important;
    max-width: 1120px !important;
    margin: 0 auto !important;
    padding: 0 !important;
}

/* ÜST PANEL */
.history-header {
    width: 100% !important;
    min-height: 125px !important;
    margin: 0 0 20px !important;
    padding: 23px 26px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 20px !important;

    background: #9b593b !important;
    border: 0 !important;
    border-radius: 16px !important;
    box-shadow: 0 8px 22px rgba(91,48,31,.14) !important;
}

.history-kicker {
    display: none !important;
}

.history-header h1 {
    margin: 0 !important;
    color: #fff8f1 !important;
    font-size: 28px !important;
    line-height: 1.2 !important;
    font-weight: 700 !important;
    letter-spacing: -.3px !important;
}

.history-header p {
    margin: 7px 0 0 !important;
    color: #f3d8c5 !important;
    font-size: 14px !important;
    line-height: 1.45 !important;
}

/* GERİ BUTONU */
.history-back {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;

    min-height: 42px !important;
    padding: 0 17px !important;

    background: #a95f3b !important;
    color: #fff8f1 !important;
    border: 1px solid rgba(255,245,235,.4) !important;
    border-radius: 10px !important;

    text-decoration: none !important;
    font-size: 14px !important;
    font-weight: 600 !important;

    transition: none !important;
    box-shadow: none !important;
    transform: none !important;
}

.history-back:hover {
    background: #a95f3b !important;
    color: #fff8f1 !important;
    border-color: rgba(255,245,235,.4) !important;
    transform: none !important;
}

/* SINIF KARTLARI */
.history-grid {
    width: 100% !important;
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 18px !important;
}

.history-class-card {
    position: relative !important;
    width: 100% !important;
    min-height: 190px !important;
    padding: 21px !important;

    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;

    background: rgba(255,255,255,.84) !important;
    border: 1px solid rgba(155,89,59,.16) !important;
    border-radius: 16px !important;

    box-shadow: 0 7px 20px rgba(91,48,31,.08) !important;
    overflow: hidden !important;
    transition: none !important;
}

.history-class-card::before {
    height: 3px !important;
    background: #a95f3b !important;
}

/* SINIF ÜST KISMI */
.history-class-top {
    display: flex !important;
    align-items: center !important;
    gap: 14px !important;
}

.history-class-icon {
    width: 52px !important;
    height: 52px !important;
    flex: 0 0 52px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    background: #ead4c5 !important;
    color: #9b593b !important;
    border: 1px solid #dfc3b2 !important;
    border-radius: 13px !important;
}

.history-class-icon svg {
    width: 28px !important;
    height: 28px !important;
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 1.7 !important;
    stroke-linecap: round !important;
    stroke-linejoin: round !important;
}

.history-class-info h2 {
    margin: 0 !important;
    color: #4f3328 !important;
    font-size: 20px !important;
    line-height: 1.25 !important;
    font-weight: 700 !important;
}

.history-school {
    margin-top: 4px !important;
    color: #80665a !important;
    font-size: 13px !important;
}

/* AYIRICI */
.history-divider {
    width: 100% !important;
    height: 1px !important;
    margin: 15px 0 !important;
    background: #eaded5 !important;
}

/* BUTON */
.history-button {
    width: 100% !important;
    min-height: 42px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 10px !important;

    padding: 0 14px !important;

    background: #a95f3b !important;
    color: #fff8f1 !important;
    border: 0 !important;
    border-radius: 10px !important;

    text-decoration: none !important;
    font-size: 13px !important;
    font-weight: 600 !important;

    box-shadow: none !important;
    transition: none !important;
}

.history-button:hover {
    background: #a95f3b !important;
    color: #fff8f1 !important;
    transform: none !important;
}

.history-button svg {
    width: 17px !important;
    height: 17px !important;
    flex: 0 0 17px !important;
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 1.8 !important;
    stroke-linecap: round !important;
    stroke-linejoin: round !important;
}

/* BOŞ DURUM */
.history-empty {
    width: 100% !important;
    padding: 40px 25px !important;
    text-align: center !important;
    background: rgba(255,255,255,.84) !important;
    border: 1px solid rgba(155,89,59,.16) !important;
    border-radius: 16px !important;
}

.history-empty-icon {
    width: 55px !important;
    height: 55px !important;
    margin: 0 auto 14px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: #ead4c5 !important;
    color: #9b593b !important;
    border-radius: 13px !important;
}

.history-empty-icon svg {
    width: 29px !important;
    height: 29px !important;
    fill: none !important;
    stroke: currentColor !important;
}

.history-empty strong {
    display: block !important;
    margin-bottom: 6px !important;
    color: #4f3328 !important;
    font-size: 16px !important;
}

.history-empty span {
    display: block !important;
    color: #80665a !important;
    font-size: 13px !important;
}

/* RESPONSIVE */
@@media (max-width: 750px) {
    .yoklama-history-page {
        padding: 20px !important;
    }

    .history-header {
        align-items: flex-start !important;
        flex-direction: column !important;
    }

    .history-back {
        width: auto !important;
    }

    .history-grid {
        grid-template-columns: 1fr !important;
    }
}

@@media (max-width: 500px) {
    .yoklama-history-page {
        padding: 16px !important;
    }

    .history-header {
        padding: 20px !important;
    }

    .history-header h1 {
        font-size: 25px !important;
    }

    .history-class-card {
        min-height: 185px !important;
        padding: 19px !important;
    }
}
</style>

@model IEnumerable<OkulTakipSistemi.Models.Sinif>

@{
    ViewData["Title"] = "Yoklama Listesi";
}



<div class="yoklama-history-page">

    <div class="history-container">

        <div class="history-header">

            <div>
                <h1>Yoklama Listesi</h1>

                <p>
                    Yoklama geçmişini görüntülemek istediğiniz sınıfı seçiniz.
                </p>
            </div>

            <a asp-controller="Home"
               asp-action="OgretmenPanel"
               class="history-back">
                ← Ana Sayfaya Dön
            </a>

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="history-grid">

                @foreach (var sinif in Model)
                {
                    <div class="history-class-card">

                        <div>

                            <div class="history-class-top">

                                <div class="history-class-icon">

                                    <svg viewBox="0 0 24 24">

                                        <rect x="5" y="3" width="14" height="18" rx="2" />

                                        <path d="M8 7h8" />
                                        <path d="M8 11h8" />
                                        <path d="M8 15h5" />

                                    </svg>

                                </div>

                                <div class="history-class-info">

                                    <h2>
                                        @sinif.Ad
                                    </h2>

                                    @if (sinif.Okul != null)
                                    {
                                        <div class="history-school">
                                            Okul: @sinif.Okul.Ad
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="history-school">
                                            Okul bilgisi bulunmuyor
                                        </div>
                                    }

                                </div>

                            </div>

                            <div class="history-divider"></div>

                        </div>

                        <a asp-controller="Yoklama"
                           asp-action="SinifGecmis"
                           asp-route-id="@sinif.Id"
                           class="history-button">

                            <span>
                                Yoklama Geçmişini Gör
                            </span>

                            <svg viewBox="0 0 24 24">
                                <path d="M5 12h14" />
                                <path d="m13 6 6 6-6 6" />
                            </svg>

                        </a>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="history-empty">

                <div class="history-empty-icon">

                    <svg viewBox="0 0 24 24">

                        <rect x="5" y="3" width="14" height="18" rx="2" />
                        <path d="M8 7h8" />
                        <path d="M8 11h8" />
                        <path d="M8 15h5" />

                    </svg>

                </div>

                <strong>
                    Size atanmış sınıf bulunmamaktadır.
                </strong>

                <span>
                    Yoklama geçmişini görüntüleyebilmek için önce bir sınıfa atanmanız gerekir.
                </span>

            </div>
        }

    </div>

</div>




<style>
/* =========================================================
   YOKLAMA GEÇMİŞİ
   YOKLAMA AL SAYFASIYLA AYNI TASARIM
   ========================================================= */

.yoklama-history-page {
    background:
        radial-gradient(circle at 10% 15%, rgba(194,111,55,.12), transparent 28%),
        radial-gradient(circle at 90% 80%, rgba(151,91,54,.10), transparent 30%),
        #f6eee7 !important;
}

/* ÜST PANEL */
.history-header {
    position: relative !important;
    overflow: hidden !important;

    min-height: 135px !important;
    padding: 28px 32px !important;

    background:
        linear-gradient(
            135deg,
            #b95f2c 0%,
            #c8753c 48%,
            #a9572d 100%
        ) !important;

    border-radius: 24px !important;

    box-shadow:
        0 18px 40px rgba(110,58,35,.18) !important;
}

.history-header::before {
    content: "" !important;
    position: absolute !important;
    width: 180px !important;
    height: 180px !important;
    right: -65px !important;
    top: -95px !important;
    border-radius: 50% !important;
    background: rgba(255,255,255,.10) !important;
}

.history-header::after {
    content: "" !important;
    position: absolute !important;
    width: 110px !important;
    height: 110px !important;
    right: 28% !important;
    bottom: -80px !important;
    border-radius: 50% !important;
    background: rgba(255,255,255,.07) !important;
}

.history-header h1,
.history-header p {
    position: relative !important;
    z-index: 2 !important;
}

.history-header h1 {
    color: #fffaf5 !important;
    font-size: 34px !important;
    font-weight: 800 !important;
}

.history-header p {
    color: rgba(255,250,245,.88) !important;
}

/* GERİ BUTONU */
.history-back {
    position: relative !important;
    z-index: 5 !important;

    background: rgba(255,255,255,.13) !important;
    border: 1px solid rgba(255,255,255,.28) !important;
    border-radius: 14px !important;

    color: #fffaf5 !important;

    transition: all .2s ease !important;
}

.history-back:hover {
    background: rgba(255,255,255,.22) !important;
    transform: translateY(-2px) !important;
}

/* =========================================================
   3'LÜ KART DÜZENİ
   ========================================================= */

.history-grid {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 22px !important;
}

/* KART */
.history-class-card {
    position: relative !important;
    overflow: hidden !important;

    min-height: 205px !important;
    padding: 22px !important;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.97),
            rgba(249,239,231,.94)
        ) !important;

    border: 1px solid rgba(183,108,65,.20) !important;
    border-radius: 24px !important;

    box-shadow:
        0 10px 28px rgba(91,54,37,.10) !important;

    transition:
        transform .22s ease,
        box-shadow .22s ease,
        border-color .22s ease !important;
}

.history-class-card::before {
    content: "" !important;
    position: absolute !important;
    left: 0 !important;
    right: 0 !important;
    top: 0 !important;
    height: 4px !important;

    background:
        linear-gradient(
            90deg,
            #b65c2d,
            #d48745
        ) !important;
}

.history-class-card:hover {
    transform: translateY(-7px) !important;

    box-shadow:
        0 18px 38px rgba(91,54,37,.17) !important;

    border-color: rgba(184,93,43,.35) !important;
}

/* KART KÖŞE DEKORU */
.history-class-card::after {
    content: "" !important;
    position: absolute !important;

    width: 110px !important;
    height: 110px !important;

    right: -45px !important;
    top: -45px !important;

    border-radius: 50% !important;

    background: rgba(201,120,70,.10) !important;

    pointer-events: none !important;
}

/* İKON */
.history-class-icon {
    width: 56px !important;
    height: 56px !important;
    flex: 0 0 56px !important;

    background:
        linear-gradient(
            145deg,
            #f5ddca,
            #efd0b9
        ) !important;

    color: #a45831 !important;

    border: 1px solid rgba(165,85,47,.16) !important;
    border-radius: 16px !important;

    box-shadow:
        0 6px 15px rgba(133,73,43,.10) !important;

    transition:
        transform .22s ease !important;
}

.history-class-card:hover .history-class-icon {
    transform: rotate(-4deg) scale(1.07) !important;
}

/* SINIF BİLGİSİ */
.history-class-info h2 {
    color: #4b3025 !important;
    font-size: 21px !important;
    font-weight: 800 !important;
}

.history-school {
    color: #86695a !important;
}

/* AYIRICI */
.history-divider {
    background: #ead7c9 !important;
}

/* BUTON */
.history-button {
    min-height: 46px !important;

    background:
        linear-gradient(
            135deg,
            #b95e2d,
            #c97036
        ) !important;

    color: #fffaf5 !important;

    border: none !important;
    border-radius: 13px !important;

    box-shadow:
        0 7px 15px rgba(142,72,39,.18) !important;

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        filter .18s ease !important;
}

.history-button:hover {
    background:
        linear-gradient(
            135deg,
            #a95229,
            #bd632f
        ) !important;

    color: #fffaf5 !important;

    transform: translateY(-2px) !important;

    box-shadow:
        0 11px 21px rgba(142,72,39,.25) !important;
}

.history-button:hover svg {
    transform: translateX(4px) !important;
}

.history-button svg {
    transition: transform .18s ease !important;
}

/* KARTLARDA HAFİF RENK FARKI */
.history-class-card:nth-child(3n+1) .history-class-icon {
    background: #f3ddce !important;
    color: #a45630 !important;
}

.history-class-card:nth-child(3n+2) .history-class-icon {
    background: #f5e4c4 !important;
    color: #a16b2e !important;
}

.history-class-card:nth-child(3n) .history-class-icon {
    background: #eadbd3 !important;
    color: #895844 !important;
}

/* MOBİL */
@@media (max-width: 850px) {
    .history-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
}

@@media (max-width: 600px) {
    .yoklama-history-page {
        padding: 20px 15px 40px !important;
    }

    .history-grid {
        grid-template-columns: 1fr !important;
    }
}
</style>


<style>

/* =========================================================
   ORTAK ÖĞRETMEN SAYFASI TASARIMI
   TARÇIN + KAHVE + TURUNCU
   ========================================================= */

:root {
    --cinnamon: #b85d2b;
    --cinnamon-dark: #8f452b;
    --terracotta: #d97832;
    --orange: #e59a32;
    --cream: #fff8f1;
    --cream-2: #f8eee6;
    --coffee: #51342a;
    --muted: #80665a;
    --line: #eadbd0;
}

/* =========================
   SINIFLARIM
   ========================= */

body:has(.siniflarim-page) {
    background: #f5eee8 !important;
}

.siniflarim-page {
    background:
        radial-gradient(circle at 8% 8%, rgba(239,167,111,.72), transparent 25%),
        radial-gradient(circle at 92% 12%, rgba(218,127,91,.55), transparent 26%),
        radial-gradient(circle at 15% 90%, rgba(193,112,78,.38), transparent 27%),
        radial-gradient(circle at 88% 90%, rgba(238,178,126,.44), transparent 25%),
        linear-gradient(135deg,#d99a73 0%,#b97658 43%,#875448 72%,#674239 100%) !important;
}

.siniflarim-page .top-bar {
    background: rgba(255,248,242,.25) !important;
    border-color: rgba(255,239,227,.55) !important;
    border-radius: 24px !important;
}

.siniflarim-page .page-heading h1 {
    color: #fffaf6 !important;
}

.siniflarim-page .heading-label {
    background: rgba(120,57,39,.28) !important;
}

.siniflarim-page .classes-grid {
    gap: 20px !important;
}

.siniflarim-page .class-card {
    position: relative !important;
    overflow: hidden !important;
    background: rgba(255,250,246,.94) !important;
    border: 1px solid rgba(255,255,255,.72) !important;
    border-radius: 22px !important;
    box-shadow: 0 14px 35px rgba(74,38,27,.16) !important;
    transition: transform .22s ease, box-shadow .22s ease !important;
}

.siniflarim-page .class-card::before {
    content: "" !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    height: 6px !important;
    background: linear-gradient(90deg,#b85d2b,#e59a32) !important;
}

.siniflarim-page .class-card:nth-child(3n+2)::before {
    background: linear-gradient(90deg,#d97832,#e9b044) !important;
}

.siniflarim-page .class-card:nth-child(3n)::before {
    background: linear-gradient(90deg,#8f452b,#b85d2b) !important;
}

.siniflarim-page .class-card:hover {
    transform: translateY(-5px) !important;
    box-shadow: 0 20px 42px rgba(74,38,27,.22) !important;
}

.siniflarim-page .class-icon {
    background: #f0d8c9 !important;
    color: #b85d2b !important;
    border-color: #dfc0ad !important;
    border-radius: 16px !important;
}

.siniflarim-page .class-card:nth-child(3n+2) .class-icon {
    background: #f7e7c3 !important;
    color: #c17b14 !important;
    border-color: #ecd59e !important;
}

.siniflarim-page .class-card:nth-child(3n) .class-icon {
    background: #ead1c7 !important;
    color: #8f452b !important;
    border-color: #dcb7aa !important;
}

.siniflarim-page .class-info h2,
.siniflarim-page .class-info h3 {
    color: var(--coffee) !important;
}

.siniflarim-page .school-name {
    color: var(--muted) !important;
}

.siniflarim-page .class-divider {
    background: var(--line) !important;
}

.siniflarim-page .class-view {
    background: linear-gradient(135deg,#b85d2b,#d97832) !important;
    color: #fff !important;
    border-radius: 13px !important;
    box-shadow: 0 7px 16px rgba(184,93,43,.20) !important;
}

.siniflarim-page .class-card:nth-child(3n+2) .class-view {
    background: linear-gradient(135deg,#d38a19,#e5a52e) !important;
}

.siniflarim-page .class-card:nth-child(3n) .class-view {
    background: linear-gradient(135deg,#8f452b,#b85d2b) !important;
}

.siniflarim-page .empty-message {
    background: rgba(255,250,246,.94) !important;
    border-radius: 22px !important;
    border-color: rgba(184,93,43,.18) !important;
}

.siniflarim-page .empty-icon {
    background: #f0d8c9 !important;
    color: #b85d2b !important;
}


/* =========================================================
   YOKLAMA AL
   ========================================================= */

body:has(.attendance-page) {
    background: #f5eee8 !important;
}

.attendance-page {
    min-height: 100vh !important;
    padding: 30px 32px 50px !important;
    background:
        radial-gradient(circle at 5% 5%,rgba(239,167,111,.28),transparent 23%),
        radial-gradient(circle at 95% 10%,rgba(218,127,91,.22),transparent 25%),
        linear-gradient(135deg,#f8eee7,#f2e2d6) !important;
}

.attendance-page .attendance-header {
    max-width: 1180px !important;
    margin: 0 auto 20px !important;
    padding: 25px 28px !important;
    border-radius: 22px !important;
    background: linear-gradient(135deg,#a9572f,#d97832) !important;
    border: 1px solid rgba(255,255,255,.28) !important;
    box-shadow: 0 14px 32px rgba(91,48,31,.16) !important;
}

.attendance-page .page-kicker {
    color: #ffe6d4 !important;
    font-weight: 700 !important;
    letter-spacing: 1.1px !important;
}

.attendance-page .attendance-header h1 {
    color: #fffaf6 !important;
}

.attendance-page .attendance-header p {
    color: #f8ded0 !important;
}

