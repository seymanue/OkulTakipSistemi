<body>

<div class="siniflarim-page">

    <div class="page-container">

        <!-- ÜST BAR -->
        <div class="top-bar">

            <div class="brand">
                <div>
                    <div class="brand-title">Sınıflarım</div>

                    <p class="brand-description">
                        Size atanmış sınıfları buradan görüntüleyebilir,
                        öğrencilerinize hızlıca ulaşabilirsiniz.
                    </p>
                </div>
            </div>

            <a href="/Home/OgretmenPanel" class="back-btn">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 12H5"/>
                    <path d="m11 18-6-6 6-6"/>
                </svg>
                <span>Anasayfaya Dön</span>
            </a>

        </div>

        <!-- SINIFLAR -->
        @if (Model != null && Model.Any())
        {
            <div class="classes-grid">

                @foreach (var sinif in Model)
                {
                    <div class="class-card">

                        <div class="class-top">

                            <div class="class-icon">

                                <svg viewBox="0 0 48 48" aria-hidden="true">
                                    <path d="M8 15.5 24 8l16 7.5L24 23 8 15.5Z"/>
                                    <path d="M12 18v12l12 7 12-7V18"/>
                                    <path d="M40 17v11"/>
                                    <path d="M18 26l6 3.5 6-3.5"/>
                                </svg>

                            </div>

                            <div class="class-info">

                                <h4>@sinif.Ad</h4>

                                @if (sinif.Okul != null)
                                {
                                    <div class="school-name">
                                        @sinif.Okul.Ad
                                    </div>
                                }
                                else
                                {
                                    <div class="school-name">
                                        Okul bilgisi bulunmuyor
                                    </div>
                                }

                            </div>

                        </div>

                        <div class="class-divider"></div>

                        <a href="/Ogretmen/SinifOgrencileri/@sinif.Id"
                           class="class-view">

                            <span class="class-view-content">

                                Öğrencileri Gör

                            </span>

                            <span class="arrow">
    <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h14"/>
        <path d="m13 6 6 6-6 6"/>
    </svg>
</span>

                        </a>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-message">

                <div class="empty-icon">

                    <svg viewBox="0 0 48 48" aria-hidden="true">
                        <path d="M8 15.5 24 8l16 7.5L24 23 8 15.5Z"/>
                        <path d="M12 18v12l12 7 12-7V18"/>
                        <path d="M40 17v11"/>
                    </svg>

                </div>

                <strong>Size atanmış sınıf bulunmamaktadır.</strong>

                <span>
                    Size bir sınıf atandığında burada görüntülenecektir.
                </span>

            </div>
        }

    </div>

</div>


<style id="siniflarim-baslik-aciklama">
    .page-heading .heading-label {
        display: block !important;
        margin-bottom: 8px !important;
    }

    .page-heading .siniflarim-aciklama {
        display: block !important;
        margin: 0 !important;
        padding: 0 !important;
        line-height: 1.6 !important;
    }
</style>

</body>
