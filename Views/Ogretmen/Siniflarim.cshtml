@model IEnumerable<OkulTakipSistemi.Models.Sinif>

@{
    ViewData["Title"] = "Sınıflarım";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Sınıflarım</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        body {
            color: #4d3026;
            background: #f4e6dc;
        }

        a {
            text-decoration: none;
        }

        /* =========================
           ANA SAYFA
        ========================= */

        .siniflarim-page {
            min-height: 100vh;
            padding: 34px 34px 50px;
            position: relative;
            overflow: hidden;

            background:
                radial-gradient(
                    circle at 8% 8%,
                    rgba(239, 167, 111, .75),
                    transparent 25%
                ),
                radial-gradient(
                    circle at 92% 12%,
                    rgba(218, 127, 91, .58),
                    transparent 26%
                ),
                radial-gradient(
                    circle at 15% 90%,
                    rgba(193, 112, 78, .42),
                    transparent 27%
                ),
                radial-gradient(
                    circle at 88% 90%,
                    rgba(238, 178, 126, .46),
                    transparent 25%
                ),
                linear-gradient(
                    135deg,
                    #d99a73 0%,
                    #b97658 43%,
                    #875448 72%,
                    #674239 100%
                );
        }

        .siniflarim-page::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            top: -210px;
            right: -150px;
            border-radius: 50%;
            background: rgba(255, 236, 217, .12);
            filter: blur(4px);
            pointer-events: none;
        }

        .siniflarim-page::after {
            content: "";
            position: absolute;
            width: 320px;
            height: 320px;
            bottom: -180px;
            left: -120px;
            border-radius: 50%;
            background: rgba(255, 201, 156, .13);
            pointer-events: none;
        }

        .page-container {
            width: min(1180px, 100%);
            margin: 0 auto;
            position: relative;
            z-index: 2;
        }

        /* =========================
           ÜST BAR
        ========================= */

        .top-bar {
            min-height: 76px;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;

            border: 1px solid rgba(255, 239, 227, .55);
            border-radius: 24px;

            background: rgba(255, 248, 242, .24);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);

            box-shadow:
                0 20px 55px rgba(70, 35, 25, .18),
                inset 0 1px 0 rgba(255,255,255,.22);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-icon {
            width: 48px;
            height: 48px;
            border-radius: 16px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: linear-gradient(
                145deg,
                rgba(127, 60, 39, .72),
                rgba(205, 111, 67, .56)
            );

            border: 1px solid rgba(255, 225, 207, .52);

            box-shadow:
                0 9px 22px rgba(94, 44, 29, .22),
                inset 0 1px 0 rgba(255,255,255,.25);
        }

        .brand-icon svg {
            width: 27px;
            height: 27px;
            stroke: #fff4ea;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .brand-title {
            margin: 0;
            color: #fffaf6;
            font-size: 18px;
            font-weight: 750;
            letter-spacing: -.2px;
        }

        .brand-subtitle {
            margin-top: 3px;
            color: rgba(255, 242, 232, .70);
            font-size: 12px;
        }

        .back-btn {
            min-height: 42px;
            padding: 0 16px;

            display: inline-flex;
            align-items: center;
            gap: 8px;

            color: #fff6ee;

            border: 1px solid rgba(255, 229, 211, .45);
            border-radius: 13px;

            background: rgba(117, 55, 37, .25);

            transition:
                transform .22s ease,
                background .22s ease,
                border-color .22s ease;
        }

        .back-btn svg {
            width: 17px;
            height: 17px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .back-btn:hover {
            transform: translateY(-2px);
            background: rgba(132, 61, 39, .46);
            border-color: rgba(255, 235, 219, .70);
        }

        /* =========================
           BAŞLIK
        ========================= */

        .page-heading {
            padding: 54px 6px 32px;
        }

        .heading-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;

            margin-bottom: 13px;
            padding: 7px 12px;

            color: #fff2e7;
            font-size: 11px;
            font-weight: 750;
            letter-spacing: 1.1px;
            text-transform: uppercase;

            border: 1px solid rgba(255, 230, 213, .38);
            border-radius: 999px;

            background: rgba(120, 57, 39, .24);
            backdrop-filter: blur(12px);
        }

        .heading-label-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #ffd0ad;
            box-shadow: 0 0 12px rgba(255, 208, 173, .7);
        }

        .page-heading h1 {
            margin: 0;
            color: #fffaf6;
            font-size: clamp(34px, 5vw, 48px);
            line-height: 1.05;
            letter-spacing: -1.8px;
            font-weight: 800;

            text-shadow: 0 8px 25px rgba(71, 34, 24, .20);
        }

        .page-heading p {
            max-width: 650px;
            margin: 13px 0 0;

            color: rgba(255, 239, 227, .78);
            font-size: 15px;
            line-height: 1.7;
        }

        /* =========================
           SINIF GRID
        ========================= */

        .classes-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
        }

        /* =========================
           SINIF KARTI
        ========================= */

        .class-card {
            position: relative;
            min-height: 245px;
            padding: 23px;

            display: flex;
            flex-direction: column;

            overflow: hidden;

            border: 1px solid rgba(255, 237, 223, .48);
            border-radius: 25px;

            background:
                linear-gradient(
                    145deg,
                    rgba(255, 250, 246, .36),
                    rgba(255, 222, 201, .18)
                );

            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);

            box-shadow:
                0 22px 50px rgba(72, 35, 24, .18),
                inset 0 1px 0 rgba(255,255,255,.22);

            transition:
                transform .28s ease,
                box-shadow .28s ease,
                border-color .28s ease,
                background .28s ease;
        }

        .class-card:hover {
            transform: translateY(-8px);
            border-color: rgba(255, 227, 208, .75);

            background:
                linear-gradient(
                    145deg,
                    rgba(255, 251, 247, .48),
                    rgba(255, 220, 195, .27)
                );

            box-shadow:
                0 32px 68px rgba(67, 31, 22, .26),
                inset 0 1px 0 rgba(255,255,255,.30);
        }

        .class-card::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            top: -105px;
            right: -75px;
            border-radius: 50%;
            background: rgba(255, 198, 153, .18);
            pointer-events: none;
        }

        .class-top {
            display: flex;
            align-items: center;
            gap: 16px;
            position: relative;
            z-index: 1;
        }

        /* =========================
           YENİ SINIF LOGOSU
        ========================= */

        .class-icon {
            width: 66px;
            height: 66px;
            min-width: 66px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 21px;

            border: 1px solid rgba(255, 232, 215, .58);

            background: linear-gradient(
                145deg,
                rgba(126, 57, 38, .72),
                rgba(211, 116, 70, .50)
            );

            box-shadow:
                0 12px 28px rgba(95, 42, 27, .22),
                inset 0 1px 0 rgba(255,255,255,.28);

            transition:
                transform .28s ease,
                border-radius .28s ease;
        }

        .class-card:hover .class-icon {
            transform: rotate(-4deg) scale(1.07);
            border-radius: 18px;
        }

        .class-icon svg {
            width: 35px;
            height: 35px;

            fill: none;
            stroke: #fff2e7;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;

            filter: drop-shadow(
                0 3px 5px rgba(72, 31, 20, .20)
            );
        }

        .class-info {
            min-width: 0;
        }

        .class-info h4 {
            margin: 0;
            color: #fffaf6;
            font-size: 20px;
            font-weight: 750;
            letter-spacing: -.3px;
        }

        .school-name {
            margin-top: 6px;
            color: rgba(255, 236, 224, .72);
            font-size: 13px;
        }

        .class-divider {
            height: 1px;
            margin: 23px 0 18px;

            background: linear-gradient(
                90deg,
                rgba(255, 225, 207, .05),
                rgba(255, 225, 207, .45),
                rgba(255, 225, 207, .05)
            );
        }

        /* =========================
           ÖĞRENCİLER BUTONU
        ========================= */

        .class-view {
            margin-top: auto;
            min-height: 46px;
            padding: 0 14px;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;

            color: #fff5ed !important;
            font-size: 13px;
            font-weight: 700;

            border: 1px solid rgba(255, 226, 208, .42);
            border-radius: 14px;

            background: rgba(126, 58, 39, .34);

            transition:
                background .22s ease,
                transform .22s ease,
                border-color .22s ease;
        }

        .class-view-content {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .student-icon {
            width: 19px;
            height: 19px;

            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .class-view .arrow {
            font-size: 20px;
            line-height: 1;
            color: #ffd5b9;

            transition: transform .22s ease;
        }

        .class-view:hover {
            transform: translateY(-2px);
            background: rgba(142, 64, 40, .55);
            border-color: rgba(255, 231, 216, .65);
        }

        .class-view:hover .arrow {
            transform: translateX(5px);
        }

        /* =========================
           FARKLI KART RENKLERİ
        ========================= */

        .class-card:nth-child(3n+1) .class-icon {
            background: linear-gradient(
                145deg,
                rgba(125, 56, 38, .76),
                rgba(214, 113, 66, .52)
            );
        }

        .class-card:nth-child(3n+2) .class-icon {
            background: linear-gradient(
                145deg,
                rgba(143, 70, 55, .76),
                rgba(216, 126, 93, .52)
            );
        }

        .class-card:nth-child(3n) .class-icon {
            background: linear-gradient(
                145deg,
                rgba(162, 78, 43, .76),
                rgba(228, 143, 82, .52)
            );
        }

        /* =========================
           BOŞ DURUM
        ========================= */

        .empty-message {
            padding: 58px 25px;
            text-align: center;

            border: 1px solid rgba(255, 234, 218, .48);
            border-radius: 27px;

            background: rgba(255, 248, 242, .25);

            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);

            box-shadow:
                0 24px 58px rgba(72, 35, 24, .18);
        }

        .empty-icon {
            width: 78px;
            height: 78px;
            margin: 0 auto 20px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 24px;

            background: linear-gradient(
                145deg,
                rgba(126, 57, 38, .65),
                rgba(218, 124, 76, .45)
            );

            border: 1px solid rgba(255, 227, 207, .55);
        }

        .empty-icon svg {
            width: 38px;
            height: 38px;
            fill: none;
            stroke: #fff1e5;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .empty-message strong {
            display: block;
            color: #fffaf6;
            font-size: 17px;
        }

        .empty-message span {
            display: block;
            margin-top: 8px;
            color: rgba(255, 236, 224, .70);
            font-size: 13px;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @@media (max-width: 950px) {
            .classes-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 680px) {
            .siniflarim-page {
                padding: 18px 15px 35px;
            }

            .top-bar {
                padding: 12px;
                border-radius: 19px;
            }

            .brand-subtitle {
                display: none;
            }

            .back-btn {
                width: 42px;
                padding: 0;
                justify-content: center;
                font-size: 0;
            }

            .back-btn svg {
                width: 19px;
                height: 19px;
            }

            .page-heading {
                padding: 40px 4px 25px;
            }

            .page-heading h1 {
                font-size: 36px;
            }

            .classes-grid {
                grid-template-columns: 1fr;
                gap: 15px;
            }

            .class-card {
                min-height: 225px;
                padding: 20px;
                border-radius: 22px;
            }
        }
    

/* ÜST KISIM - TURUNCU / KAHVE */
.top-bar {
    background: linear-gradient(135deg, #9a5638 0%, #b86b45 55%, #c8794c 100%) !important;
    border: none !important;
    box-shadow: 0 8px 24px rgba(91, 48, 31, 0.12) !important;
}

/* Üst yazıların mevcut renklerini koru */
.top-bar .brand-title,
.top-bar .brand-subtitle,
.top-bar .brand,
.top-bar .back-btn {
    color: inherit !important;
}

/* Geri butonu */
.top-bar .back-btn {
    background: rgba(255,255,255,.12) !important;
    border-color: rgba(255,255,255,.28) !important;
}

</style>

