@model IEnumerable<OkulTakipSistemi.Models.Ogretmen>

@{
    ViewData["Title"] = "Öğretmenler";
}

<style>
    .ogretmen-page {
        min-height: calc(100vh - 80px);
        padding: 30px 32px 50px;
        background: #f4f7fb;
    }

    .ogretmen-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .ogretmen-title {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .ogretmen-icon {
        width: 56px;
        height: 56px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 26px;
        background: linear-gradient(135deg, #60a5fa, #2563eb, #1e3a8a);
        box-shadow: 0 8px 20px rgba(37, 99, 235, .18);
    }

    .ogretmen-title h2 {
        margin: 0;
        color: #172554;
        font-size: 26px;
        font-weight: 750;
    }

    .ogretmen-title p {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 13px;
    }

    .ogretmen-add {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 43px;
        padding: 0 17px;
        border-radius: 11px;
        background: linear-gradient(135deg, #2563eb, #1e3a8a);
        color: #fff !important;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 7px 18px rgba(37, 99, 235, .20);
        transition: all .2s ease;
    }

    .ogretmen-add:hover {
        color: #fff !important;
        transform: translateY(-2px);
        box-shadow: 0 10px 23px rgba(37, 99, 235, .28);
    }

    .ogretmen-card {
        background: #fff;
        border: 1px solid #dbeafe;
        border-radius: 19px;
        overflow: hidden;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .055);
    }

    .ogretmen-card-head {
        min-height: 62px;
        padding: 0 21px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        background: linear-gradient(135deg, #f8fbff, #eff6ff);
        border-bottom: 1px solid #dbeafe;
    }

    .ogretmen-card-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #1e3a8a;
        font-size: 14px;
        font-weight: 750;
    }

    .ogretmen-card-title-icon {
        width: 29px;
        height: 29px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #dbeafe;
        font-size: 15px;
    }

    .ogretmen-count {
        padding: 5px 11px;
        border-radius: 20px;
        background: #dbeafe;
        color: #1d4ed8;
        font-size: 11px;
        font-weight: 750;
        white-space: nowrap;
    }

    .ogretmen-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .ogretmen-table {
        width: 100%;
        min-width: 900px;
        margin: 0;
        border-collapse: collapse;
    }

    .ogretmen-table th {
        padding: 13px 18px;
        background: #fbfdff;
        border-bottom: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 11px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .04em;
        white-space: nowrap;
        text-align: left;
    }

    .ogretmen-table td {
        padding: 15px 18px;
        border-bottom: 1px solid #eef2f7;
        color: #334155;
        font-size: 13px;
        vertical-align: middle;
    }

    .ogretmen-table tbody tr {
        transition: background .18s ease;
    }

    .ogretmen-table tbody tr:hover {
        background: #f8fbff;
    }

    .ogretmen-table tbody tr:last-child td {
        border-bottom: none;
    }

    .ogretmen-id {
        width: 60px;
        color: #94a3b8 !important;
        font-weight: 700;
    }

    .ogretmen-person {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #1e293b !important;
        font-weight: 700;
        white-space: nowrap;
    }

    .ogretmen-avatar {
        width: 37px;
        height: 37px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: linear-gradient(135deg, #dbeafe, #bfdbfe);
        color: #1d4ed8;
        font-size: 13px;
        font-weight: 800;
    }

    .ogretmen-branch {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 8px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        color: #1d4ed8;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .ogretmen-user {
        color: #475569 !important;
        font-weight: 600;
        white-space: nowrap;
    }

    .ogretmen-email {
        color: #64748b !important;
        white-space: nowrap;
    }

    .ogretmen-delete {
        border: none;
        padding: 7px 11px;
        border-radius: 9px;
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s ease;
    }

    .ogretmen-delete:hover {
        background: #fee2e2;
        transform: translateY(-1px);
    }

    .ogretmen-empty {
        padding: 50px 20px !important;
        text-align: center;
        color: #94a3b8 !important;
    }

    .ogretmen-empty-icon {
        display: block;
        margin-bottom: 9px;
        font-size: 31px;
    }

    @@media (max-width: 700px) {
        .ogretmen-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .ogretmen-add {
            width: 100%;
        }

        .ogretmen-title h2 {
            font-size: 23px;
        }
    }

    .page-title-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
        padding: 26px 30px;
        border: 1px solid #d9eaf8;
        border-radius: 20px;
        background: linear-gradient(135deg, #eaf5ff 0%, #d8ecff 55%, #c7e3fb 100%);
        box-shadow: 0 8px 25px rgba(26, 64, 99, 0.07);
    }

    .page-title-content {
        display: flex;
        align-items: center;
        gap: 17px;
        min-width: 0;
    }

    .page-title-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 54px;
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 5px 15px rgba(25, 87, 145, 0.10);
        font-size: 26px;
    }

    .page-title-box h1,
    .page-title-box h2 {
        margin: 0 0 5px;
        color: #163b61;
        font-size: 27px;
        font-weight: 800;
    }

    .page-title-box p {
        margin: 0;
        color: #607b95;
        font-size: 14px;
    }

    .page-title-action {
        flex-shrink: 0;
    }

    @@media (max-width: 700px) {
        .page-title-box {
            align-items: flex-start;
            flex-direction: column;
            padding: 22px;
        }

        .page-title-action {
            width: 100%;
        }
    }

</style>

<div class="ogretmen-page">

    <div class="page-title-box">

        <div class="page-title-content">

            <div class="page-title-icon">
                👩‍🏫
            </div>

            <div>
                <h2>Öğretmenler</h2>
                <p>Okulunuzdaki öğretmenleri görüntüleyin ve yönetin.</p>
            </div>

        </div>

        

    </div>

    <div class="ogretmen-card">

        <div class="ogretmen-card-head">

            <div class="ogretmen-card-title">
                <span class="ogretmen-card-title-icon">👩‍🏫</span>
                Öğretmen Listesi
            </div>

            <div class="ogretmen-count">
                @Model.Count() Öğretmen
            </div>

        </div>

        <div class="ogretmen-table-wrap">

            <table class="ogretmen-table">

                <thead>
                    <tr>
                        
                        <th>Ad Soyad</th>
                        <th>Kullanıcı</th>
                        <th>E-posta</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var ogretmen in Model)
                        {
                            var adSoyad = ogretmen.Kullanici?.AdSoyad ?? ogretmen.AdSoyad;

                            var ilkHarf = string.IsNullOrWhiteSpace(adSoyad)
                                ? "Ö"
                                : adSoyad.Substring(0, 1).ToUpper();

                            <tr>

                                <td>
                                    <div class="ogretmen-person">
                                        <span class="ogretmen-avatar">
                                            @ilkHarf
                                        </span>
                                        <span>@adSoyad</span>
                                    </div>
                                </td>

                                

                                <td class="ogretmen-user">
                                    @(ogretmen.Kullanici?.KullaniciAdi ?? "Atanmamış")
                                </td>

                                <td class="ogretmen-email">
                                    @(ogretmen.Kullanici?.Email ?? "-")
                                </td>

                                <td>

                                    <form asp-action="Delete"
                                          method="post"
                                          onsubmit="return confirm('Bu öğretmeni silmek istediğinize emin misiniz?');">

                                        <input type="hidden"
                                               name="id"
                                               value="@ogretmen.Id" />

                                        <button type="submit"
                                                class="ogretmen-delete">
                                            🗑️ Sil
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="ogretmen-empty">
                                <span class="ogretmen-empty-icon">👩‍🏫</span>
                                Henüz kayıtlı öğretmen bulunmuyor.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
