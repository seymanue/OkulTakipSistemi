@model IEnumerable<OkulTakipSistemi.Models.Ogrenci>

@{
    Layout = null;
    ViewData["Title"] = "Yoklama Al";

    var sinif = ViewBag.Sinif as OkulTakipSistemi.Models.Sinif;
    var ogrenciler = Model?.ToList() ?? new List<OkulTakipSistemi.Models.Ogrenci>();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Yoklama Al - Okul Takip Sistemi</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
            background: #f5eee8;
            color: #4f3328;
        }

        .yoklama-page {
            width: 100%;
            min-height: 100vh;
            padding: 28px 34px 40px;
            background: #f5eee8;
        }

        .yoklama-container {
            width: 100%;
            max-width: 1120px;
            margin: 0 auto;
        }

        /* ÜST BAŞLIK */

        .yoklama-header {
            width: 100%;
            min-height: 125px;
            padding: 22px 26px;
            margin-bottom: 20px;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;

            background: radial-gradient(circle at 82% -28%, rgba(255,255,255,.12) 0 115px, transparent 116px), radial-gradient(circle at 52% 122%, rgba(255,255,255,.08) 0 85px, transparent 86px), linear-gradient(135deg, #d96928 0%, #e98a3c 55%, #f09a45 100%);
            border-radius: 16px;
            box-shadow: 0 8px 22px rgba(91, 48, 31, .14);
        }

        .header-text {
            min-width: 0;
        }

        .header-kicker {
            margin-bottom: 6px;
            color: #f3d8c5;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.8px;
        }

        .yoklama-header h1 {
            margin: 0;
            color: #fff8f1;
            font-size: 28px;
            line-height: 1.2;
            font-weight: 700;
        }

        .yoklama-header p {
            margin: 7px 0 0;
            color: #f3d8c5;
            font-size: 14px;
            line-height: 1.45;
        }

        .yoklama-header p strong {
            color: #fff8f1;
        }

        .back-btn {
            flex-shrink: 0;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            min-height: 42px;
            padding: 0 17px;

            background: rgba(255,255,255,.08);
            color: #fff8f1;
            border: 1px solid rgba(255,245,235,.55);
            border-radius: 10px;

            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

        .back-btn:hover {
            background: rgba(255,255,255,.16);
            color: #fff8f1;
        }

        /* AÇIKLAMA */

        .attendance-note {
            display: flex;
            align-items: center;
            gap: 15px;

            width: 100%;
            padding: 16px 20px;
            margin-bottom: 18px;

            background: #fffaf6;
            border: 1px solid #e4d2c5;
            border-radius: 14px;
            box-shadow: 0 5px 16px rgba(91, 48, 31, .06);
        }

        .attendance-note-icon {
            flex: 0 0 42px;
            width: 42px;
            height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #ead4c5;
            color: #9b593b;
            border-radius: 10px;
        }

        .attendance-note-icon svg {
            width: 22px;
            height: 22px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .attendance-note-content {
            flex: 1;
            min-width: 0;
        }

        .attendance-note-content label {
            display: block;
            margin-bottom: 3px;
            color: #4f3328;
            font-size: 14px;
            font-weight: 700;
        }

        .attendance-note-content p {
            margin: 0 0 9px;
            color: #806457;
            font-size: 12px;
            line-height: 1.4;
        }

        .attendance-note-content input {
            width: 100%;
            height: 40px;
            padding: 0 12px;

            background: #fffdfb;
            border: 1px solid #d9c1b3;
            border-radius: 9px;

            color: #4f3328;
            font-family: inherit;
            font-size: 13px;
            outline: none;
        }

        .attendance-note-content input:focus {
            border-color: #9b593b;
            box-shadow: 0 0 0 3px rgba(155, 89, 59, .10);
        }

        /* ANA KART */

        .attendance-card {
            width: 100%;
            overflow: hidden;

            background: #fffaf6;
            border: 1px solid #e4d2c5;
            border-radius: 16px;
            box-shadow: 0 8px 22px rgba(91, 48, 31, .08);
        }

        .attendance-card-header {
            min-height: 76px;
            padding: 17px 22px;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;

            background: #f3e4da;
            border-bottom: 1px solid #e3cfc1;
        }

        .attendance-title h2 {
            margin: 0;
            color: #4f3328;
            font-size: 19px;
            line-height: 1.25;
            font-weight: 700;
        }

        .attendance-title p {
            margin: 4px 0 0;
            color: #806457;
            font-size: 12px;
        }

        .student-count {
            flex-shrink: 0;

            padding: 7px 12px;

            background: #ead4c5;
            border: 1px solid #d8b8a5;
            border-radius: 18px;

            color: #8f4f32;
            font-size: 12px;
            font-weight: 700;
        }

        /* ÖĞRENCİLER */

        .student-list {
            width: 100%;
            background: #fffaf6;
        }

        .student-row {
            min-height: 64px;
            padding: 10px 22px;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;

            background: #fffaf6;
            border-bottom: 1px solid #eee1d8;
        }

        .student-row:last-child {
            border-bottom: 0;
        }

        .student-row:hover {
            background: #fcf4ef;
        }

        .student-info {
            min-width: 0;
        }

        .student-details {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .student-details strong {
            color: #4f3328;
            font-size: 14px;
            line-height: 1.3;
            font-weight: 650;
        }

        .student-details span {
            color: #806457;
            font-size: 12px;
            line-height: 1.3;
        }

        /* GELDİ / GELMEDİ */

        .attendance-choice {
            flex-shrink: 0;

            display: flex;
            align-items: center;
            gap: 8px;
        }

        .attendance-choice label {
            position: relative;
            display: block;
            cursor: pointer;
        }

        .attendance-choice input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .choice-button {
            width: 38px;
            height: 38px;

            display: flex;
            align-items: center;
            justify-content: center;

            border: 1px solid #d9c1b3;
            border-radius: 9px;

            background: #fffaf6;
            color: #9b593b;

            font-size: 17px;
            font-weight: 700;

            transition: .15s ease;
        }

        .attendance-choice input:checked + .choice-present {
            background: #9b593b;
            border-color: #9b593b;
            color: #fff8f1;
        }

        .attendance-choice input:checked + .choice-absent {
            background: #795348;
            border-color: #795348;
            color: #fff8f1;
        }

        .attendance-choice label:hover .choice-button {
            border-color: #9b593b;
            background: #f3e4da;
        }

        /* BOŞ SINIF */

        .empty-students {
            min-height: 180px;
            padding: 35px 20px;

            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 7px;

            text-align: center;
        }

        .empty-icon {
            width: 48px;
            height: 48px;
            margin-bottom: 5px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #ead4c5;
            color: #9b593b;
            border-radius: 12px;
        }

        .empty-icon svg {
            width: 27px;
            height: 27px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .empty-students strong {
            color: #4f3328;
            font-size: 15px;
        }

        .empty-students span {
            color: #806457;
            font-size: 12px;
        }

        /* ALT */

        .attendance-footer {
            min-height: 68px;
            padding: 13px 22px;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;

            background: #fffaf6;
            border-top: 1px solid #eee1d8;
        }

        .attendance-info {
            display: flex;
            align-items: center;
            gap: 9px;

            color: #806457;
            font-size: 12px;
            line-height: 1.4;
        }

        .info-icon {
            width: 26px;
            height: 26px;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #ead4c5;
            color: #9b593b;
            border-radius: 50%;

            font-size: 13px;
            font-weight: 700;
        }

        .save-attendance {
            flex-shrink: 0;

            min-height: 42px;
            padding: 0 17px;

            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;

            background: #9b593b;
            border: 1px solid #9b593b;
            border-radius: 10px;

            color: #fff8f1;
            font-family: inherit;
            font-size: 13px;
            font-weight: 650;

            cursor: pointer;
        }

        .save-attendance:hover {
            background: #9b593b;
            color: #fff8f1;
        }

        .save-attendance svg {
            width: 17px;
            height: 17px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* MESAJ */

        .attendance-message {
            width: 100%;
            margin-bottom: 18px;
            padding: 13px 16px;

            background: #fffaf6;
            border: 1px solid #e4d2c5;
            border-radius: 12px;

            color: #5b4034;
            font-size: 13px;
        }

        @@media (max-width: 700px) {
            .yoklama-page {
                padding: 16px;
            }

            .yoklama-header {
                padding: 20px;
                flex-direction: column;
                align-items: flex-start;
            }

            .back-btn {
                width: 100%;
            }

            .attendance-note {
                align-items: flex-start;
            }

            .attendance-card-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .student-row {
                padding: 10px 15px;
            }

            .attendance-footer {
                align-items: stretch;
                flex-direction: column;
            }

            .save-attendance {
                width: 100%;
            }
        }
    </style>
</head>

<body>

<div class="yoklama-page">

    <div class="yoklama-container">

        @if (TempData["YoklamaMesaji"] != null)
        {
            <div class="attendance-message">
                @TempData["YoklamaMesaji"]
            </div>
        }

        @if (TempData["YoklamaUyari"] != null)
        {
            <div class="attendance-message">
                @TempData["YoklamaUyari"]
            </div>
        }

        <!-- BAŞLIK -->

        <div class="yoklama-header">

            <div class="header-text">

                <h1>Yoklama Al</h1>

                <p>
                    <strong>@sinif?.Ad</strong>
                    sınıfındaki öğrencilerin günlük yoklamasını alın.
                </p>

            </div>

            <a href="@Url.Action("Yoklama", "Ogretmen")"
               class="back-btn">
                ← Sınıflara Dön
            </a>

        </div>


        <!-- FORM -->

        <form asp-controller="Ogretmen"
              asp-action="YoklamaKaydet"
              method="post">

            <input type="hidden"
                   name="sinifId"
                   value="@sinif?.Id" />


            <!-- AÇIKLAMA -->

            <div class="attendance-note">

                <div class="attendance-note-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M4 4h16v16H4z"></path>
                        <path d="M8 9h8M8 13h6M8 17h4"></path>
                    </svg>
                </div>

                <div class="attendance-note-content">

                    <label for="aciklama">
                        Yoklama Açıklaması
                    </label>

                    <p>
                        İsterseniz yoklama hakkında kısa bir açıklama ekleyebilirsiniz.
                    </p>

                    <input type="text"
                           id="aciklama"
                           name="aciklama"
                           maxlength="500"
                           placeholder="Örn: 15 Eylül Salı gününün yoklamasıdır." />

                </div>

            </div>


            <!-- ÖĞRENCİ KARTI -->

            <div class="attendance-card">

                <div class="attendance-card-header">

                    <div class="attendance-title">

                        <h2>Öğrenciler</h2>

                        <p>
                            Her öğrenci için geldi veya gelmedi seçimini yapınız.
                        </p>

                    </div>

                    <div class="student-count">
                        @ogrenciler.Count Öğrenci
                    </div>

                </div>


                <div class="student-list">

                    @if (ogrenciler.Any())
                    {
                        foreach (var ogrenci in ogrenciler)
                        {
                            <div class="student-row">

                                <div class="student-info">

                                    <div class="student-details">

                                        <strong>
                                            @ogrenci.AdSoyad
                                        </strong>

                                        <span>
                                            Öğrenci No: @ogrenci.OgrenciNo
                                        </span>

                                    </div>

                                </div>


                                <div class="attendance-choice">

                                    <label title="Geldi">

                                        <input type="radio"
                                               name="durumlar[@ogrenci.Id]"
                                               value="true"
                                               required />

                                        <span class="choice-button choice-present">
                                            ✓
                                        </span>

                                    </label>


                                    <label title="Gelmedi">

                                        <input type="radio"
                                               name="durumlar[@ogrenci.Id]"
                                               value="false" />

                                        <span class="choice-button choice-absent">
                                            ✕
                                        </span>

                                    </label>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-students">

                            <div class="empty-icon">

                                <svg viewBox="0 0 24 24">
                                    <circle cx="12" cy="8" r="4"></circle>
                                    <path d="M4 21c0-4.2 3.6-7 8-7s8 2.8 8 7"></path>
                                </svg>

                            </div>

                            <strong>
                                Öğrenci bulunamadı
                            </strong>

                            <span>
                                Bu sınıfta kayıtlı öğrenci bulunmamaktadır.
                            </span>

                        </div>
                    }

                </div>


                @if (ogrenciler.Any())
                {
                    <div class="attendance-footer">

                        <div class="attendance-info">

                            <span class="info-icon">
                                !
                            </span>

                            <span>
                                Öğrencilerin durumunu kontrol ettikten sonra yoklamayı kaydedebilirsiniz.
                            </span>

                        </div>

                        <button type="submit"
                                class="save-attendance">

                            <svg viewBox="0 0 24 24">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                <polyline points="7 3 7 8 15 8"></polyline>
                            </svg>

                            <span class="save-text">Yoklamayı Kaydet</span>

                        </button>

                    </div>
                }

            </div>

        </form>

    </div>

</div>

</body>
</html>




<style id="yoklama-aciklama-renk">

.attendance-note {
    background: rgba(255, 251, 247, .94) !important;
}

</style>









<style id="siniflara-don-hover-temiz">

.back-btn {
    transition:
        background .22s ease,
        border-color .22s ease,
        box-shadow .22s ease,
        transform .22s ease !important;
}

.back-btn:hover {
    background: rgba(255,255,255,.16) !important;
    color: #fff8f1 !important;
    border-color: rgba(255,255,255,.65) !important;
    box-shadow: 0 5px 12px rgba(89,47,30,.12) !important;
    transform: translateY(-2px) scale(1.015) !important;
}

</style>







<style id="yoklama-kaydet-son-renk">

.save-attendance {
    background: #d96928 !important;
    border: 1px solid #d96928 !important;
    color: #fff8f1 !important;
}

.save-attendance:hover {
    background: #d96928 !important;
    border-color: #d96928 !important;
    color: #fff8f1 !important;
}

.save-attendance .save-text {
    background: transparent !important;
    color: #fff8f1 !important;
    padding: 0 !important;
}

.save-attendance:hover .save-text {
    background: transparent !important;
    color: #fff8f1 !important;
}

.save-attendance svg {
    stroke: #fff8f1 !important;
    color: #fff8f1 !important;
}

</style>

<style id="yoklama-isaret-renkleri">

/* SEÇİLİ DEĞİL */
.choice-button.choice-present,
.choice-button.choice-absent {
    background: #fffaf5 !important;
    color: #a95f3b !important;
    border: 1.5px solid rgba(169,95,59,.28) !important;
    transition:
        background .2s ease,
        color .2s ease,
        border-color .2s ease,
        transform .2s ease !important;
}

/* GELDİ - SEÇİLİ */
input[type="radio"]:checked + .choice-button.choice-present {
    background: #b95f2d !important;
    color: #fff8f1 !important;
    border-color: #b95f2d !important;
}

/* GELMEDİ - SEÇİLİ */
input[type="radio"]:checked + .choice-button.choice-absent {
    background: #a95f3b !important;
    color: #fff8f1 !important;
    border-color: #a95f3b !important;
}

/* HOVER */
.choice-button:hover {
    border-color: #b95f2d !important;
    color: #a95f3b !important;
}

input[type="radio"]:checked + .choice-button:hover {
    color: #fff8f1 !important;
}


/* YOKLAMA AI - ÜST PANEL BALONCUKLARI */
.yoklama-al-header {
    position: relative !important;
    overflow: hidden !important;
}

.yoklama-al-header::before {
    content: "" !important;
    position: absolute !important;
    width: 180px !important;
    height: 180px !important;
    border-radius: 50% !important;
    right: 8% !important;
    top: -95px !important;
    background: rgba(255,255,255,.10) !important;
    pointer-events: none !important;
}

.yoklama-al-header::after {
    content: "" !important;
    position: absolute !important;
    width: 135px !important;
    height: 135px !important;
    border-radius: 50% !important;
    left: 48% !important;
    bottom: -90px !important;
    background: rgba(255,255,255,.08) !important;
    pointer-events: none !important;
}

.yoklama-al-header > * {
    position: relative !important;
    z-index: 2 !important;
}
</style>
