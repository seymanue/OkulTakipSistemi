@model IEnumerable<OkulTakipSistemi.Models.Ogrenci>

@{
    ViewData["Title"] = "Sınıf Öğrencileri";

    var sinif =
        ViewBag.Sinif as OkulTakipSistemi.Models.Sinif;
}

<style>
    .ogretmen-page {
        min-height: calc(100vh - 100px);
        background: #f3f8f5;
        padding: 45px 0;
    }

    .page-header {
        background: #198754;
        color: white;
        border-radius: 18px;
        padding: 28px 32px;
        margin-bottom: 30px;
        box-shadow: 0 8px 20px rgba(25, 135, 84, 0.15);
    }

    .page-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
    }

    .page-header p {
        margin: 7px 0 0;
        opacity: 0.9;
    }

    .back-btn {
        background: white;
        color: #198754;
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
    }

    .back-btn:hover {
        background: #e9f5ef;
        color: #146c43;
    }

    .student-card {
        background: white;
        border: 1px solid #dceee4;
        border-radius: 16px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .student-card-header {
        padding: 22px 25px;
        border-bottom: 1px solid #dceee4;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .student-card-header h4 {
        color: #146c43;
        font-weight: 700;
        margin: 0;
    }

    .student-count {
        background: #198754;
        color: white;
        padding: 7px 13px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .table {
        margin-bottom: 0;
    }

    .table thead th {
        background: #e9f5ef;
        color: #146c43;
        font-weight: 700;
        border-bottom: 2px solid #cfe7da;
        padding: 15px;
    }

    .table tbody td {
        padding: 15px;
        vertical-align: middle;
        border-color: #edf4ef;
    }

    .table tbody tr:hover {
        background: #f6fbf8;
    }

    .student-number {
        color: #198754;
        font-weight: 600;
    }

    .student-name {
        color: #212529;
        font-weight: 600;
    }

    .empty-message {
        background: white;
        border: 1px solid #dceee4;
        border-radius: 14px;
        padding: 25px;
        color: #6c757d;
        text-align: center;
    }
</style>


<div class="ogretmen-page">

    <div class="container">

        <!-- BAŞLIK -->

        <div class="page-header">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h1>
                        @sinif?.Ad
                    </h1>

                    @if (sinif?.Okul != null)
                    {
                        <p>
                            Okul: @sinif.Okul.Ad
                        </p>
                    }

                </div>

                <a asp-controller="Ogretmen"
                   asp-action="Siniflarim"
                   class="back-btn">

                    ← Sınıflara Dön

                </a>

            </div>

        </div>


        <!-- ÖĞRENCİLER -->

        @if (Model != null && Model.Any())
        {
            <div class="student-card">

                <div class="student-card-header">

                    <h4>
                        Öğrenciler
                    </h4>

                    <span class="student-count">
                        @Model.Count() Öğrenci
                    </span>

                </div>


                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>

                            <tr>
                                <th>#</th>
                                <th>Öğrenci No</th>
                                <th>Ad Soyad</th>
                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int sira = 1;
                            }

                            @foreach (var ogrenci in Model)
                            {
                                <tr>

                                    <td>
                                        @sira
                                    </td>

                                    <td class="student-number">
                                        @ogrenci.OgrenciNo
                                    </td>

                                    <td class="student-name">
                                        @ogrenci.AdSoyad
                                    </td>

                                </tr>

                                sira++;
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }
        else
        {
            <div class="empty-message">

                Bu sınıfta kayıtlı öğrenci bulunmamaktadır.

            </div>
        }

    </div>

</div>
