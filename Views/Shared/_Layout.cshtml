<style id="logo-hareket-ortak">

.siniflarim-page .class-icon svg,
.yoklama-al-page .yoklama-al-icon svg,
.yoklama-history-page .history-class-icon svg {
    animation: logoHafifHareket 2.8s ease-in-out infinite !important;
    transform-origin: center center !important;
}

@@keyframes logoHafifHareket {

    0%, 100% {
        transform: translateY(0) rotate(0deg);
    }

    25% {
        transform: translateY(-3px) rotate(-2deg);
    }

    50% {
        transform: translateY(0) rotate(0deg);
    }

    75% {
        transform: translateY(-3px) rotate(2deg);
    }

}


/* ÖĞRETMEN KAYIT - LAYOUT ZEMİNİ */
body:has(.register-page) {
    margin: 0 !important;
    padding: 0 !important;
    background: #b87952 !important;
}

body:has(.register-page) .container-fluid {
    padding-left: 0 !important;
    padding-right: 0 !important;
    margin: 0 !important;
    max-width: none !important;
}

body:has(.register-page) main {
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
    max-width: none !important;
    background: #b87952 !important;
}


/* ÖĞRETMEN KAYIT - ALT ZEMİN */
html:has(.register-page),
body:has(.register-page),
body:has(.register-page) .container-fluid,
body:has(.register-page) main {
    background: #b87952 !important;
}



/* ÖĞRETMEN E-POSTA DOĞRULAMA - TAM EKRAN */
html:has(.teacher-verify-page),
body:has(.teacher-verify-page) {
    margin: 0 !important;
    padding: 0 !important;
    min-height: 100vh !important;
    background: #f7eee8 !important;
}

body:has(.teacher-verify-page) > header {
    display: none !important;
}

body:has(.teacher-verify-page) > .container-fluid {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
}

body:has(.teacher-verify-page) main {
    width: 100% !important;
    max-width: none !important;
    min-height: 100vh !important;
    margin: 0 !important;
    padding: 0 !important;
}

</style>








<style id="otomatik-bildirimler">
    .otomatik-bildirim {
        transition: opacity 0.4s ease, transform 0.4s ease !important;
    }

    .otomatik-bildirim.kaybol {
        opacity: 0 !important;
        transform: translateY(-8px) !important;
        pointer-events: none !important;
    }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const bildirimler = document.querySelectorAll(
        '.alert, [role="alert"], .school-fee-alert'
    );

    bildirimler.forEach(function (bildirim) {

        bildirim.classList.add("otomatik-bildirim");

        setTimeout(function () {

            bildirim.classList.add("kaybol");

            setTimeout(function () {
                if (bildirim && bildirim.parentNode) {
                    bildirim.remove();
                }
            }, 450);

        }, 3500);

    });

});
</script>

</body>
