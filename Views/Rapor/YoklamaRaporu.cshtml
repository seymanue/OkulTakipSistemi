@model IEnumerable<OkulTakipSistemi.Models.Yoklama>

@{
    ViewData["Title"] = "Yoklama Listesi";
}

<style>
    .attendance-report-page {
        max-width: 1180px;
        margin: 45px auto;
        padding: 0 25px 50px;
    }

    .report-header {
        margin-bottom: 30px;
    }

    .report-kicker {
        display: inline-block;
        padding: 7px 13px;
        background: #eaf7ef;
        color: #176b3a;
        border-radius: 18px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .4px;
        margin-bottom: 14px;
    }

    .report-header h1 {
        margin: 0 0 8px;
        color: #163c29;
        font-size: 36px;
        font-weight: 700;
    }

    .report-header p {
        margin: 0;
        color: #718078;
        font-size: 15px;
    }

    .report-line {
        height: 1px;
        background: #e5ece7;
        margin-top: 25px;
    }

    .report-card {
        background: #fff;
        border: 1px solid #e4ebe6;
        border-radius: 20px;
        box-shadow: 0 6px 22px rgba(25, 70, 45, .06);
        overflow: hidden;
    }

    .report-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 22px 25px;
        border-bottom: 1px solid #edf1ee;
    }

    .report-card-title h2 {
        margin: 0 0 5px;
        color: #294437;
        font-size: 20px;
        font-weight: 700;
    }

    .report-card-title p {
        margin: 0;
        color: #87928c;
        font-size: 13px;
    }

    .record-count {
        padding: 8px 13px;
        border-radius: 18px;
        background: #f1f7f3;
        color: #176b3a;
        font-size: 13px;
        font-weight: 600;
    }

    .attendance-table-wrapper {
        overflow-x: auto;
    }

    .attendance-table {
        width: 100%;
        border-collapse: collapse;
    }

    .attendance-table thead th {
        background: #f7faf8;
        color: #718078;
        font-size: 12px;
        font-weight: 700;
        text-align: left;
        padding: 15px 20px;
        border-bottom: 1px solid #e8eee9;
        white-space: nowrap;
    }

    .attendance-table tbody td {
        padding: 18px 20px;
        color: #405249;
        font-size: 14px;
        border-bottom: 1px solid #edf1ee;
        vertical-align: middle;
    }

    .attendance-table tbody tr:last-child td {
        border-bottom: none;
    }

    .attendance-table tbody tr {
        transition: background .18s ease;
    }

    .attendance-table tbody tr:hover {
        background: #f9fcfa;
    }

    .record-id {
        width: 55px;
        color: #9aa59f !important;
        font-size: 13px !important;
        font-weight: 600;
    }

    .date-cell {
        color: #294437 !important;
        font-weight: 600;
    }

    .class-name {
        color: #173c29;
        font-weight: 700;
    }

    .teacher-name {
        color: #66756d;
    }

    .detail-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 14px;
        border-radius: 10px;
        background: #eaf7ef;
        color: #176b3a !important;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: all .18s ease;
    }

    .detail-button:hover {
        background: #198754;
        color: white !important;
        transform: translateY(-1px);
    }

    .detail-arrow {
        font-size: 16px;
    }

    .empty-report {
        padding: 65px 25px;
        text-align: center;
    }

    .empty-report-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 16px;
        border-radius: 17px;
        background: #eaf7ef;
        color: #198754;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        font-weight: 700;
    }

    .empty-report h3 {
        margin: 0 0 7px;
        color: #294437;
        font-size: 18px;
    }

    .empty-report p {
        margin: 0;
        color: #87928c;
        font-size: 14px;
    }

    @@media (max-width: 700px) {
        .attendance-report-page {
            margin-top: 25px;
            padding: 0 15px 35px;
        }

        .report-header h1 {
            font-size: 29px;
        }

        .report-card-top {
            align-items: flex-start;
            gap: 15px;
            flex-direction: column;
        }

        .attendance-table thead th,
        .attendance-table tbody td {
            padding: 13px 14px;
        }
    }
</style>

<div class="attendance-report-page">

    <div class="report-header">

        <div class="report-kicker">
            YOKLAMA İŞLEMLERİ
        </div>

        <h1>Yoklama Listesi</h1>

        <p>
            Sınıflara ait alınmış yoklama kayıtlarını görüntüleyebilirsiniz.
        </p>

        <div class="report-line"></div>

    </div>


    <div class="report-card">

        <div class="report-card-top">

            <div class="report-card-title">
                <h2>Yoklama Kayıtları</h2>
                <p>Alınan yoklamaların tarih ve sınıf bilgileri</p>
            </div>

            <div class="record-count">
                @(Model?.Count() ?? 0) Kayıt
            </div>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="attendance-table-wrapper">

                <table class="attendance-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>TARİH</th>
                            <th>SINIF</th>
                            <th>ÖĞRETMEN</th>
                            <th>İŞLEM</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var yoklama in Model)
                        {
                            <tr>

                                <td class="record-id">
                                    #@yoklama.Id
                                </td>

                                <td class="date-cell">
                                    @yoklama.Tarih.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    <span class="class-name">
                                        @yoklama.Sinif?.Ad
                                    </span>
                                </td>

                                <td>
                                    <span class="teacher-name">
                                        @yoklama.Ogretmen?.AdSoyad
                                    </span>
                                </td>

                                <td>

                                    <a asp-controller="Rapor"
                                       asp-action="YoklamaDetay"
                                       asp-route-id="@yoklama.Id"
                                       class="detail-button">

                                        <span>Detay</span>
                                        <span class="detail-arrow">→</span>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-report">

                <div class="empty-report-icon">
                    ✓
                </div>

                <h3>Henüz yoklama kaydı bulunmuyor</h3>

                <p>
                    Alınan yoklamalar burada listelenecektir.
                </p>

            </div>
        }

    </div>

</div>
