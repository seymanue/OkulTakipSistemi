@model IEnumerable<OkulTakipSistemi.Models.Kullanici>

@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Kullanıcılar</h2>

            <p class="text-muted">
                Sistem kullanıcılarını görüntüleyin.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Kullanıcı Ekle
        </a>

    </div>

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Hata"]
        </div>
    }

    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success">
            @TempData["Basari"]
        </div>
    }

    <table class="table table-bordered table-hover">

        <thead>
            <tr>
                <th>ID</th>
                <th>Ad Soyad</th>
                <th>Kullanıcı Adı</th>
                <th>E-posta</th>
                <th>Rol</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>

            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="6"
                        class="text-center text-muted">
                        Henüz kullanıcı bulunmamaktadır.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var kullanici in Model)
                {
                    <tr>

                        <td>
                            @kullanici.Id
                        </td>

                        <td>
                            @kullanici.AdSoyad
                        </td>

                        <td>
                            @kullanici.KullaniciAdi
                        </td>

                        <td>
                            @kullanici.Email
                        </td>

                        <td>
                            @(kullanici.Rol?.Ad ?? "Belirtilmemiş")
                        </td>

                        <td>

                            @if (kullanici.KullaniciAdi != "admin")
                            {
                                <form asp-action="Delete"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@kullanici.Id" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        🗑️ Sil
                                    </button>

                                </form>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Ana Admin
                                </span>
                            }

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>
