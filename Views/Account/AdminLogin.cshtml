@{
    ViewData["Title"] = "Yönetici Girişi";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        margin: 0;
        padding: 0;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
        background: #071522;
        overflow: hidden;
    }

    body:has(.admin-login-page) {
        margin: 0;
        padding: 0;
        overflow: hidden;
    }

    .admin-login-page {
        position: relative;

        width: 100vw;
        height: 100vh;
        min-height: 100vh;

        margin: 0;
        padding: 0;

        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: flex-end;

        background: #071522;
        isolation: isolate;
    }

    .admin-login-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
    }

    .login-wrapper {
        position: relative;
        width: 100%;
        height: 100vh;
        z-index: 2;
    }

    /* SAĞ FORM */

    .login-form-side {
        position: absolute;
        top: 50%;
        right: 6%;
        transform: translateY(-50%);

        width: min(430px, 90vw);
        padding: 0;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .admin-card {
        width: 100%;
        max-width: 390px;

        padding: 38px 40px;

        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: 26px;

        box-shadow:
            0 20px 55px rgba(0, 0, 0, 0.18),
            inset 0 1px 0 rgba(255, 255, 255, 0.25);
    }

    .form-header {
        margin-bottom: 32px;
    }

    .shield-icon {
        width: 62px;
        height: 62px;
        margin-bottom: 22px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 18px;
        background: linear-gradient(145deg, #2488e8, #1267bb);
        color: white;
        font-size: 26px;

        box-shadow:
            0 12px 25px rgba(24, 117, 198, 0.25);
    }

    .form-header h2 {
        margin: 0 0 8px;
        color: #152536;
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -0.7px;
    }

    .form-header p {
        margin: 0;
        color: #82909d;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 19px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #344454;
        font-size: 13px;
        font-weight: 700;
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #91a0ad;
        font-size: 15px;
        pointer-events: none;
    }

    .form-input {
        width: 100%;
        height: 52px;
        padding: 0 16px 0 45px;

        border: 1px solid #dfe6ec;
        border-radius: 13px;

        background: #f8fafc;
        color: #1d2d3d;

        font-family: inherit;
        font-size: 14px;

        outline: none;
        transition: all 0.2s ease;
    }

    .form-input::placeholder {
        color: #aab5bf;
    }

    .form-input:focus {
        border-color: #152536;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(38, 137, 232, 0.10);
    }

    .password-button {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);

        border: 0;
        background: transparent;
        color: #94a0aa;

        cursor: pointer;
        padding: 5px;
        font-size: 15px;
    }

    .password-button:hover {
        color: #152536;
    }

    .remember-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 4px 0 23px;
    }

    .remember-label {
        display: flex;
        align-items: center;
        gap: 8px;

        color: #6d7a86;
        font-size: 13px;
        cursor: pointer;
    }

    .remember-label input {
        width: 16px;
        height: 16px;
        accent-color: #152536;
        cursor: pointer;
    }

    .forgot-link {
        color: #152536;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

    .forgot-link:hover {
        text-decoration: underline;
    }

    .login-button {
        width: 100%;
        height: 53px;

        border: 0;
        border-radius: 13px;

        background: linear-gradient(135deg, #248be9, #1469ba);
        color: #ffffff;

        font-family: inherit;
        font-size: 14px;
        font-weight: 700;

        cursor: pointer;

        box-shadow: 0 12px 25px rgba(29, 119, 201, 0.23);
        transition: all 0.2s ease;
    }

    .login-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 30px rgba(29, 119, 201, 0.30);
    }

    .login-button:active {
        transform: translateY(0);
    }

    .alert {
        padding: 12px 14px;
        margin-bottom: 18px;
        border-radius: 11px;
        font-size: 13px;
    }

    .alert-danger {
        color: #a32929;
        background: #fff1f1;
        border: 1px solid #ffd6d6;
    }

    .alert-success {
        color: #187344;
        background: #effcf4;
        border: 1px solid #ccefd9;
    }

    .account-links {
        margin-top: 26px;
        padding-top: 21px;
        border-top: 1px solid #edf0f3;

        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 11px;
    }

    .account-links a {
        color: #6d7b88;
        text-decoration: none;
        font-size: 13px;
        transition: color 0.2s ease;
    }

    .account-links a:hover {
        color: #152536;
    }

    .account-links a:first-child {
        color: #152536;
        font-weight: 700;
    }

    /* MOBİL */

    @@media (max-width: 850px) {

    @@media (max-width: 500px) {
        .admin-login-page {
            padding: 15px;
        }

    

/* =========================================================
   YÖNETİCİ GİRİŞİ - ÖĞRETMEN GİRİŞİYLE AYNI ÖLÇÜLER
   ========================================================= */

.admin-card {
    width: 100%;
    max-width: 520px;
    padding: 38px 40px;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 22px;
    box-shadow:
        0 20px 55px rgba(0, 0, 0, 0.20),
        inset 0 1px 0 rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
}

.login-form-side {
    position: absolute;
    top: 50%;
    right: 8%;
    transform: translateY(-50%);
    width: 100%;
    max-width: 520px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.admin-card .form-header {
    text-align: center;
    margin-bottom: 28px;
}

.admin-card .shield-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #fff;
    font-size: 27px;
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.28);
}

.admin-card .form-header h2 {
    margin: 0 0 10px;
    font-size: 30px;
    font-weight: 700;
    color: #102a43;
    line-height: 1.2;
}

.admin-card .form-header p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #64748b;
}

.admin-card .form-group {
    margin-bottom: 18px;
}

.admin-card label {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 600;
    color: #334155;
}

.admin-card input[type="text"],
.admin-card input[type="password"],
.admin-card input[type="email"] {
    width: 100%;
    height: 52px;
    padding: 0 16px;
    border: 1px solid rgba(100, 116, 139, 0.28);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.78);
    color: #1e293b;
    font-size: 15px;
    outline: none;
    transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
}

.admin-card input[type="text"]:focus,
.admin-card input[type="password"]:focus,
.admin-card input[type="email"]:focus {
    border-color: #152536;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

.admin-card button[type="submit"] {
    width: 100%;
    height: 52px;
    margin-top: 8px;
    border: none;
    border-radius: 13px;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(37, 99, 235, 0.25);
    transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
}

.admin-card button[type="submit"]:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px rgba(37, 99, 235, 0.32);
    filter: brightness(1.04);
}

.admin-card button[type="submit"]:active {
    transform: translateY(0);
}

.admin-card a {
    color: #152536;
    text-decoration: none;
}

.admin-card a:hover {
    text-decoration: underline;
}

.admin-card .alert {
    border-radius: 12px;
    font-size: 14px;
}

@@media (max-width: 850px) {
    .login-form-side {
        right: 50%;
        transform: translate(50%, -50%);
        width: min(520px, 90vw);
    }

    .admin-card {
        max-width: 520px;
    }
}

@@media (max-width: 500px) {
    .login-form-side {
        width: calc(100vw - 30px);
    }

    .admin-card {
        padding: 30px 24px;
        border-radius: 20px;
    }

    .admin-card .form-header h2 {
        font-size: 26px;
    }
}

</style>
<style>
/* Yönetici logosu */
.admin-crown-logo {
    width: 66px;
    height: 66px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, #4aa8e8 0%, #267bc4 55%, #195a9b 100%);
    border: 1px solid rgba(255, 255, 255, 0.38);
    box-shadow:
        0 8px 20px rgba(9, 30, 55, 0.35),
        inset 0 1px 1px rgba(255, 255, 255, 0.18);
    position: relative;
    overflow: hidden;
}

.admin-crown-logo::before {
    content: "";
    position: absolute;
    top: -25px;
    left: -20px;
    width: 55px;
    height: 55px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    filter: blur(8px);
}

.admin-crown-logo i {
    position: relative;
    z-index: 2;
    font-size: 29px;
    color: #f4fbff;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.25));
}
</style>


<div class="admin-login-page">

    <video class="admin-login-video"
           autoplay
           muted
           loop
           playsinline>
        <source src="~/videos/admin-login.mp4" type="video/mp4" />
    </video>


    <div class="login-wrapper">

        <!-- SAĞ TARAF -->
        <div class="login-form-side">

            <div class="admin-card">

                <div class="form-header admin-form-header">

                    <div class="shield-icon admin-crown-logo">
                        <i class="fa-solid fa-crown"></i>
                    </div>

                    <h2 class="admin-system-title">Okul Takip Sistemi</h2>

                    <div class="admin-login-title">
                        <span></span>
                        <h3>Yönetici Girişi</h3>
                        <span></span>
                    </div>

                    <p>
                        Yönetim paneline devam etmek için giriş yapın.
                    </p>

                </div>

                @if (ViewBag.Hata != null)
                {
                    <div class="alert alert-danger">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        @ViewBag.Hata
                    </div>
                }

                @if (TempData["Basari"] != null)
                {
                    <div class="alert alert-success">
                        <i class="fa-solid fa-circle-check"></i>
                        @TempData["Basari"]
                    </div>
                }

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    <input type="hidden"
                           name="GirisTuru"
                           value="Admin" />

                    <div class="form-group">

                        <label for="KullaniciAdi">
                            Kullanıcı Adı
                        </label>

                        <div class="input-wrapper">

                            <i class="fa-solid fa-user input-icon"></i>

                            <input type="text"
                                   id="KullaniciAdi"
                                   name="KullaniciAdi"
                                   class="form-input"
                                   placeholder="Kullanıcı Adı"
                                   autocomplete="username"
                                   required />

                        </div>

                    </div>

                    <div class="form-group">

                        <label for="adminPassword">
                            Şifre
                        </label>

                        <div class="input-wrapper">

                            <i class="fa-solid fa-lock input-icon"></i>

                            <input type="password"
                                   id="adminPassword"
                                   name="Sifre"
                                   class="form-input"
                                   placeholder="Şifre"
                                   autocomplete="current-password"
                                   required
                                   style="padding-right: 48px;" />

                            <button type="button"
                                    class="password-button"
                                    onclick="togglePassword()"
                                    aria-label="Şifreyi göster/gizle">

                                <i id="passwordEye"
                                   class="fa-solid fa-eye"></i>

                            </button>

                        </div>

                    </div>

                    <div class="remember-row">

                        <label class="remember-label">

                            <input type="checkbox"
                                   name="BeniHatirla"
                                   value="true" />

                            <span>Beni Hatırla</span>

                        </label>

                        <a asp-controller="Account"
                           asp-action="SifremiUnuttum"
                           asp-route-GirisTuru="Admin"
                           class="forgot-link">
                            Şifremi Unuttum?
                        </a>

                    </div>

                    <button type="submit"
                            class="login-button">

                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        &nbsp;
                        Giriş Yap

                    </button>

                </form>

                <div class="account-links">

                    <a asp-controller="Account"
                       asp-action="AdminRegister">
                        Yönetici hesabı oluştur
                    </a>

                    <a asp-controller="Account"
                       asp-action="Login">
                        <i class="fa-solid fa-arrow-left"></i>
                        &nbsp;Öğretmen girişine dön
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
    function togglePassword() {

        const password = document.getElementById("adminPassword");
        const eye = document.getElementById("passwordEye");

        if (password.type === "password") {

            password.type = "text";

            eye.classList.remove("fa-eye");
            eye.classList.add("fa-eye-slash");

        } else {

            password.type = "password";

            eye.classList.remove("fa-eye-slash");
            eye.classList.add("fa-eye");

        }
    }
</script>

