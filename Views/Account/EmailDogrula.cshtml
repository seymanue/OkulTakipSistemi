@{
    ViewData["Title"] = "E-posta Doğrulama";
}

<div class="teacher-verify-page">

    <div class="verify-star verify-star-1" aria-hidden="true">✦</div>
    <div class="verify-star verify-star-2" aria-hidden="true">✧</div>
    <div class="verify-star verify-star-3" aria-hidden="true">✦</div>
    <div class="verify-star verify-star-4" aria-hidden="true">✧</div>
    <div class="verify-star verify-star-5" aria-hidden="true">✦</div>
    <div class="verify-star verify-star-6" aria-hidden="true">✧</div>
    <div class="verify-star verify-star-7" aria-hidden="true">✦</div>
    <div class="verify-star verify-star-8" aria-hidden="true">✧</div>

    <div class="teacher-verify-card">

        <!-- İKON -->
        <div class="verify-icon">
            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.7"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <rect x="3.5" y="5" width="17" height="14" rx="2"></rect>
                <path d="M4.5 7l7.5 6 7.5-6"></path>
            </svg>
        </div>

        <!-- BAŞLIK -->
        <h1 class="verify-title">
            E-posta Doğrulama
        </h1>

        <div class="verify-subtitle-wrapper">
            <div class="verify-line"></div>

            <div class="verify-subtitle">
                Hesabınızı doğrulayın
            </div>

            <div class="verify-line"></div>
        </div>

        <p class="verify-description">
            E-posta adresinize gönderilen 6 haneli
            doğrulama kodunu aşağıdaki alana giriniz.
        </p>

        @if (ViewBag.Hata != null)
        {
            <div class="verify-alert">
                <span class="alert-icon">!</span>
                <span>@ViewBag.Hata</span>
            </div>
        }

        <!-- FORM -->
        <form asp-controller="Account"
              asp-action="EmailDogrula"
              method="post"
              class="verify-form">

            @Html.AntiForgeryToken()

            <div class="verify-input-group">

                <span class="verify-input-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                        <path d="M8 9h8"></path>
                        <path d="M8 12h8"></path>
                        <path d="M8 15h5"></path>
                    </svg>
                </span>

                <input type="text"
                       name="Kod"
                       class="verify-input"
                       maxlength="6"
                       minlength="6"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       placeholder="6 haneli doğrulama kodu"
                       required />

            </div>

            <button type="submit"
                    class="verify-button">

                <span class="verify-button-icon">
                    ✓
                </span>

                <span>
                    E-postayı Doğrula
                </span>

            </button>

        </form>

        <!-- BİLGİ -->
        <div class="verify-info">

            <div class="verify-info-icon">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <circle cx="12" cy="12" r="8.5"></circle>
                    <path d="M12 11v5"></path>
                    <path d="M12 8h.01"></path>
                </svg>
            </div>

            <div>
                Kod size ulaşmadıysa spam veya gereksiz
                e-posta klasörünüzü de kontrol ediniz.
            </div>

        </div>

    </div>

</div>


<style>

    /* =========================================================
       ÖĞRETMEN E-POSTA DOĞRULAMA SAYFASI
       ========================================================= */

    .teacher-verify-page {
        min-height: 100vh;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 50px 20px;

        background:
            radial-gradient(
                circle at 15% 15%,
                rgba(226, 164, 104, 0.18),
                transparent 32%
            ),
            radial-gradient(
                circle at 85% 85%,
                rgba(91, 56, 43, 0.20),
                transparent 35%
            ),
            linear-gradient(
                135deg,
                #f7eee8 0%,
                #eee0d6 48%,
                #e5d2c5 100%
            );
    }


    /* KART */

    .teacher-verify-card {
        width: 100%;
        max-width: 520px;

        padding: 42px 42px 36px;

        background: rgba(255, 252, 249, 0.97);

        border: 1px solid rgba(126, 82, 65, 0.16);

        border-radius: 24px;

        box-shadow:
            0 24px 60px rgba(70, 42, 31, 0.16),
            0 6px 18px rgba(70, 42, 31, 0.08);

        text-align: center;

        animation: verifyCardAppear 0.45s ease;
    }


    @@keyframes verifyCardAppear {

        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

    }


    /* İKON */

    .verify-icon {

        width: 72px;
        height: 72px;

        margin: 0 auto 20px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 20px;

        background:
            linear-gradient(
                135deg,
                #a96f50,
                #765044
            );

        color: #fffaf6;

        box-shadow:
            0 12px 26px rgba(118, 80, 68, 0.25);
    }


    .verify-icon svg {

        width: 36px;
        height: 36px;

    }


    /* BAŞLIK */

    .verify-title {

        margin: 0;

        color: #4f3328;

        font-size: 29px;
        font-weight: 700;

        letter-spacing: -0.5px;
    }


    .verify-subtitle-wrapper {

        display: flex;
        align-items: center;
        gap: 12px;

        margin: 15px 0 18px;
    }


    .verify-line {

        flex: 1;
        height: 1px;

        background:
            linear-gradient(
                90deg,
                transparent,
                rgba(139, 90, 69, 0.45)
            );
    }


    .verify-line:last-child {

        background:
            linear-gradient(
                90deg,
                rgba(139, 90, 69, 0.45),
                transparent
            );
    }


    .verify-subtitle {

        color: #8b5a45;

        font-size: 13px;
        font-weight: 600;

        white-space: nowrap;
    }


    /* AÇIKLAMA */

    .verify-description {

        max-width: 390px;

        margin: 0 auto 28px;

        color: #725d54;

        font-size: 14px;
        line-height: 1.7;
    }


    /* HATA */

    .verify-alert {

        display: flex;
        align-items: center;
        gap: 10px;

        margin-bottom: 20px;
        padding: 12px 14px;

        border-radius: 12px;

        background: #f9e7e3;

        border: 1px solid #e4b9b0;

        color: #87483e;

        font-size: 13px;

        text-align: left;
    }


    .alert-icon {

        width: 22px;
        height: 22px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: #a95f52;

        color: white;

        font-weight: 700;
    }


    /* INPUT */

    .verify-input-group {

        position: relative;

        width: 100%;

        margin-bottom: 18px;
    }


    .verify-input-icon {

        position: absolute;

        left: 17px;
        top: 50%;

        transform: translateY(-50%);

        width: 21px;
        height: 21px;

        color: #8b5a45;

        pointer-events: none;

        z-index: 2;
    }


    .verify-input-icon svg {

        width: 21px;
        height: 21px;

    }


    .verify-input {

        width: 100%;

        box-sizing: border-box;

        height: 56px;

        padding: 0 18px 0 52px;

        border: 1px solid #d9c3b6;

        border-radius: 13px;

        background: #fff;

        color: #4f3328;

        font-size: 18px;
        font-weight: 600;

        letter-spacing: 5px;

        outline: none;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            transform 0.2s ease;

        text-align: left;
    }


    .verify-input::placeholder {

        color: #ad9990;

        font-size: 13px;
        font-weight: 400;

        letter-spacing: 0;
    }


    .verify-input:focus {

        border-color: #9a654d;

        box-shadow:
            0 0 0 4px rgba(154, 101, 77, 0.10);

        transform: translateY(-1px);
    }


    /* BUTON */

    .verify-button {

        width: 100%;
        height: 54px;

        border: none;
        border-radius: 13px;

        display: flex;
        align-items: center;
        justify-content: center;

        gap: 9px;

        background:
            linear-gradient(
                135deg,
                #98624b,
                #70483d
            );

        color: #fffaf6;

        font-size: 15px;
        font-weight: 600;

        cursor: pointer;

        box-shadow:
            0 9px 20px rgba(112, 72, 61, 0.22);

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            filter 0.2s ease;
    }


    .verify-button:hover {

        transform: translateY(-2px);

        box-shadow:
            0 13px 25px rgba(112, 72, 61, 0.28);

        filter: brightness(1.04);
    }


    .verify-button:active {

        transform: translateY(0);

    }


    .verify-button-icon {

        font-size: 17px;

    }


    /* BİLGİ KUTUSU */

    .verify-info {

        display: flex;
        align-items: flex-start;

        gap: 11px;

        margin-top: 24px;
        padding: 14px 15px;

        border-radius: 13px;

        background: #f7eee8;

        border: 1px solid #ead8cd;

        color: #765044;

        font-size: 12px;

        line-height: 1.6;

        text-align: left;
    }


    .verify-info-icon {

        width: 22px;
        height: 22px;

        flex-shrink: 0;

        color: #8b5a45;
    }


    .verify-info-icon svg {

        width: 22px;
        height: 22px;

    }


    /* MOBİL */

    @@media (max-width: 600px) {

        .teacher-verify-page {

            padding: 25px 15px;

        }

        .teacher-verify-card {

            padding: 32px 24px 28px;

            border-radius: 20px;

        }

        .verify-title {

            font-size: 25px;

        }

    }



/* =========================================================
