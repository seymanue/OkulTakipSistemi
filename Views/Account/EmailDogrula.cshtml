@{
    ViewData["Title"] = "Yönetici E-posta Doğrulama";
}

<div class="container mt-5" style="max-width: 500px;">

    <h2>Yönetici E-posta Doğrulama</h2>

    <p class="text-muted">
        E-posta adresinize gönderilen 6 haneli kodu giriniz.
    </p>

    @if (ViewBag.Hata != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Hata
        </div>
    }

    <form asp-controller="Account"
          asp-action="AdminEmailDogrula"
          method="post">

        <div class="mb-3">
            <label class="form-label">
                Doğrulama Kodu
            </label>

            <input type="text"
                   name="Kod"
                   class="form-control"
                   maxlength="6"
                   required />
        </div>

        <button type="submit"
                class="btn btn-primary w-100">
            Doğrula
        </button>

    </form>

</div>