    .verify-star-3 { right: 4% !important; }
    .verify-star-4 { right: 7% !important; }
    .verify-star-5 { left: 4% !important; }
    .verify-star-6 { left: 7% !important; }
    .verify-star-7 { right: 4% !important; }
    .verify-star-8 { right: 7% !important; }
}

@@media (max-width: 600px) {
    .teacher-verify-page {
        padding: 18px 14px !important;
    }

    .teacher-verify-card {
