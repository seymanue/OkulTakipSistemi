@model OkulTakipSistemi.Models.OgretmenBilgileriViewModel

@{
    ViewData["Title"] = "Öğretmen Bilgileri";
}

<div class="teacher-profile-page">

    <div class="profile-header">

        <div>
            <div class="profile-kicker">
                ÖĞRETMEN HESABI
            </div>

            <h1>Öğretmen Bilgileri</h1>

            <p>
                Hesap bilgilerinizi buradan görüntüleyebilir ve güncelleyebilirsiniz.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="OgretmenPanel"
           class="profile-back-button">
            ← Panele Dön
        </a>

    </div>


    <div class="profile-layout">

        <!-- SOL PROFİL ALANI -->

        <div class="profile-summary">

            <div class="profile-avatar">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M4 21c0-4.2 3.6-7 8-7s8 2.8 8 7"/>
                </svg>
            </div>

            <h2>@Model.AdSoyad</h2>

            <span class="profile-teacher-badge">
                ÖĞRETMEN
            </span>

            <div class="profile-summary-line"></div>

            <p>
                Öğretmen hesabınızın kişisel bilgilerini
                bu alandan yönetebilirsiniz.
            </p>

        </div>


        <!-- SAĞ BİLGİ FORMU -->

        <div class="profile-form-card">

            <div class="profile-form-header">

                <div class="form-header-icon">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="8" r="4"/>
                        <path d="M4 21c0-4.2 3.6-7 8-7s8 2.8 8 7"/>
                    </svg>
                </div>

                <div>
                    <h2>Hesap Bilgileri</h2>
                    <p>Bilgilerinizi düzenleyebilirsiniz.</p>
                </div>

            </div>


            @if (TempData["Basari"] != null)
            {
                <div class="profile-success">
                    <span>✓</span>
                    @TempData["Basari"]
                </div>
            }


            <form asp-controller="Account"
                  asp-action="OgretmenBilgileri"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="profile-validation">
                </div>


                <!-- AD SOYAD -->

                <div class="profile-field">

                    <label asp-for="AdSoyad">
                        Ad Soyad
                    </label>

                    <div class="profile-input-wrapper">

                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="8" r="4"/>
                            <path d="M4 21c0-4.2 3.6-7 8-7s8 2.8 8 7"/>
                        </svg>

                        <input asp-for="AdSoyad"
                               class="profile-input" />

                    </div>

                    <span asp-validation-for="AdSoyad"
                          class="profile-error">
                    </span>

                </div>


                <!-- KULLANICI ADI -->

                <div class="profile-field">

                    <label asp-for="KullaniciAdi">
                        Kullanıcı Adı
                    </label>

                    <div class="profile-input-wrapper">

                        <svg viewBox="0 0 24 24">
                            <path d="M20 21a8 8 0 0 0-16 0"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>

                        <input asp-for="KullaniciAdi"
                               class="profile-input" />

                    </div>

                    <span asp-validation-for="KullaniciAdi"
                          class="profile-error">
                    </span>

                </div>


                <!-- E-POSTA -->

                <div class="profile-field">

                    <label asp-for="Email">
                        E-posta
                    </label>

                    <div class="profile-input-wrapper">

                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="5" width="18" height="14" rx="2"/>
                            <path d="m3 7 9 6 9-6"/>
                        </svg>

                        <input asp-for="Email"
                               type="email"
                               class="profile-input" />

                    </div>

                    <span asp-validation-for="Email"
                          class="profile-error">
                    </span>

                </div>


                <!-- ROL -->

                <div class="profile-field">

                    <label>
                        Rol
                    </label>

                    <div class="role-display">

                        <div class="role-icon">
                            ✓
                        </div>

                        <div>
                            <strong>Öğretmen</strong>
                            <span>Öğretmen hesabı</span>
                        </div>

                    </div>

                </div>


                <!-- BUTONLAR -->

                <div class="profile-actions">

                    <button type="submit"
                            class="save-profile-button">

                        <svg viewBox="0 0 24 24">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                            <polyline points="17 21 17 13 7 13 7 21"/>
                            <polyline points="7 3 7 8 15 8"/>
                        </svg>

                        Değişiklikleri Kaydet

                    </button>

                    <a asp-controller="Home"
                       asp-action="OgretmenPanel"
                       class="cancel-profile-button">

                        Vazgeç

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
