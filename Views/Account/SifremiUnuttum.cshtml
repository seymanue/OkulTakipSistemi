@{
    ViewData["Title"] = "Şifremi Unuttum";

    string girisTuru = ViewBag.GirisTuru ?? "Ogretmen";
    bool adminMi = girisTuru == "Admin";
}

<style>
html, body {
    margin: 0;
    padding: 0;
}

body:has(.forgot-page) {
    background: #493735 !important;
}

body:has(.forgot-page) header,
body:has(.forgot-page) nav {
    background: rgba(67, 43, 35, 0.96) !important;
    border-color: rgba(255,255,255,0.08) !important;
}

.forgot-page {
    width: 100vw;
    min-height: calc(100vh - 64px);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px 20px;
    overflow: hidden;
    background:
        radial-gradient(
            ellipse at 10% 18%,
            rgba(226, 164, 104, 0.34),
            transparent 38%
        ),
        radial-gradient(
            ellipse at 88% 78%,
            rgba(73, 43, 35, 0.48),
            transparent 45%
        ),
        linear-gradient(
            120deg,
            #b87952 0%,
            #956049 42%,
            #67463d 72%,
            #493735 100%
        );
}

.forgot-card {
    width: min(460px, 100%);
    max-height: calc(100vh - 110px);
    box-sizing: border-box;
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,0.22);
    background: rgba(67, 43, 35, 0.58);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow:
        0 24px 60px rgba(35, 22, 18, 0.38),
        inset 0 1px 0 rgba(255,255,255,0.14);
}

.forgot-header {
    padding: 25px 30px 20px;
    text-align: center;
    color: #fff8f2;
    background:
        linear-gradient(
            145deg,
            rgba(126, 78, 55, 0.82),
            rgba(91, 57, 45, 0.78)
        );
    border-bottom: 1px solid rgba(255,255,255,0.12);
}

.forgot-icon {
    width: 68px;
    height: 68px;
    margin: 0 auto 12px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #e6b47c;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.16);
    box-shadow:
        0 8px 20px rgba(45, 27, 21, 0.22),
        inset 0 1px 0 rgba(255,255,255,0.12);
}

.forgot-icon svg {
    width: 42px;
    height: 42px;
}

.forgot-header h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    color: #fff8f2;
}

.forgot-header p {
    margin: 7px 0 0;
    color: rgba(255,248,242,0.82);
    font-size: 13px;
}

.forgot-body {
    padding: 25px 30px 26px;
    background: rgba(50, 34, 29, 0.34);
}

.field {
    margin-bottom: 18px;
}

.field label {
    display: block;
    margin-bottom: 7px;
    font-weight: 600;
    color: #f5dfcf;
}

.custom-input {
    width: 100%;
    height: 48px;
    box-sizing: border-box;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 12px;
    padding: 0 15px;
    font-size: 15px;
    color: #fff8f2;
    outline: none;
    background: rgba(255,255,255,0.10);
    transition: 0.2s;
}

.custom-input::placeholder {
    color: rgba(255,242,232,0.54);
}

.custom-input:focus {
    border-color: rgba(226,164,104,0.75);
    box-shadow: 0 0 0 3px rgba(226,164,104,0.14);
    background: rgba(255,255,255,0.13);
}

.change-button {
    width: 100%;
    height: 48px;
    border: none;
    border-radius: 12px;
    background: linear-gradient(135deg, #b87952, #8f5a43);
    color: #fffaf6;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(57, 34, 27, 0.28);
    transition: 0.2s;
}

.change-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(57, 34, 27, 0.36);
}

.back-link {
    display: block;
    margin-top: 18px;
    text-align: center;
    color: #e7b47f;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
}

.back-link:hover {
    color: #f2c99f;
    text-decoration: underline;
}

.alert {
    padding: 11px 13px;
    border-radius: 11px;
    margin-bottom: 17px;
    font-size: 13px;
}

.alert-danger {
    background: rgba(127, 42, 32, 0.35);
    color: #ffd5cc;
    border: 1px solid rgba(255,150,130,0.25);
}

.alert-success {
    background: rgba(80, 92, 48, 0.30);
    color: #e2edc5;
    border: 1px solid rgba(190,210,130,0.25);
}

@@media (max-width: 576px) {
    .forgot-page {
        min-height: calc(100vh - 58px);
        padding: 18px 14px;
    }

    .forgot-card {
        max-height: calc(100vh - 80px);
        border-radius: 20px;
    }

    .forgot-header {
        padding: 21px 20px 17px;
    }

    .forgot-body {
        padding: 21px 20px 22px;
    }
}
</style>

<div class="forgot-page">

    <div class="forgot-card">

        <div class="forgot-header">

            <div class="forgot-icon">
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect x="25" y="29" width="26" height="22" rx="5"
                          stroke="currentColor" stroke-width="3"/>
                    <path d="M31 29V22C31 15.9 35.9 11 42 11C48.1 11 53 15.9 53 22V29"
                          stroke="currentColor" stroke-width="3"
                          stroke-linecap="round"/>
                    <circle cx="38" cy="40" r="3"
                            fill="currentColor"/>
                    <path d="M38 43V47"
                          stroke="currentColor" stroke-width="3"
                          stroke-linecap="round"/>
                    <path d="M12 42C12 35.9 16.9 31 23 31"
                          stroke="currentColor" stroke-width="3"
                          stroke-linecap="round"/>
                    <circle cx="14" cy="43" r="5"
                            stroke="currentColor" stroke-width="3"/>
                </svg>
            </div>

            <h2>Şifremi Unuttum</h2>

            <p>
                Email adresinize doğrulama kodu göndereceğiz.
            </p>

        </div>

        <div class="forgot-body">

            @if (ViewBag.Hata != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Hata
                </div>
            }

            @if (TempData["Basari"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Basari"]
                </div>
            }

            <form asp-controller="Account"
                  asp-action="SifremiUnuttum"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="GirisTuru"
                       value="@girisTuru" />

                <div class="field">

                    <label for="KullaniciAdi">
                        Kullanıcı Adı
                    </label>

                    <input type="text"
                           id="KullaniciAdi"
                           name="KullaniciAdi"
                           class="custom-input"
                           placeholder="Kullanıcı adınızı giriniz"
                           autocomplete="username"
                           required />

                </div>

                <button type="submit"
                        class="change-button">
                    Email Kodunu Gönder
                </button>

            </form>

            @if (adminMi)
            {
                <a asp-controller="Account"
                   asp-action="AdminLogin"
                   class="back-link">
                    ← Yönetici girişine dön
                </a>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="back-link">
                    ← Öğretmen girişine dön
                </a>
            }

        </div>

    </div>

</div>
<style>
/* Şifremi Unuttum - dekoratif arka plan deseni */
.forgot-page {
    position: relative;
    isolation: isolate;
}

.forgot-page::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.20;
    pointer-events: none;

    background-image:
        radial-gradient(circle at 12% 20%, rgba(255,235,215,0.55) 0 2px, transparent 3px),
        radial-gradient(circle at 82% 16%, rgba(255,235,215,0.45) 0 2px, transparent 3px),
        radial-gradient(circle at 25% 78%, rgba(255,235,215,0.40) 0 2px, transparent 3px),
        radial-gradient(circle at 75% 82%, rgba(255,235,215,0.40) 0 2px, transparent 3px),
        linear-gradient(135deg, transparent 0 48%, rgba(255,255,255,0.08) 49% 50%, transparent 51%),
        linear-gradient(45deg, transparent 0 48%, rgba(255,255,255,0.06) 49% 50%, transparent 51%);

    background-size:
        180px 180px,
        220px 220px,
        200px 200px,
        240px 240px,
        90px 90px,
        90px 90px;

    background-position:
        0 0,
        70px 30px,
        30px 100px,
        120px 80px,
        0 0,
        0 0;
}

/* Hafif kitap/okul havası veren dekoratif çizgiler */
.forgot-page::after {
    content: "✦   □   ✎       ✦       ◇   ✦       □   ✎       ✦";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 42px;
    letter-spacing: 34px;
    line-height: 150px;
    color: rgba(255, 226, 201, 0.13);
    transform: rotate(-8deg) scale(1.15);
    white-space: normal;
}
</style>

