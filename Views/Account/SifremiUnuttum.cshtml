                            cy="40"
                            r="3"
                            fill="currentColor"/>

                    <path d="M38 43V47"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"/>

                    <path d="M12 42C12 35.9 16.9 31 23 31"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"/>

                    <circle cx="14"
                            cy="43"
                            r="5"
                            stroke="currentColor"
                            stroke-width="3"/>
                </svg>

            </div>

            <h2>Şifremi Unuttum</h2>

            @if (kodDogrulandi)
            {
                <p>
                    Kod doğrulandı. Şimdi yeni şifrenizi belirleyebilirsiniz.
                </p>
            }
            else if (kodGonderildi)
            {
                <p>
                    E-posta adresinize gönderilen 6 haneli doğrulama kodunu giriniz.
                </p>
            }
            else
            {
                <p>
                    Kayıtlı e-posta adresinizi girerek şifrenizi yenileyebilirsiniz.
                </p>
            }

        </div>

        <div class="forgot-body">

            @if (ViewBag.Hata != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Hata
                </div>
            }

            @if (!kodGonderildi && !kodDogrulandi)
            {
                <div class="step-info">
                    <strong>1. Adım:</strong>
                    Kayıtlı e-posta adresinizi giriniz. Size 6 haneli bir doğrulama kodu göndereceğiz.
                </div>

                <form asp-controller="Account"
                      asp-action="SifremiUnuttum"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="GirisTuru"
                           value="@girisTuru" />

                    <input type="hidden"
                           name="Adim"
                           value="Email" />

                    <div class="field">

                        <label for="Email">
                            E-posta Adresi
                        </label>

                        <input type="email"
                               id="Email"
                               name="Email"
                               class="custom-input"
                               placeholder="ornek@ornek.com"
                               autocomplete="email"
                               required />

                    </div>

                    <button type="submit"
                            class="action-button">
                        Doğrulama Kodunu Gönder
                    </button>

                </form>
            }

            @if (kodGonderildi && !kodDogrulandi)
            {
                <div class="step-info">
                    <strong>2. Adım:</strong>
                    E-posta adresinize gönderilen 6 haneli doğrulama kodunu giriniz.
                    <br />
                    <strong>Kod 2 dakika boyunca geçerlidir.</strong>
                </div>

                <form asp-controller="Account"
                      asp-action="SifremiUnuttum"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="GirisTuru"
                           value="@girisTuru" />

                    <input type="hidden"
                           name="Adim"
                           value="Kod" />

                    <div class="field">

                        <label for="Kod">
                            Doğrulama Kodu
                        </label>

                        <input type="text"
                               id="Kod"
                               name="Kod"
                               class="code-input"
                               maxlength="6"
                               minlength="6"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               placeholder="000000"
                               required />

                    </div>

                    <button type="submit"
                            class="action-button">
                        Kodu Doğrula
                    </button>

                </form>

                @if (ViewBag.KodSuresiDoldu == true)
                {
                    <form asp-controller="Account"
                          asp-action="SifremiUnuttum"
                          method="post"
                          style="margin-top: 12px;">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="GirisTuru"
                               value="@girisTuru" />

                        <input type="hidden"
                               name="Adim"
                               value="YeniKod" />

                        <button type="submit"
                                class="action-button">
                            Yeni Kod Gönder
                        </button>

                    </form>
                }
            }

            @if (kodDogrulandi)
            {
                <div class="step-info">
                    <strong>3. Adım:</strong>
                    Yeni şifrenizi belirleyin.
                </div>

                <form asp-controller="Account"
                      asp-action="SifremiUnuttum"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="GirisTuru"
                           value="@girisTuru" />

                    <input type="hidden"
                           name="Adim"
                           value="Sifre" />

                    <div class="field">

                        <label for="YeniSifre">
                            Yeni Şifre
                        </label>

                        <input type="password"
                               id="YeniSifre"
                               name="YeniSifre"
                               class="custom-input"
                               placeholder="Yeni şifrenizi giriniz"
                               autocomplete="new-password"
                               required />

                    </div>

                    <div class="field">

                        <label for="YeniSifreTekrar">
                            Yeni Şifre Tekrar
                        </label>

                        <input type="password"
                               id="YeniSifreTekrar"
                               name="YeniSifreTekrar"
                               class="custom-input"
                               placeholder="Yeni şifrenizi tekrar giriniz"
                               autocomplete="new-password"
                               required />

                    </div>

                    <button type="submit"
                            class="action-button">
                        Şifreyi Değiştir
                    </button>

                </form>
            }

            @if (adminMi)
            {
                <a asp-controller="Account"
                   asp-action="AdminLogin"
                   class="back-link">
                    ← Yönetici girişine dön
                </a>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="back-link">
                    ← Öğretmen girişine dön
                </a>
            }

        </div>

    </div>

</div>
