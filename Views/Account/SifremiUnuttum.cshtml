   Sadece adminMi olduğunda çalışır.
   ========================================================= */

.forgot-page.admin-forgot-page {
    width: 100vw;
    height: 100vh;
    min-height: 100vh;

    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    position: relative;
    overflow: hidden;

    background:
        radial-gradient(
            circle at 12% 18%,
            rgba(91, 177, 232, 0.34),
            transparent 31%
        ),
        radial-gradient(
            circle at 88% 82%,
            rgba(25, 87, 143, 0.35),
            transparent 34%
        ),
        linear-gradient(
            135deg,
            #dcecf8 0%,
            #a8d0ea 34%,
            #518bb7 66%,
            #183d61 100%
        );
}

.admin-forgot-page::before {
    content: "";

    position: absolute;

    width: 390px;
    height: 390px;

    left: -160px;
    top: -150px;

    border-radius: 50%;

    background: rgba(255,255,255,0.17);

    pointer-events: none;
}

.admin-forgot-page::after {
    content: "";

    position: absolute;

    width: 480px;
    height: 480px;

    right: -220px;
    bottom: -240px;

    border-radius: 50%;

    background: rgba(8,43,74,0.17);

    pointer-events: none;
}

/* =========================================================
   YÖNETİCİ KART
   ========================================================= */

.admin-forgot-page .forgot-card {
    position: relative;
    z-index: 2;

    width: min(470px, calc(100vw - 40px));

    max-height: calc(100vh - 40px);

