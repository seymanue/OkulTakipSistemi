@model OkulTakipSistemi.Models.RegisterViewModel

<style>

/* =========================================================
   ÖĞRETMEN KAYIT SAYFASI
   TEK VE TEMİZ CSS
   Arka plan rengi: #b87952
   ========================================================= */

html,
body {
    margin: 0 !important;
    padding: 0 !important;
}

body:has(.register-page) {
    margin: 0 !important;
    padding: 0 !important;
    background: #b87952 !important;
    overflow-x: hidden !important;
}

body:has(.register-page) header,
body:has(.register-page) nav {
    display: none !important;
}

/* ANA ALAN */
.register-page {
    position: relative !important;
    isolation: isolate !important;

    width: 100% !important;
    min-height: 100vh !important;
    min-height: 100svh !important;

    box-sizing: border-box !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    padding: 24px !important;

    background: #b87952 !important;

    overflow-x: hidden !important;
    overflow-y: auto !important;
}

/* =========================================================
   DEKORLAR
   ========================================================= */

.register-page::before {
    content: "✈" !important;

    position: fixed !important;
    z-index: 0 !important;

    left: clamp(5%, 10vw, 14%) !important;
    top: 24% !important;

    color: rgba(255, 235, 218, .68) !important;
    font-size: clamp(26px, 3vw, 42px) !important;

    transform: rotate(-15deg) !important;

    pointer-events: none !important;

    animation: registerPlane 4.5s ease-in-out infinite !important;
}

.register-page::after {
    content: "✦   ♡   ✦" !important;

    position: fixed !important;
    z-index: 0 !important;

    right: clamp(5%, 9vw, 13%) !important;
    bottom: 23% !important;

    color: rgba(255, 235, 218, .62) !important;
    font-size: clamp(17px, 2vw, 27px) !important;
    letter-spacing: 5px !important;

    pointer-events: none !important;

    animation: registerSparkles 3.8s ease-in-out infinite !important;
}


/* =========================================================
   TURUNCU ALAN - YILDIZ DEKORLARI
   ========================================================= */

.register-star {
    position: fixed !important;
    z-index: 1 !important;

    color: rgba(255, 238, 220, .72) !important;

    pointer-events: none !important;
    user-select: none !important;

    line-height: 1 !important;

    text-shadow:
        0 0 8px rgba(255, 230, 205, .18) !important;

    animation: none !important;
}

/* Sol üst */
.star-1 {
    left: 10% !important;
    top: 22% !important;
    font-size: 34px !important;
}

/* Sol üst küçük */
.star-2 {
    left: 17% !important;
    top: 16% !important;
    font-size: 17px !important;
    animation-delay: .7s !important;
}

/* Sağ üst */
.star-3 {
    right: 11% !important;
    top: 20% !important;
    font-size: 38px !important;
    animation-delay: 1.2s !important;
}

/* Sağ üst küçük */
.star-4 {
    right: 18% !important;
    top: 28% !important;
    font-size: 18px !important;
    animation-delay: .4s !important;
}

/* Sol alt */
.star-5 {
    left: 12% !important;
    bottom: 21% !important;
    font-size: 27px !important;
    animation-delay: 1.7s !important;
}

/* Sol alt küçük */
.star-6 {
    left: 19% !important;
    bottom: 14% !important;
    font-size: 15px !important;
    animation-delay: 2.1s !important;
}

/* Sağ alt */
.star-7 {
    right: 12% !important;
    bottom: 19% !important;
    font-size: 31px !important;
    animation-delay: 1.5s !important;
}

/* Sağ alt küçük */
.star-8 {
    right: 20% !important;
    bottom: 13% !important;
    font-size: 16px !important;
    animation-delay: 2.4s !important;
}



/* Ekran küçülünce yıldızlar karta yaklaşmasın */
@@media (max-width: 900px) {
    .star-1 {
        left: 4% !important;
    }

    .star-2 {
        left: 7% !important;
    }

    .star-3 {
        right: 4% !important;
    }

    .star-4 {
        right: 7% !important;
    }

    .star-5 {
        left: 4% !important;
    }

    .star-6 {
        left: 7% !important;
    }

    .star-7 {
        right: 4% !important;
    }

    .star-8 {
        right: 7% !important;
    }
}

@@media (max-width: 600px) {
    .register-star {
        opacity: .30 !important;
    }

    .star-1,
    .star-3,
    .star-5,
    .star-7 {
        font-size: 22px !important;
    }

    .star-2,
    .star-4,
    .star-6,
    .star-8 {
        font-size: 12px !important;
    }
}

/* =========================================================
   KART
   ========================================================= */

.register-card {
    position: relative !important;
    z-index: 2 !important;

    width: min(570px, 100%) !important;

    box-sizing: border-box !important;

    margin: 0 auto !important;
    padding: 28px 34px 24px !important;

    background: rgba(255, 248, 241, .88) !important;

    border: 1px solid rgba(255, 255, 255, .55) !important;
    border-radius: 24px !important;

    box-shadow:
        0 22px 55px rgba(61, 37, 27, .24),
        0 4px 14px rgba(61, 37, 27, .10),
        inset 0 1px 0 rgba(255, 255, 255, .7) !important;

    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;

    animation: registerCardIn .45s ease-out both !important;
}

/* Küçük yıldız */
.register-card::before {
    content: "✦" !important;

    position: absolute !important;
    top: 18px !important;
    right: 24px !important;

    color: rgba(126, 78, 55, .28) !important;
    font-size: 17px !important;

    pointer-events: none !important;

    animation: registerTinySparkle 2.8s ease-in-out infinite !important;
}

.register-card::after {
    content: "•" !important;

    position: absolute !important;
    bottom: 17px !important;
    left: 24px !important;

    color: rgba(126, 78, 55, .25) !important;
    font-size: 17px !important;

    pointer-events: none !important;
}

/* =========================================================
   BAŞLIK
   ========================================================= */

.register-header {
    padding: 0 !important;
    margin: 0 0 18px !important;

    text-align: center !important;
}

.register-header .icon {
    width: 62px !important;
    height: 62px !important;

    margin: 0 auto 8px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    border-radius: 18px !important;

    color: #825239 !important;

    background: rgba(126, 78, 55, .10) !important;
    border: 1px solid rgba(126, 78, 55, .14) !important;

    box-shadow:
        0 5px 14px rgba(92, 56, 40, .08),
        inset 0 1px 0 rgba(255, 255, 255, .7) !important;
}

.teacher-register-icon {
    width: 48px !important;
    height: 48px !important;
}

.register-header h2 {
    margin: 0 !important;

    color: #5c3828 !important;

    font-size: clamp(21px, 2vw, 25px) !important;
    line-height: 1.25 !important;
    font-weight: 750 !important;
}

.register-header p {
    margin: 5px 0 0 !important;

    color: #806554 !important;

    font-size: 13px !important;
    line-height: 1.4 !important;
}

.register-header::after {
    content: "⌁   ✦   ⌁" !important;

    display: block !important;

    margin: 9px auto 0 !important;

    color: rgba(126, 78, 55, .45) !important;

    font-size: 12px !important;
    letter-spacing: 4px !important;
}

/* =========================================================
   FORM
   ========================================================= */

.register-body {
    padding: 0 !important;
}

.field {
    margin: 0 0 11px !important;
}

.field label {
    display: block !important;

    margin: 0 0 5px 2px !important;

    color: #5c3828 !important;

    font-size: 12.5px !important;
    line-height: 1.2 !important;

    font-weight: 700 !important;
}

/* =========================================================
   INPUT
   ========================================================= */

.input-wrapper {
    position: relative !important;

    width: 100% !important;
}

.custom-input {
    width: 100% !important;
    height: 46px !important;
    min-height: 46px !important;

    box-sizing: border-box !important;

    padding:
        0 46px 0 53px !important;

    border:
        1px solid rgba(126, 78, 55, .20) !important;

    border-radius: 13px !important;

    outline: none !important;

    background: rgba(255, 252, 248, .82) !important;

    color: #563527 !important;

    font-size: 13.5px !important;

    box-shadow:
        inset 0 1px 2px rgba(80, 45, 30, .035),
        0 2px 7px rgba(80, 45, 30, .035) !important;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease,
        transform .2s ease !important;
}

.custom-input::placeholder {
    color: #927b6e !important;
    opacity: 1 !important;
}

.custom-input:focus {
    border-color: rgba(126, 78, 55, .55) !important;

    background: #fffdfa !important;

    box-shadow:
        0 0 0 3px rgba(126, 78, 55, .09),
        0 4px 12px rgba(80, 45, 30, .07) !important;
}

/* INPUT İKONU */
.input-icon {
    position: absolute !important;

    left: 18px !important;
    top: 50% !important;

    z-index: 3 !important;

    width: 22px !important;
    height: 22px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    color: #85553b !important;

    font-size: 16px !important;

    transform: translateY(-50%) !important;

    pointer-events: none !important;
}

.input-icon svg {
    width: 19px !important;
    height: 19px !important;
}

/* ŞİFRE GÖZÜ */
.password-toggle {
    position: absolute !important;

    right: 14px !important;
    top: 50% !important;

    z-index: 4 !important;

    width: 28px !important;
    height: 28px !important;

    padding: 0 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    border: 0 !important;
    background: transparent !important;

    color: #70452f !important;

    font-size: 15px !important;

    cursor: pointer !important;

    transform: translateY(-50%) !important;

    transition:
        color .2s ease,
        transform .2s ease !important;
}

.password-toggle:hover {
    color: #4f3022 !important;

    transform:
        translateY(-50%)
        scale(1.12) !important;
}

/* =========================================================
   HATA
   ========================================================= */

.error-box {
    margin-bottom: 12px !important;
    padding: 9px 12px !important;

    border-radius: 10px !important;

    background: rgba(170, 67, 52, .10) !important;
    border: 1px solid rgba(170, 67, 52, .20) !important;

    color: #9b493c !important;

    font-size: 12px !important;
}

.validation-error {
    display: block !important;

    margin: 3px 0 0 3px !important;

    color: #a65345 !important;

    font-size: 11px !important;
}

/* =========================================================
   BUTON
   ========================================================= */

.register-button {
    width: 100% !important;

    min-height: 48px !important;

    margin-top: 4px !important;

    padding: 10px 18px !important;

    border: 0 !important;
    border-radius: 13px !important;

    background: #805039 !important;

    color: #fff8f2 !important;

    font-size: 13.5px !important;
    font-weight: 700 !important;

    cursor: pointer !important;

    box-shadow:
        0 7px 17px rgba(89, 52, 34, .20) !important;

    transition:
        transform .2s ease,
        box-shadow .2s ease,
        filter .2s ease !important;
}

.register-button:hover {
    transform: translateY(-2px) !important;

    filter: brightness(1.06) !important;

    box-shadow:
        0 11px 24px rgba(89, 52, 34, .25) !important;
}

.register-button:active {
    transform: translateY(0) scale(.99) !important;
}

/* =========================================================
   GİRİŞE DÖN
   ========================================================= */

.login-link {
    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    flex-wrap: wrap !important;
    gap: 5px !important;

    margin-top: 14px !important;
    padding-top: 12px !important;

    border-top:
        1px solid rgba(126, 78, 55, .13) !important;

    color: #a08b80 !important;

    font-size: 11.5px !important;
}

.login-link a {
    color: #805039 !important;

    font-weight: 700 !important;

    text-decoration: none !important;

    transition:
        color .2s ease,
        transform .2s ease !important;
}

.login-link a:hover {
    color: #593421 !important;
}

/* =========================================================
   ANİMASYONLAR
   ========================================================= */

@@keyframes registerCardIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@@keyframes registerPlane {
    0%, 100% {
        transform:
            translate(0, 0)
            rotate(-15deg);
    }

    50% {
        transform:
            translate(10px, -8px)
            rotate(-7deg);
    }
}

@@keyframes registerSparkles {
    0%, 100% {
        opacity: .45;
        transform: translateY(0);
    }

    50% {
        opacity: .85;
        transform: translateY(-7px);
    }
}

@@keyframes registerTinySparkle {
    0%, 100% {
        opacity: .25;
        transform: scale(1) rotate(0);
    }

    50% {
        opacity: .75;
        transform: scale(1.18) rotate(10deg);
    }
}

/* =========================================================
   EKRAN YÜKSEKLİĞİNE GÖRE
   ========================================================= */

@@media (max-height: 820px) {

    .register-page {
        padding: 14px 20px !important;
    }

    .register-card {
        padding:
            22px 30px 19px !important;
    }

    .register-header {
        margin-bottom: 12px !important;
    }

    .register-header .icon {
        width: 54px !important;
        height: 54px !important;
        margin-bottom: 5px !important;
    }

    .teacher-register-icon {
        width: 43px !important;
        height: 43px !important;
    }

    .register-header h2 {
        font-size: 22px !important;
    }

    .register-header p {
        font-size: 12px !important;
    }

    .field {
        margin-bottom: 8px !important;
    }

    .field label {
        margin-bottom: 3px !important;
    }

    .custom-input {
        height: 42px !important;
        min-height: 42px !important;
    }

    .register-button {
        min-height: 44px !important;
    }

    .login-link {
        margin-top: 10px !important;
        padding-top: 9px !important;
    }
}

/* ÇOK KISA EKRAN */
@@media (max-height: 680px) {

    .register-page {
        align-items: flex-start !important;
        padding: 8px 15px !important;
    }

    .register-card {
        margin-top: 0 !important;
        padding:
            16px 25px 14px !important;
    }

    .register-header {
        margin-bottom: 8px !important;
    }

    .register-header .icon {
        width: 45px !important;
        height: 45px !important;
    }

    .teacher-register-icon {
        width: 36px !important;
        height: 36px !important;
    }

    .register-header h2 {
        font-size: 19px !important;
    }

    .register-header p {
        font-size: 10.5px !important;
    }

    .register-header::after {
        margin-top: 4px !important;
    }

    .field {
        margin-bottom: 5px !important;
    }

    .custom-input {
        height: 38px !important;
        min-height: 38px !important;
        font-size: 12.5px !important;
    }

    .register-button {
        min-height: 40px !important;
        font-size: 12px !important;
    }

    .login-link {
        margin-top: 7px !important;
        padding-top: 6px !important;
        font-size: 10.5px !important;
    }
}

/* =========================================================
   TELEFON
   ========================================================= */

@@media (max-width: 600px) {

    .register-page {
        padding: 10px !important;
    }

    .register-card {
        width: 100% !important;
        max-width: 540px !important;

        padding:
            22px 20px 18px !important;

        border-radius: 20px !important;
    }

    .register-page::before {
        left: 4% !important;
        top: 12% !important;

        font-size: 25px !important;
    }

    .register-page::after {
        right: 4% !important;
        bottom: 12% !important;

        font-size: 18px !important;
    }
}

/* DAR TELEFON */
@@media (max-width: 380px) {

    .register-card {
        padding:
            18px 15px 15px !important;

        border-radius: 17px !important;
    }

    .register-header h2 {
        font-size: 19px !important;
    }

    .custom-input {
        padding-left: 48px !important;
        padding-right: 42px !important;
    }

    .input-icon {
        left: 14px !important;
    }
}

</style>

<div class="register-page">

    <!-- TURUNCU ALAN YILDIZ DEKORLARI -->
    <div class="register-star star-1" aria-hidden="true">✦</div>
    <div class="register-star star-2" aria-hidden="true">✧</div>
    <div class="register-star star-3" aria-hidden="true">✦</div>
    <div class="register-star star-4" aria-hidden="true">✧</div>
    <div class="register-star star-5" aria-hidden="true">✦</div>
    <div class="register-star star-6" aria-hidden="true">✧</div>
    <div class="register-star star-7" aria-hidden="true">✦</div>
    <div class="register-star star-8" aria-hidden="true">✧</div>

    <div class="register-card">

        <!-- ===================================================== -->
        <!-- BAŞLIK -->
        <!-- ===================================================== -->

        <div class="register-header">

            <div class="icon">
                <svg class="teacher-register-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <circle cx="32" cy="32" r="28" fill="rgba(126, 78, 55, 0.14)"/>
                    <circle cx="32" cy="23" r="9" stroke="currentColor" stroke-width="3"/>
                    <path d="M17 48C18.8 39.7 24 35 32 35C40 35 45.2 39.7 47 48" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                    <path d="M18 17L32 10L46 17L32 24L18 17Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
                    <path d="M46 18V27" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                </svg>
            </div>

            <h2>Öğretmen Hesabı Oluştur</h2>

            <p>
                Okul Takip Sistemi'ne öğretmen olarak katılın.
            </p>

        </div>

        <!-- ===================================================== -->
        <!-- FORM -->
        <!-- ===================================================== -->

        <div class="register-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-box">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            @if (ViewBag.Hata != null)
            {
                <div class="error-box">
                    @ViewBag.Hata
                </div>
            }

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- AD SOYAD -->

                <div class="field">

                    <label asp-for="AdSoyad">
                        Ad Soyad
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            <svg viewBox="0 0 24 24"
                                 width="20"
                                 height="20"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <circle cx="12" cy="8" r="3.2"></circle>
                                <path d="M5.5 20c.8-3.5 3-5.3 6.5-5.3s5.7 1.8 6.5 5.3"></path>
                            </svg>
                        </span>

                        <input asp-for="AdSoyad"
                               class="custom-input"
                               placeholder="Örneğin: Ayşe Demir"
                               required />

                    </div>

                    <span asp-validation-for="AdSoyad"
                          class="validation-error">
                    </span>

                </div>

                <!-- KULLANICI ADI -->

                <div class="field">

                    <label asp-for="KullaniciAdi">
                        Kullanıcı Adı
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            @@
                        </span>

                        <input asp-for="KullaniciAdi"
                               class="custom-input"
                               placeholder="Örneğin: ayse.demir"
                               required />

                    </div>

                    <span asp-validation-for="KullaniciAdi"
                          class="validation-error">
                    </span>

                </div>

                <!-- EMAIL -->

                <div class="field">

                    <label asp-for="Email">
                        E-posta Adresi
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            ✉️
                        </span>

                        <input asp-for="Email"
                               type="email"
                               class="custom-input"
                               placeholder="Örneğin: ayse@ornek.com"
                               autocomplete="email"
                               required />

                    </div>

                    <span asp-validation-for="Email"
                          class="validation-error">
                    </span>

                </div>

                <!-- ŞİFRE -->

                <div class="field">

                    <label asp-for="Sifre">
                        Şifre
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            🔒
                        </span>

                        <input asp-for="Sifre"
                               type="password"
                               id="sifre"
                               class="custom-input"
                               placeholder="Kendi şifrenizi belirleyin"
                               autocomplete="new-password"
                               required />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword('sifre', this)">
                            👁️
                        </button>

                    </div>

                    <span asp-validation-for="Sifre"
                          class="validation-error">
                    </span>

                </div>

                <!-- ŞİFRE TEKRAR -->

                <div class="field">

                    <label asp-for="SifreTekrar">
                        Şifre Tekrar
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            🔒
                        </span>

                        <input asp-for="SifreTekrar"
                               type="password"
                               id="sifreTekrar"
                               class="custom-input"
                               placeholder="Şifrenizi tekrar girin"
                               autocomplete="new-password"
                               required />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword('sifreTekrar', this)">
                            👁️
                        </button>

                    </div>

                    <span asp-validation-for="SifreTekrar"
                          class="validation-error">
                    </span>

                </div>

                <!-- HESAP OLUŞTUR -->

                <button type="submit"
                        class="register-button">

                    📧 E-posta Adresime Doğrulama Kodu Gönder

                </button>

            </form>

            <!-- GİRİŞE DÖN -->

            <div class="login-link">

                <span>
                    Zaten hesabınız var mı?
                </span>

                <a asp-controller="Account"
                   asp-action="Login">

