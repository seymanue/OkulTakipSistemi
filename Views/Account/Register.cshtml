/* =========================================================
   ÖĞRETMEN KAYIT — EKRANA TAM SIĞAN SON TASARIM
   ========================================================= */

/* Sayfanın tamamı viewport'a sığsın */
html,
body {
    margin: 0 !important;
    padding: 0 !important;
}

body:has(.register-page) {
    overflow: hidden !important;
    background: #9b5b3e !important;
}


/* =========================================================
   ÜST SİTE ALANI — BEYAZ YER GİTSİN
   ========================================================= */

body:has(.register-page) header,
body:has(.register-page) nav {
    background:
        linear-gradient(
            90deg,
            rgba(91, 48, 35, 0.97),
            rgba(119, 65, 43, 0.96)
        ) !important;

    color: #fff8f1 !important;

    border-bottom:
        1px solid rgba(255, 232, 214, 0.25) !important;

    box-shadow:
        0 4px 18px rgba(57, 31, 23, 0.18) !important;
}

body:has(.register-page) header a,
body:has(.register-page) nav a,
body:has(.register-page) header span,
body:has(.register-page) nav span {
    color: #fff5ed !important;
}


/* =========================================================
   ANA ALAN
   ========================================================= */

.register-page {
    position: relative !important;

    width: 100vw !important;

    /*
       Navbarın altında kalan alanı kullan.
       Böylece sayfa aşağı doğru taşmaz.
    */
