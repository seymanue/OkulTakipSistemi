    box-shadow:
        0 12px 26px rgba(113, 57, 34, 0.34) !important;
}


/* =========================================================
   GİRİŞE DÖN
   ========================================================= */

.login-link {
    margin-top: 23px !important;
    padding-top: 20px !important;

    border-top:
        1px solid rgba(255,255,255,0.22) !important;

    text-align: center !important;

    color:
        rgba(255,248,243,0.76) !important;

    font-size: 13px !important;
}

.login-link a {
    color:
        #fffaf6 !important;

    font-weight: 700 !important;

    text-decoration: none !important;

    margin-left: 5px !important;
}

.login-link a:hover {
    text-decoration: underline !important;
}


/* =========================================================
   EMOJİLERİ BİRAZ DAHA UYUMLU GÖSTER
   ========================================================= */

.register-card .input-icon {
    filter: grayscale(0.15) !important;
}

.register-card .password-toggle {
    filter: grayscale(0.15) !important;
}


/* =========================================================
   MOBİL
   ========================================================= */

@@media (max-width: 600px) {

    .register-page {
        min-height: 100vh !important;
        padding: 20px 12px !important;
    }

    .register-card {
        max-width: 100% !important;
        border-radius: 24px !important;
    }

    .register-header {
        padding: 28px 20px 24px !important;
    }

    .register-header h2 {
        font-size: 22px !important;
    }

    .register-body {
        padding: 25px 20px 28px !important;
    }

}


/* =========================================================
   KAYIT SAYFASI — SON GÖRSEL DÜZEN
   ========================================================= */

.register-page {
    min-height: 100vh !important;
    position: relative !important;
    overflow: hidden !important;

    background:
        radial-gradient(
            ellipse at 15% 20%,
            rgba(255, 194, 125, 0.52) 0%,
