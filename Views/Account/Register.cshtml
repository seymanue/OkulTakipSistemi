    min-height: 0 !important;

    box-sizing: border-box !important;

    padding:
        16px 20px 18px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    overflow: hidden !important;

    background:
        radial-gradient(
            ellipse at 8% 18%,
            rgba(226, 164, 104, 0.38),
            transparent 38%
        ),
        radial-gradient(
            ellipse at 88% 78%,
            rgba(73, 43, 35, 0.42),
            transparent 44%
        ),
        linear-gradient(
            120deg,
            #b87952 0%,
            #956049 42%,
            #67463d 72%,
            #493735 100%
        ) !important;
}


/* Arka plandaki yumuşak ışık */
.register-page::before {
    content: "" !important;

    position: absolute !important;
    inset: -20% !important;

    background:
        radial-gradient(
            ellipse at 20% 25%,
            rgba(255, 226, 185, 0.38),
            transparent 30%
        ),
        radial-gradient(
            ellipse at 78% 75%,
            rgba(79, 40, 30, 0.30),
            transparent 38%
        ) !important;

    filter: blur(32px) !important;

    pointer-events: none !important;
}


/* =========================================================
   KART — DAHA KOMPAKT
   ========================================================= */

.register-card {
    position: relative !important;
    z-index: 5 !important;

    width: min(560px, 92vw) !important;

    max-width: 560px !important;

    max-height: calc(100vh - 92px) !important;

    overflow: hidden !important;

    border-radius: 22px !important;

    background:
        linear-gradient(
            145deg,
            rgba(255, 244, 233, 0.30),
            rgba(111, 62, 44, 0.39)
        ) !important;

    border:
        1px solid rgba(255, 239, 225, 0.64) !important;

    box-shadow:
        0 22px 60px rgba(62, 34, 26, 0.28),
        inset 0 1px 0 rgba(255,255,255,0.28) !important;

    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
}


/* =========================================================
   ÜST BAŞLIK — DAHA ŞIK
   ========================================================= */

.register-header {
    padding:
        18px 25px 15px !important;

    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,0.10),
            rgba(255,255,255,0.025)
        ) !important;

    border-bottom:
        1px solid rgba(255,255,255,0.24) !important;
}

.register-header .icon {
    width: 58px !important;
    height: 58px !important;

    margin:
        0 auto 8px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    font-size: 30px !important;

    border-radius: 17px !important;

    background:
        rgba(255,255,255,0.10) !important;

    border:
        1px solid rgba(255,255,255,0.52) !important;

    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.28),
        0 6px 18px rgba(65,35,27,0.13) !important;
}

.register-header h2 {
    margin: 0 !important;

    font-size: 22px !important;

    color: #fffaf6 !important;
}

.register-header p {
    margin:
        5px 0 0 !important;

    font-size: 12px !important;

    color:
        rgba(255,248,243,0.82) !important;
}


/* =========================================================
   FORM GÖVDESİ — SIKI
   ========================================================= */

.register-body {
    padding:
        16px 26px 17px !important;
}


/* Alanlar arasındaki boşluk */
.field {
    margin-bottom: 9px !important;
}


/* Etiketler */
.field label {
    margin-bottom: 4px !important;

    font-size: 12px !important;

    color:
        rgba(255,249,245,0.94) !important;
}


/* =========================================================
   INPUTLAR
   ========================================================= */

.custom-input {
    height: 43px !important;

    border-radius: 12px !important;

    padding-left: 55px !important;
    padding-right: 48px !important;

    font-size: 13px !important;

    background:
        rgba(255,246,238,0.19) !important;

    border:
        1px solid rgba(255,240,228,0.62) !important;

    color: #fffaf6 !important;

    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.15) !important;
}

.custom-input::placeholder {
    color:
        rgba(255,248,243,0.69) !important;
}


/* =========================================================
   RENKLİ İKONLAR
   ========================================================= */

/* AD SOYAD — KAHVERENGİ */
.input-wrapper:has(input[name="AdSoyad"]) .input-icon {
    color: #704331 !important;
}


/* KULLANICI ADI — TURUNCU */
.input-wrapper:has(input[name="KullaniciAdi"]) .input-icon {
    color: #e96732 !important;
}


/* EMAIL — MAVİ */
.input-wrapper:has(input[name="Email"]) .input-icon {
    color: #2788d5 !important;
}


/* ŞİFRELER — ALTIN */
.input-wrapper:has(input[name="Sifre"]) .input-icon,
.input-wrapper:has(input[name="SifreTekrar"]) .input-icon {
    color: #d9a62e !important;
}


/* ikon boyutları */
.input-icon {
    left: 17px !important;

    width: 25px !important;
    height: 25px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    font-size: 18px !important;

    z-index: 5 !important;
}


/* =========================================================
   GÖZLER
   ========================================================= */

.password-toggle {
    right: 10px !important;

    width: 30px !important;
    height: 30px !important;

    color: #765142 !important;

    font-size: 17px !important;
}

.password-toggle:hover {
    color: #fffaf6 !important;
}


/* =========================================================
   BUTON
   ========================================================= */

.register-button {
    height: 45px !important;

    margin-top: 3px !important;

    border-radius: 12px !important;

    font-size: 14px !important;

    background:
        linear-gradient(
            135deg,
            #8b5035,
            #b66b43
        ) !important;

    border:
        1px solid rgba(255,225,205,0.48) !important;

    color: #fffaf6 !important;

    box-shadow:
        0 8px 20px rgba(91,45,31,0.22) !important;
}


/* =========================================================
   ALT LİNK
   ========================================================= */

.login-link {
    margin-top: 10px !important;

    padding-top: 10px !important;

    border-top:
        1px solid rgba(255,255,255,0.20) !important;

    font-size: 11px !important;

    color:
        rgba(255,248,243,0.76) !important;
}

.login-link a {
    color: #fffaf6 !important;
}


/* =========================================================
   HATA KUTUSU
   ========================================================= */

.error-box {
    padding: 9px 12px !important;

    margin-bottom: 10px !important;

    border-radius: 10px !important;

    font-size: 12px !important;
}


/* =========================================================
   MOBİL
   ========================================================= */

@@media (max-width: 600px) {

    .register-page {
        height: calc(100vh - 56px) !important;

        padding:
            10px 10px 12px !important;
    }

    .register-card {
        width: 96vw !important;

        max-height:
            calc(100vh - 76px) !important;
    }

    .register-body {
        padding:
            14px 18px !important;
    }

    .register-header {
        padding:
            14px 18px 12px !important;
    }

    .field {
        margin-bottom: 7px !important;
    }
}

</style>

<div class="register-page">

    <div class="register-card">

        <!-- ===================================================== -->
        <!-- BAŞLIK -->
        <!-- ===================================================== -->

        <div class="register-header">

            <div class="icon">
                <svg class="teacher-register-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <circle cx="32" cy="32" r="28" fill="rgba(126, 78, 55, 0.14)"/>
                    <circle cx="32" cy="23" r="9" stroke="currentColor" stroke-width="3"/>
                    <path d="M17 48C18.8 39.7 24 35 32 35C40 35 45.2 39.7 47 48" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                    <path d="M18 17L32 10L46 17L32 24L18 17Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
                    <path d="M46 18V27" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                </svg>
            </div>

            <h2>Öğretmen Hesabı Oluştur</h2>

            <p>
                Okul Takip Sistemi'ne öğretmen olarak katılın.
            </p>

        </div>

        <!-- ===================================================== -->
        <!-- FORM -->
        <!-- ===================================================== -->

        <div class="register-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-box">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            @if (ViewBag.Hata != null)
            {
                <div class="error-box">
                    @ViewBag.Hata
                </div>
            }

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- AD SOYAD -->

                <div class="field">

                    <label asp-for="AdSoyad">
                        Ad Soyad
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            👤
                        </span>

                        <input asp-for="AdSoyad"
                               class="custom-input"
                               placeholder="Örneğin: Ayşe Demir"
                               required />

                    </div>

                    <span asp-validation-for="AdSoyad"
                          class="validation-error">
                    </span>

                </div>

                <!-- KULLANICI ADI -->

                <div class="field">

                    <label asp-for="KullaniciAdi">
                        Kullanıcı Adı
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            @@
                        </span>

                        <input asp-for="KullaniciAdi"
                               class="custom-input"
                               placeholder="Örneğin: ayse.demir"
                               required />

                    </div>

                    <span asp-validation-for="KullaniciAdi"
                          class="validation-error">
                    </span>

                </div>

                <!-- EMAIL -->

                <div class="field">

                    <label asp-for="Email">
                        Email Adresi
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            ✉️
                        </span>

                        <input asp-for="Email"
                               type="email"
                               class="custom-input"
                               placeholder="Örneğin: ayse@gmail.com"
                               autocomplete="email"
                               required />

                    </div>

                    <span asp-validation-for="Email"
                          class="validation-error">
                    </span>

                </div>

                <!-- ŞİFRE -->

                <div class="field">

                    <label asp-for="Sifre">
                        Şifre
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            🔒
                        </span>

                        <input asp-for="Sifre"
                               type="password"
                               id="sifre"
                               class="custom-input"
                               placeholder="Kendi şifrenizi belirleyin"
                               autocomplete="new-password"
                               required />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword('sifre', this)">
                            👁️
                        </button>

                    </div>

                    <span asp-validation-for="Sifre"
                          class="validation-error">
                    </span>

                </div>

                <!-- ŞİFRE TEKRAR -->

                <div class="field">

                    <label asp-for="SifreTekrar">
                        Şifre Tekrar
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            🔒
                        </span>

                        <input asp-for="SifreTekrar"
                               type="password"
                               id="sifreTekrar"
                               class="custom-input"
                               placeholder="Şifrenizi tekrar girin"
                               autocomplete="new-password"
                               required />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword('sifreTekrar', this)">
                            👁️
                        </button>

                    </div>

                    <span asp-validation-for="SifreTekrar"
                          class="validation-error">
                    </span>

                </div>

                <!-- HESAP OLUŞTUR -->

                <button type="submit"
                        class="register-button">

                    📧 Emailime Doğrulama Kodu Gönder

                </button>

            </form>

            <!-- GİRİŞE DÖN -->

            <div class="login-link">

                <span>
                    Zaten hesabınız var mı?
                </span>

                <a asp-controller="Account"
                   asp-action="Login">

                    Öğretmen girişine dön

                </a>

            </div>

        </div>

    </div>

</div>

<script>

    function togglePassword(inputId, button) {

        const input = document.getElementById(inputId);

        if (input.type === "password") {

            input.type = "text";
            button.innerHTML = "🙈";

        }
        else {

            input.type = "password";
            button.innerHTML = "👁️";

        }
    }

</script>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
