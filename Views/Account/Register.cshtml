@model OkulTakipSistemi.Models.RegisterViewModel

@{
    ViewData["Title"] = "Öğretmen Hesabı Oluştur";
}

<style>

/* =========================================================
   ÖĞRETMEN KAYIT — SICAK CAM TASARIM
   ========================================================= */

.register-page {
    min-height: 100vh !important;
    width: 100% !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    padding: 40px 20px !important;
    box-sizing: border-box !important;

    background:
        radial-gradient(
            circle at 18% 35%,
            rgba(221, 150, 91, 0.55),
            transparent 38%
        ),
        radial-gradient(
            circle at 85% 65%,
            rgba(112, 66, 48, 0.50),
            transparent 42%
        ),
        linear-gradient(
            115deg,
            #d99358 0%,
            #b86f49 42%,
            #744839 100%
        ) !important;

    position: relative !important;
    overflow: hidden !important;
}


/* Arka planda yumuşak ışık */

.register-page::before {
    content: "" !important;

    position: absolute !important;
    inset: -20% !important;

    background:
        radial-gradient(
            circle at 25% 30%,
            rgba(255, 235, 215, 0.20),
            transparent 30%
        ),
        radial-gradient(
            circle at 75% 70%,
            rgba(255, 220, 190, 0.12),
            transparent 34%
        ) !important;

    pointer-events: none !important;
}


/* =========================================================
   ANA KART
   ========================================================= */

.register-card {
    position: relative !important;
    z-index: 2 !important;

    width: 100% !important;
    max-width: 600px !important;

    background:
        linear-gradient(
            145deg,
            rgba(255, 247, 239, 0.46),
            rgba(126, 73, 49, 0.47)
        ) !important;

    border:
        1px solid rgba(255, 239, 225, 0.72) !important;

    border-radius: 30px !important;

    box-shadow:
        0 25px 70px rgba(65, 38, 29, 0.28),
        inset 0 1px 0 rgba(255,255,255,0.42) !important;

    backdrop-filter: blur(18px) !important;
    -webkit-backdrop-filter: blur(18px) !important;

    overflow: hidden !important;
}


/* =========================================================
   BAŞLIK
   ========================================================= */

.register-header {
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.12),
            rgba(92, 49, 35, 0.12)
        ) !important;

    color: #fffaf6 !important;

    text-align: center !important;

    padding: 34px 30px 28px !important;

    border-bottom:
        1px solid rgba(255,255,255,0.22) !important;
}

.register-header .icon {
    width: 72px !important;
    height: 72px !important;

    margin: 0 auto 16px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    border-radius: 20px !important;

    background:
        rgba(255,255,255,0.13) !important;

    border:
        1px solid rgba(255,255,255,0.48) !important;

    box-shadow:
        0 8px 25px rgba(67, 39, 29, 0.14),
        inset 0 1px 0 rgba(255,255,255,0.28) !important;

    font-size: 35px !important;
    line-height: 1 !important;
}

.register-header h2 {
    margin: 0 !important;

    color: #fffaf6 !important;

    font-size: 26px !important;
    font-weight: 750 !important;
    letter-spacing: -0.3px !important;
}

.register-header p {
    margin: 10px 0 0 !important;

    color: rgba(255,248,243,0.82) !important;

    font-size: 14px !important;
    line-height: 1.5 !important;
}


/* =========================================================
   FORM GÖVDESİ
   ========================================================= */

.register-body {
    padding: 30px 34px 32px !important;
}


/* =========================================================
   ALANLAR
   ========================================================= */

.field {
    margin-bottom: 16px !important;
}

.field label {
    display: block !important;

    margin: 0 0 7px 3px !important;

    color: rgba(255,248,243,0.90) !important;

    font-size: 13px !important;
    font-weight: 600 !important;
}


/* =========================================================
   INPUT
   ========================================================= */

.input-wrapper {
    position: relative !important;
}

.input-icon {
    position: absolute !important;

    left: 17px !important;
    top: 50% !important;

    transform: translateY(-50%) !important;

    width: 24px !important;
    height: 24px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    color: #705044 !important;

    z-index: 3 !important;

    font-size: 18px !important;
}

.custom-input {
    width: 100% !important;
    height: 53px !important;

    box-sizing: border-box !important;

    border:
        1px solid rgba(255, 239, 225, 0.70) !important;

    border-radius: 14px !important;

    background:
        rgba(255, 250, 246, 0.82) !important;

    color: #49352d !important;

    padding:
