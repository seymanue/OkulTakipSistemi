    font-size: 14px !important;
    font-weight: 500 !important;

    outline: none !important;

    box-shadow:
        0 4px 14px rgba(75, 43, 31, 0.08),
        inset 0 1px 0 rgba(255,255,255,0.70) !important;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease !important;
}

.custom-input::placeholder {
    color: rgba(91, 70, 60, 0.62) !important;
}

.custom-input:focus {
    border-color:
        rgba(255, 239, 225, 0.95) !important;

    background:
        rgba(255, 252, 249, 0.94) !important;

    box-shadow:
        0 0 0 3px rgba(255, 225, 205, 0.20),
        0 7px 18px rgba(75, 43, 31, 0.10) !important;
}


/* =========================================================
   ŞİFRE GÖZÜ
   ========================================================= */

.password-toggle {
    position: absolute !important;

    right: 11px !important;
    top: 50% !important;

    transform: translateY(-50%) !important;

    width: 34px !important;
    height: 34px !important;

    padding: 0 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    border: 0 !important;

    background: transparent !important;

    color: #705044 !important;

    cursor: pointer !important;

    z-index: 5 !important;

    font-size: 18px !important;
}

.password-toggle:hover {
    color: #4f382f !important;
}


/* =========================================================
   HATALAR
   ========================================================= */

.validation-error {
    display: block !important;

    margin:
        5px 3px 0 !important;

    color: #ffd9d0 !important;

    font-size: 12px !important;
    font-weight: 500 !important;
}

.error-box {
    margin-bottom: 18px !important;

    padding: 13px 15px !important;

    border-radius: 13px !important;

    background:
        rgba(255, 222, 214, 0.92) !important;

    border:
        1px solid rgba(156, 65, 45, 0.30) !important;

    color: #6f3026 !important;

    font-size: 13px !important;

    box-shadow:
        0 5px 14px rgba(91,45,32,0.10) !important;
}

.error-box * {
    color: #6f3026 !important;
}


/* =========================================================
   KAYIT BUTONU
   ========================================================= */

.register-button {
    width: 100% !important;
    height: 54px !important;

    margin-top: 5px !important;

    border:
        1px solid rgba(255, 225, 205, 0.48) !important;

    border-radius: 14px !important;

    background:
        linear-gradient(
            135deg,
            #8b5035,
            #b66b43
