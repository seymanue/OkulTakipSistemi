@model OkulTakipSistemi.Models.RegisterViewModel

<style>

html,
body {
    margin: 0 !important;
    padding: 0 !important;
}

body:has(.admin-register-page) {
    margin: 0 !important;
    padding: 0 !important;
    background: #9fc9e7 !important;
    overflow-x: hidden !important;
}

body:has(.admin-register-page) header,
body:has(.admin-register-page) nav {
    display: none !important;
}

body:has(.admin-register-page) > .container-fluid {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
}

body:has(.admin-register-page) main.pb-3 {
    width: 100vw !important;
    min-height: 100vh !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* =========================================================
   ANA ALAN
   ========================================================= */

.admin-register-page {
    position: relative !important;
    isolation: isolate !important;

    width: 100% !important;
    min-height: 100vh !important;
    min-height: 100svh !important;

    box-sizing: border-box !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    padding: 24px !important;

    background:
        radial-gradient(
            circle at 12% 18%,
            rgba(255,255,255,.22),
            transparent 28%
        ),
        radial-gradient(
            circle at 88% 82%,
            rgba(23,59,96,.25),
            transparent 34%
        ),
        linear-gradient(
            135deg,
            #dcecf8 0%,
            #9fc9e7 42%,
            #4b8fc0 72%,
            #173b60 100%
        ) !important;

    overflow-x: hidden !important;
    overflow-y: auto !important;
}

/* =========================================================
   DEKORLAR
   ========================================================= */

.admin-register-page::before {
    content: "✦" !important;

    position: fixed !important;
    z-index: 0 !important;

    left: 10% !important;
    top: 23% !important;

    color: rgba(255,255,255,.65) !important;

    font-size: 34px !important;

    pointer-events: none !important;

    animation: none !important;
}

.admin-register-page::after {
    content: "✦   ✧   ✦" !important;

    position: fixed !important;
    z-index: 0 !important;

    right: 9% !important;
    bottom: 20% !important;

    color: rgba(255,255,255,.58) !important;

    font-size: 20px !important;
    letter-spacing: 6px !important;

    pointer-events: none !important;

    animation: none !important;
}

/* =========================================================
   KART
   ========================================================= */

.admin-register-card {
    position: relative !important;
    z-index: 2 !important;

    width: min(570px, 100%) !important;

    box-sizing: border-box !important;

    margin: 0 auto !important;

    padding: 28px 34px 24px !important;

    background: rgba(255,255,255,.89) !important;

    border: 1px solid rgba(255,255,255,.72) !important;

    border-radius: 24px !important;

    box-shadow:
        0 22px 55px rgba(18,57,87,.23),
        0 4px 14px rgba(18,57,87,.10),
        inset 0 1px 0 rgba(255,255,255,.8) !important;

    backdrop-filter: blur(17px) !important;
    -webkit-backdrop-filter: blur(17px) !important;

    animation: adminCardIn .45s ease-out both !important;
}

/* =========================================================
   BAŞLIK
   ========================================================= */

.admin-register-header {
    padding: 0 !important;
    margin: 0 0 18px !important;

    text-align: center !important;
}

.admin-register-logo {
    width: 62px !important;
    height: 62px !important;

    margin: 0 auto 8px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    border-radius: 18px !important;

    color: #ffffff !important;

    background:
        linear-gradient(
            145deg,
            #52afea 0%,
            #2583ce 48%,
            #1766a9 100%
        ) !important;

    border: 1px solid rgba(255,255,255,.55) !important;

    box-shadow:
        0 10px 23px rgba(24,103,166,.25),
        inset 0 1px 2px rgba(255,255,255,.35) !important;
}

.admin-register-logo svg {
    width: 43px !important;
    height: 43px !important;
}

.admin-register-header h2 {
    margin: 0 !important;

    color: #1c466d !important;

    font-size: clamp(22px, 2vw, 26px) !important;

    line-height: 1.25 !important;

    font-weight: 800 !important;
}

.admin-register-header p {
    margin: 5px 0 0 !important;

    color: #61798e !important;

    font-size: 13px !important;

    line-height: 1.4 !important;
}

.admin-register-header::after {
    content: "⌁   ✦   ⌁" !important;

    display: block !important;

    margin: 9px auto 0 !important;

    color: rgba(47,119,174,.48) !important;

    font-size: 12px !important;

    letter-spacing: 4px !important;
}

/* =========================================================
   FORM
   ========================================================= */

.admin-register-body {
    padding: 0 !important;
}

.admin-field {
    margin: 0 0 11px !important;
}

.admin-field label {
    display: block !important;

    margin: 0 0 5px 2px !important;

    color: #214a6d !important;

    font-size: 12.5px !important;

    line-height: 1.2 !important;

    font-weight: 700 !important;
}

.admin-input-wrapper {
    position: relative !important;

    width: 100% !important;
}

.admin-custom-input {
    width: 100% !important;

    height: 46px !important;
    min-height: 46px !important;

    box-sizing: border-box !important;

    padding: 0 46px 0 53px !important;

    border: 1px solid rgba(67,126,166,.22) !important;

    border-radius: 13px !important;

    outline: none !important;

    background: rgba(255,255,255,.84) !important;

    color: #263e55 !important;

    font-size: 13.5px !important;

    box-shadow:
        inset 0 1px 2px rgba(30,70,100,.035),
        0 2px 7px rgba(30,70,100,.035) !important;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease,
        transform .2s ease !important;
}

.admin-custom-input::placeholder {
    color: #91a5b5 !important;

    opacity: 1 !important;
}

.admin-custom-input:focus {
    border-color: rgba(43,139,207,.58) !important;

    background: #ffffff !important;

    box-shadow:
        0 0 0 3px rgba(67,151,213,.10),
        0 4px 12px rgba(30,80,120,.07) !important;
}

.admin-input-icon {
    position: absolute !important;

    left: 18px !important;
    top: 50% !important;

    z-index: 3 !important;

    width: 22px !important;
    height: 22px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    color: #4383ad !important;

    transform: translateY(-50%) !important;

    pointer-events: none !important;
}

.admin-input-icon svg {
    width: 19px !important;
    height: 19px !important;

    fill: none !important;

    stroke: currentColor !important;

    stroke-width: 1.8 !important;

    stroke-linecap: round !important;

    stroke-linejoin: round !important;
}

.admin-password-toggle {
    position: absolute !important;

    right: 14px !important;
    top: 50% !important;

    z-index: 4 !important;

    width: 28px !important;
    height: 28px !important;

    padding: 0 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    border: 0 !important;

    background: transparent !important;

    color: #5282a4 !important;

    font-size: 15px !important;

    cursor: pointer !important;

    transform: translateY(-50%) !important;
}

.admin-password-toggle:hover {
    color: #1e6da5 !important;
}

/* =========================================================
   HATALAR
   ========================================================= */

.admin-error-box {
    margin-bottom: 12px !important;

    padding: 9px 12px !important;

    border-radius: 10px !important;

    background: rgba(170,67,52,.09) !important;

    border: 1px solid rgba(170,67,52,.19) !important;

    color: #a0443b !important;

    font-size: 12px !important;
}

.admin-error-box ul {
    margin: 0 !important;

    padding-left: 17px !important;
}

.admin-validation-error {
    display: block !important;

    margin: 3px 0 0 3px !important;

    color: #a65345 !important;

    font-size: 11px !important;
}

/* =========================================================
   BUTON
   ========================================================= */

.admin-register-button {
    width: 100% !important;

    min-height: 48px !important;

    margin-top: 4px !important;

    padding: 10px 18px !important;

    border: 0 !important;

    border-radius: 13px !important;

    background:
        linear-gradient(
            135deg,
            #319ce9,
            #1978c8
        ) !important;

    color: #ffffff !important;

    font-size: 13.5px !important;

    font-weight: 700 !important;

    cursor: pointer !important;

    box-shadow:
        0 7px 17px rgba(31,126,199,.22) !important;

    transition:
        transform .2s ease,
        box-shadow .2s ease,
        filter .2s ease !important;
}

.admin-register-button:hover {
    transform: translateY(-2px) !important;

    filter: brightness(1.05) !important;

    box-shadow:
        0 11px 24px rgba(31,126,199,.28) !important;
}

.admin-register-button:active {
    transform: translateY(0) scale(.99) !important;
}

/* =========================================================
   DOĞRULAMA
   ========================================================= */

.admin-verification {
    text-align: center !important;
}

.admin-verification-icon {
    width: 58px !important;
    height: 58px !important;

    margin: 0 auto 12px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    border-radius: 17px !important;

    background:
        linear-gradient(
            145deg,
            #52afea,
            #1766a9
        ) !important;

    color: #ffffff !important;

    font-size: 28px !important;

    font-weight: 800 !important;

    box-shadow:
        0 10px 22px rgba(24,103,166,.23) !important;
}

.admin-verification h3 {
    margin: 0 !important;

    color: #1c466d !important;

    font-size: 23px !important;

    font-weight: 800 !important;
}

.admin-verification-subtitle {
    display: flex !important;

    align-items: center !important;

    justify-content: center !important;

    gap: 10px !important;

    margin: 7px 0 9px !important;
}

.admin-verification-subtitle span {
    width: 40px !important;

    height: 1.5px !important;

    background: #6199c2 !important;
}

.admin-verification-subtitle strong {
    color: #39719a !important;

    font-size: 13px !important;
}

.admin-verification-description {
    margin: 0 0 17px !important;

    color: #61798e !important;

    font-size: 12.5px !important;

    line-height: 1.5 !important;
}

.admin-code-input {
    text-align: center !important;

    letter-spacing: 7px !important;

    font-size: 18px !important;

    font-weight: 700 !important;

    padding-left: 53px !important;
}

.admin-verification .admin-input-icon {
    color: #4383ad !important;
}

.admin-back-text {
    margin-top: 12px !important;

    color: #718899 !important;

    font-size: 11.5px !important;

    text-align: center !important;
}

/* =========================================================
   GİRİŞE DÖN
   ========================================================= */

.admin-login-link {
    display: flex !important;

    align-items: center !important;

    justify-content: center !important;

    flex-wrap: wrap !important;

    gap: 5px !important;

    margin-top: 14px !important;

    padding-top: 12px !important;

    border-top:
        1px solid rgba(67,126,166,.15) !important;

    color: #8497a6 !important;

    font-size: 11.5px !important;
}

.admin-login-link a {
    color: #1c5d8e !important;

    font-weight: 700 !important;

    text-decoration: none !important;
}

.admin-login-link a:hover {
    color: #1978c8 !important;
}

/* =========================================================
   ANİMASYON
   ========================================================= */

@@keyframes adminCardIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@@keyframes adminSparkle {
    0%, 100% {
        opacity: .38;
        transform: translateY(0);
    }

    50% {
        opacity: .82;
        transform: translateY(-7px);
    }
}

/* =========================================================
   YÜKSEKLİK
   ========================================================= */

@@@@media (max-height: 820px) {

    .admin-register-page {
        padding: 14px 20px !important;
    }

    .admin-register-card {
        padding: 22px 30px 19px !important;
    }

    .admin-register-header {
        margin-bottom: 12px !important;
    }

    .admin-register-logo {
        width: 54px !important;
        height: 54px !important;
        margin-bottom: 5px !important;
    }

    .admin-register-logo svg {
        width: 38px !important;
        height: 38px !important;
    }

    .admin-register-header h2 {
        font-size: 22px !important;
    }

    .admin-register-header p {
        font-size: 12px !important;
    }

    .admin-field {
        margin-bottom: 8px !important;
    }

    .admin-custom-input {
        height: 42px !important;
        min-height: 42px !important;
    }

    .admin-register-button {
        min-height: 44px !important;
    }
}

/* =========================================================
   TELEFON
   ========================================================= */

@@@@media (max-width: 600px) {

    .admin-register-page {
        padding: 10px !important;
    }

    .admin-register-card {
        width: 100% !important;

        max-width: 540px !important;

        padding: 22px 20px 18px !important;

        border-radius: 20px !important;
    }
}

</style>

<div class="admin-register-page">

    <div class="admin-register-card">

        <!-- ================================================= -->
        <!-- BAŞLIK -->
        <!-- ================================================= -->

        <div class="admin-register-header">

            <div class="admin-register-logo">

                <svg viewBox="0 0 64 64"
                     fill="none"
                     aria-hidden="true">

                    <path d="M10 18L20 29L32 12L44 29L54 18L51 46H13L10 18Z"
                          fill="white"
                          stroke="white"
                          stroke-width="2.5"
                          stroke-linejoin="round"/>

                    <circle cx="10" cy="18" r="4" fill="white"/>
                    <circle cx="32" cy="12" r="4" fill="white"/>
                    <circle cx="54" cy="18" r="4" fill="white"/>

                    <path d="M15 50H49"
                          stroke="white"
                          stroke-width="4"
                          stroke-linecap="round"/>

                </svg>

            </div>

            <h2>
                Yönetici Hesabı Oluştur
            </h2>

            <p>
                Okul Takip Sistemi'ne yönetici olarak katılın.
            </p>

        </div>

        <div class="admin-register-body">

            @if (ViewBag.ShowVerification == true)
            {
                <form asp-controller="Account"
                      asp-action="AdminRegister"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="admin-verification-content">

                        <div class="admin-verification-icon">
                            ✉
                        </div>

                        <h1 class="admin-verification-title">
                            E-posta Doğrulama
                        </h1>

                        <div class="admin-verification-subtitle">
                            <span></span>
                            <strong>Hesabınızı doğrulayın</strong>
                            <span></span>
                        </div>

                        <p class="admin-verification-description">
                            E-posta adresinize gönderilen 6 haneli doğrulama kodunu
                            aşağıdaki alana giriniz.
                        </p>

                        @if (ViewBag.Hata != null)
                        {
                            <div class="error-box admin-verification-error auto-hide-error">
                                @ViewBag.Hata
                            </div>
                        }

                        <div class="admin-code-field">
                            <span class="admin-code-icon">▤</span>

                            <input type="text"
                                   name="Kod"
                                   maxlength="6"
                                   minlength="6"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   placeholder="6 haneli doğrulama kodu"
                                   required />
                        </div>

                        <button type="submit"
                                class="admin-register-button admin-verify-button">
                            ✓ &nbsp; E-postayı Doğrula
                        </button>

                        <div class="admin-verification-info">
                            <span class="admin-info-icon">ⓘ</span>
                            <span>
                                Kod size ulaşmadıysa spam veya gereksiz
                                e-posta klasörünüzü de kontrol ediniz.
                            </span>
                        </div>

                    </div>

                </form>
            }
            else
            {
                <!-- ================================================= -->
                <!-- KAYIT HATALARI -->
                <!-- ================================================= -->

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="admin-error-box auto-hide-error">

                        <div asp-validation-summary="All"></div>

                    </div>
                }

                @if (ViewBag.Hata != null)
                {
                    <div class="admin-error-box auto-hide-error">
                        @ViewBag.Hata
                    </div>
                }

                <!-- ================================================= -->
                <!-- KAYIT FORMU -->
                <!-- ================================================= -->

                <form asp-controller="Account"
                      asp-action="AdminRegister"
                      method="post">

                    @Html.AntiForgeryToken()

                    <!-- AD SOYAD -->

                    <div class="admin-field">

                        <label asp-for="AdSoyad">
                            Ad Soyad
                        </label>

                        <div class="admin-input-wrapper">

                            <span class="admin-input-icon">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <circle cx="12"
                                            cy="8"
                                            r="3.2"/>

                                    <path d="M5.5 20c.8-3.5 3-5.3 6.5-5.3s5.7 1.8 6.5 5.3"/>

                                </svg>

                            </span>

                            <input asp-for="AdSoyad"
                                   class="admin-custom-input"
                                   placeholder="Örneğin: Ayşe Demir"
                                   autocomplete="name"
                                   required />

                        </div>

                        <span asp-validation-for="AdSoyad"
                              class="admin-validation-error">
                        </span>

                    </div>

                    <!-- KULLANICI ADI -->

                    <div class="admin-field">

                        <label asp-for="KullaniciAdi">
                            Kullanıcı Adı
                        </label>

                        <div class="admin-input-wrapper">

                            <span class="admin-input-icon">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <circle cx="12"
                                            cy="12"
                                            r="8"/>

                                    <path d="M16 12C16 9.8 14.2 8 12 8C9.8 8 8 9.8 8 12C8 14.2 9.8 16 12 16C13.7 16 15 15 16 13.8V9"/>

                                    <path d="M16 9V14C16 15.1 16.9 16 18 16C19.1 16 20 15.1 20 14V12"/>

                                </svg>

                            </span>

                            <input asp-for="KullaniciAdi"
                                   class="admin-custom-input"
                                   placeholder="Örneğin: ayse.demir"
                                   autocomplete="username"
                                   required />

                        </div>

                        <span asp-validation-for="KullaniciAdi"
                              class="admin-validation-error">
                        </span>

                    </div>

                    <!-- EMAIL -->

                    <div class="admin-field">

                        <label asp-for="Email">
                            E-posta Adresi
                        </label>

                        <div class="admin-input-wrapper">

                            <span class="admin-input-icon">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="14"
                                          rx="2"/>

                                    <path d="M4 7L12 13L20 7"/>

                                </svg>

                            </span>

                            <input asp-for="Email"
                                   type="email"
                                   class="admin-custom-input"
                                   placeholder="Örneğin: ayse@ornek.com"
                                   autocomplete="email"
                                   required />

                        </div>

                        <span asp-validation-for="Email"
                              class="admin-validation-error">
                        </span>

                    </div>

                    <!-- ŞİFRE -->

                    <div class="admin-field">

                        <label asp-for="Sifre">
                            Şifre
                        </label>

                        <div class="admin-input-wrapper">

                            <span class="admin-input-icon">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <rect x="5"
                                          y="10"
                                          width="14"
                                          height="10"
                                          rx="2"/>

                                    <path d="M8 10V7C8 4.8 9.8 3 12 3C14.2 3 16 4.8 16 7V10"/>

                                </svg>

                            </span>

                            <input asp-for="Sifre"
                                   type="password"
                                   id="adminSifre"
                                   class="admin-custom-input"
                                   placeholder="Kendi şifrenizi belirleyin"
                                   autocomplete="new-password"
                                   required />

                            <button type="button"
                                    class="admin-password-toggle"
                                    onclick="toggleAdminPassword('adminSifre', this)"
                                    aria-label="Şifreyi göster/gizle">

                                👁️

                            </button>

                        </div>

                        <span asp-validation-for="Sifre"
                              class="admin-validation-error">
                        </span>

                    </div>

                    <!-- ŞİFRE TEKRAR -->

                    <div class="admin-field">

                        <label asp-for="SifreTekrar">
                            Şifre Tekrar
                        </label>

                        <div class="admin-input-wrapper">

                            <span class="admin-input-icon">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <rect x="5"
                                          y="10"
                                          width="14"
                                          height="10"
                                          rx="2"/>

                                    <path d="M8 10V7C8 4.8 9.8 3 12 3C14.2 3 16 4.8 16 7V10"/>

                                </svg>

                            </span>

                            <input asp-for="SifreTekrar"
                                   type="password"
                                   id="adminSifreTekrar"
                                   class="admin-custom-input"
                                   placeholder="Şifrenizi tekrar girin"
                                   autocomplete="new-password"
                                   required />

                            <button type="button"
                                    class="admin-password-toggle"
                                    onclick="toggleAdminPassword('adminSifreTekrar', this)"
                                    aria-label="Şifreyi göster/gizle">

                                👁️

                            </button>

                        </div>

                        <span asp-validation-for="SifreTekrar"
                              class="admin-validation-error">
                        </span>

                    </div>

                    <!-- DOĞRULAMA KODU GÖNDER -->

                    <button type="submit"
                            class="admin-register-button">

                        📧 E-posta Adresime Doğrulama Kodu Gönder

                    </button>

                </form>
            }

            <!-- ================================================= -->
            <!-- GİRİŞE DÖN -->
            <!-- ================================================= -->

            <div class="admin-login-link">

                <span>
                    Zaten hesabınız var mı?
                </span>

                <a asp-controller="Account"
                   asp-action="AdminLogin">

                    Yönetici girişine dön

                </a>

            </div>

        </div>

    </div>

</div>

<script>

    function toggleAdminPassword(inputId, button) {

        const input = document.getElementById(inputId);

        if (input.type === "password") {

            input.type = "text";

            button.innerHTML = "🙈";

        }
        else {

            input.type = "password";

            button.innerHTML = "👁️";

        }
    }

    document.addEventListener("DOMContentLoaded", function () {

        const errors = document.querySelectorAll(
            ".auto-hide-error"
        );

        errors.forEach(function (error) {

            if (error.textContent.trim() !== "") {

                setTimeout(function () {

                    error.style.transition =
                        "opacity .25s ease";

                    error.style.opacity = "0";

                    setTimeout(function () {

                        error.style.display = "none";

