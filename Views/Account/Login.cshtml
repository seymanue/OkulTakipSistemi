@{
    ViewData["Title"] = "Giriş";

    var girisTuru = Context.Request.Query["GirisTuru"].ToString();

    bool adminGiris = girisTuru.Equals(
        "Admin",
        StringComparison.OrdinalIgnoreCase
    );
}

<style>

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(
            135deg,
            #ecfdf5 0%,
            #f8fafc 50%,
            #eef2ff 100%
        );
        color: #1e293b;
    }


    /* =========================================================
       ANA SAYFA
       ========================================================= */

    .login-page {
        width: 100%;
        min-height: calc(100vh - 70px);

        display: flex;
        justify-content: center;
        align-items: center;

        padding: 45px 20px;
    }


    .login-wrapper {
        width: 100%;
        max-width: 520px;
    }


    /* =========================================================
       ANA GİRİŞ KARTI
       ========================================================= */

    .login-card {
        width: 100%;

        background: #ffffff;

        border-radius: 24px;

        padding: 40px 35px;

        border: 1px solid rgba(226, 232, 240, 0.9);

        box-shadow:
            0 25px 50px -12px rgba(15, 23, 42, 0.12),
            0 8px 20px rgba(15, 23, 42, 0.04);
    }


    /* =========================================================
       İKON
       ========================================================= */

    .login-icon {
        width: 76px;
        height: 76px;

        margin: 0 auto 18px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 20px;

        font-size: 34px;
    }


    .teacher-icon {
        background: rgba(255, 248, 242, 0.92);
        color: #6b4b3e;

        box-shadow:
            0 8px 20px rgba(74, 48, 38, 0.08);
    }


    .admin-icon {
        background: #dbeafe;
        color: #2563eb;

        box-shadow:
            0 8px 20px rgba(37, 99, 235, 0.08);
    }


    /* =========================================================
       BAŞLIK
       ========================================================= */

    .login-title {
        text-align: center;

        margin: 0 0 8px;

        color: #1e293b;

        font-size: 27px;

        font-weight: 700;

        line-height: 1.25;
    }


    /* =========================================================
       ALT BAŞLIK
       ========================================================= */

    .subtitle-wrapper {
        width: 100%;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 10px;

        margin-bottom: 12px;
    }


    .subtitle-line {
        width: 32px;
        height: 1px;

        flex-shrink: 0;
    }


    .teacher-line {
        background: #8a6758;
    }


    .admin-line {
        background: #2563eb;
    }


    .subtitle {
        font-size: 14px;

        font-weight: 700;

        white-space: nowrap;
    }


    .teacher-text {
        color: #6b4b3e;
    }


    .admin-text {
        color: #2563eb;
    }


    /* =========================================================
       AÇIKLAMA
       ========================================================= */

    .login-description {
        margin: 0 0 24px;

        text-align: center;

        color: #64748b;

        font-size: 13px;

        line-height: 1.5;
    }


    /* =========================================================
       ALERT
       ========================================================= */

    .login-alert {
        width: 100%;

        border-radius: 10px;

        padding: 11px 13px;

        margin-bottom: 16px;

        font-size: 13px;

        line-height: 1.4;
    }


    /* =========================================================
       INPUT
       ========================================================= */

    .input-group-custom {
        position: relative;

        width: 100%;

        margin-bottom: 15px;
    }


    .input-group-custom .input-icon {
        position: absolute;

        left: 15px;
        top: 50%;

        transform: translateY(-50%);

        color: #64748b;

        z-index: 2;

        font-size: 17px;

        pointer-events: none;
    }


    .input-group-custom input {
        width: 100%;
        height: 50px;

        padding: 0 48px 0 42px;

        border: 1px solid #e2e8f0;

        border-radius: 11px;

        outline: none;

        background: #ffffff;

        color: #334155;

        font-family: inherit;

        font-size: 14px;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }


    .input-group-custom input::placeholder {
        color: #64748b;
    }


    .input-group-custom input:focus {
        border-color: #94a3b8;

        box-shadow:
            0 0 0 3px rgba(148, 163, 184, 0.12);
    }


    /* =========================================================
       ŞİFRE GÖSTER / GİZLE
       ========================================================= */

    .password-toggle {
        position: absolute;

        right: 15px;
        top: 50%;

        transform: translateY(-50%);

        width: 24px;
        height: 24px;

        display: flex;
        align-items: center;
        justify-content: center;

        color: #64748b;

        cursor: pointer;

        z-index: 5;

        user-select: none;

        font-size: 17px;

        line-height: 1;
    }


    .password-toggle:hover {
        color: #334155;
    }


    /* =========================================================
       FORM AKSİYONLARI
       ========================================================= */

    .form-actions-custom {
        width: 100%;

        display: flex;

        justify-content: space-between;

        align-items: center;

        gap: 15px;

        margin-bottom: 20px;

        font-size: 13px;
    }


    .remember-label {
        display: flex;

        align-items: center;

        gap: 6px;

        color: #475569;

        cursor: pointer;

        white-space: nowrap;
    }


    .remember-label input {
        width: auto;

        height: auto;

        cursor: pointer;
    }


    .forgot-link {
        text-decoration: none;

        font-weight: 500;

        white-space: nowrap;
    }


    .teacher-link {
        color: #6b4b3e;
    }


    .admin-link {
        color: #2563eb;
    }


    .forgot-link:hover {
        text-decoration: underline;
    }


    /* =========================================================
       GİRİŞ BUTONU
       ========================================================= */

    .login-button {
        width: 100%;
        height: 50px;

        border: none;

        border-radius: 11px;

        color: #ffffff;

        font-family: inherit;

        font-size: 15px;

        font-weight: 600;

        cursor: pointer;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        transition:
            opacity 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }


    .login-button:hover {
        opacity: 0.92;

        transform: translateY(-1px);
    }


    .teacher-button {
        background: linear-gradient(135deg, #6b4b3e, #8a6758);

        box-shadow:
            0 8px 16px rgba(74, 48, 38, 0.16);
    }


    .admin-button {
        background: #2563eb;

        box-shadow:
            0 8px 16px rgba(37, 99, 235, 0.16);
    }


    /* =========================================================
       AYIRICI
       ========================================================= */

    .divider-custom {
        width: 100%;

        display: flex;

        align-items: center;

        gap: 0;

        margin: 20px 0;

        color: #94a3b8;

        font-size: 12px;
    }


    .divider-custom::before,
    .divider-custom::after {
        content: "";

        flex: 1;

        height: 1px;

        background: #e2e8f0;
    }


    .divider-custom span {
        padding: 0 10px;

        white-space: nowrap;
    }


    /* =========================================================
       KAYIT BUTONU
       ========================================================= */

    .register-link {
        display: block;

        width: 100%;

        text-decoration: none;
    }


    .register-button {
        width: 100%;
        height: 46px;

        border-radius: 10px;

        background: #ffffff;

        font-family: inherit;

        font-size: 14px;

        font-weight: 600;

        cursor: pointer;

        display: flex;

        justify-content: center;

        align-items: center;

        gap: 8px;

        transition:
            background 0.2s ease,
            transform 0.2s ease;
    }


    .teacher-register {
        border: 1px solid rgba(107, 75, 62, 0.30);

        color: #6b4b3e;
    }


    .admin-register {
        border: 1px solid #bfdbfe;

        color: #2563eb;
    }


    .register-button:hover {
        background: #f8fafc;

        transform: translateY(-1px);
    }


    /* =========================================================
       BİLGİ KUTUSU
       ========================================================= */

    .info-box {
        width: 100%;

        display: flex;

        align-items: flex-start;

        gap: 14px;

        margin-top: 22px;

        color: #475569;

        font-size: 12px;

        line-height: 1.6;
    }


    .info-icon {
        width: 38px;
        height: 38px;

        min-width: 38px;

        border-radius: 50%;

        display: flex;

        align-items: center;

        justify-content: center;

        background: rgba(255, 248, 242, 0.90);

        color: #6b4b3e;

        font-size: 17px;
    }


    .admin-info {
        background: #dbeafe;

        color: #2563eb;
    }


    /* =========================================================
       YÖNETİCİYE GEÇİŞ
       ========================================================= */

    .admin-login-option {
        width: 100%;

        margin-top: 26px;

        text-align: center;
    }


    .admin-option-text {
        margin-bottom: 10px;

        color: #64748b;

        font-size: 14px;

        line-height: 1.4;
    }


    .admin-option-button {
        width: 100%;

        min-height: 48px;

        padding: 12px 20px;

        border: 1px solid rgba(107, 75, 62, 0.30);

        border-radius: 11px;

        background: #ffffff;

        color: #6b4b3e;

        text-decoration: none;

        font-size: 14px;

        font-weight: 700;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        transition:
            background 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }


    .admin-option-button:hover {
        background: #eff6ff;

        border-color: #93c5fd;

        transform: translateY(-1px);
    }


    /* =========================================================
       ÖĞRETMENE GERİ DÖN
       ========================================================= */

    .teacher-login-option {
        width: 100%;

        margin-top: 26px;

        text-align: center;
    }


    .teacher-option-text {
        margin-bottom: 10px;

        color: #64748b;

        font-size: 14px;
    }


    .teacher-option-button {
        width: 100%;

        min-height: 48px;

        padding: 12px 20px;

        border: 1px solid #a7f3d0;

        border-radius: 11px;

        background: #ffffff;

        color: #059669;

        text-decoration: none;

        font-size: 14px;

        font-weight: 700;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        transition:
            background 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }


    .teacher-option-button:hover {
        background: #ecfdf5;

        border-color: #6ee7b7;

        transform: translateY(-1px);
    }


    /* =========================================================
       FOOTER
       ========================================================= */

    .login-footer {
        width: 100%;

        padding: 14px 20px;

        text-align: center;

        background: #ffffff;

        border-top: 1px solid #e2e8f0;

        color: #64748b;

        font-size: 12px;

        line-height: 1.5;
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 700px) {

        .login-page {
            min-height: auto;

            padding: 30px 16px;
        }

        .login-wrapper {
            max-width: 500px;
        }

        .login-card {
            padding: 32px 25px;

            border-radius: 20px;
        }

        .login-title {
            font-size: 24px;
        }

        .login-icon {
            width: 70px;
            height: 70px;

            font-size: 31px;
        }
    }


    /* =========================================================
       TELEFON
       ========================================================= */

    @@media (max-width: 500px) {

        .login-page {
            padding: 20px 12px;
        }

        .login-card {
            padding: 28px 18px;

            border-radius: 18px;
        }

        .login-title {
            font-size: 23px;
        }

        .subtitle {
            font-size: 13px;
        }

        .subtitle-line {
            width: 22px;
        }

        .form-actions-custom {
            flex-direction: column;

            align-items: flex-start;

            gap: 10px;
        }

        .forgot-link {
            align-self: flex-end;
        }

        .info-box {
            font-size: 11.5px;
        }

        .admin-option-button,
        .teacher-option-button {
            font-size: 13px;
        }
    }



    /* =========================================================
       ÖĞRETMEN VİDEOSUNU TAM EKRAN YAP
       ========================================================= */

    .login-page:has(.teacher-video-page) {
        display: block;
        width: 100%;
        min-height: calc(100vh - 70px);
        padding: 0;
    }

    .login-wrapper:has(.teacher-video-page) {
        width: 100%;
        max-width: none;
        min-height: calc(100vh - 70px);
    }


    /* =========================================================
       ÖĞRETMEN GİRİŞİ - VİDEOLU ARKA PLAN
       ========================================================= */

    .teacher-video-page {
        position: relative;
        width: 100%;
        min-height: calc(100vh - 70px);

        display: flex;
        align-items: center;
        justify-content: flex-end;

        padding: 40px 8%;

        overflow: hidden;
    }


    .teacher-background-video {
        position: absolute;
        inset: 0;

        z-index: 0;
    }


    .teacher-background-video video {
        width: 100%;
        height: 100%;

        object-fit: cover;

        display: block;
    }


    .teacher-video-overlay {
        background:
            linear-gradient(
                90deg,
                rgba(45, 31, 25, 0.08) 0%,
                rgba(92, 57, 39, 0.18) 35%,
                rgba(126, 76, 47, 0.32) 58%,
                rgba(76, 48, 37, 0.72) 100%
            );

    }


    .teacher-login-wrapper {
        position: relative;

        z-index: 2;

        width: 100%;
        max-width: 520px;
    }


    .teacher-login-wrapper .login-card {
        background: rgba(255, 255, 255, 0.82);

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        border: 1px solid rgba(255, 255, 255, 0.65);

        box-shadow:
            0 25px 60px rgba(0, 0, 0, 0.30);
    }


    .teacher-login-wrapper .admin-login-option {
        margin-bottom: 20px;
    }


    @@media (max-width: 700px) {

        .teacher-video-page {
            justify-content: center;

            padding: 30px 20px;
        }

    }




    /* =========================================================
       ÖĞRETMEN GİRİŞİ - TAM EKRAN VİDEO DÜZELTMESİ
       ========================================================= */

    html,
    body {
        width: 100%;
        min-height: 100%;
        margin: 0;
        padding: 0;
    }

    body:has(.teacher-video-page) {
        overflow: hidden;
        background: #000;
    }

    .login-page:has(.teacher-video-page) {
        width: 100%;
        min-height: 100vh;
        margin: 0;
        padding: 0;
        display: block;
        background: transparent;
    }

    .login-wrapper:has(.teacher-video-page) {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0;
    }

    .teacher-video-page {
        position: fixed !important;

        inset: 0 !important;

        width: 100vw !important;
        height: 100vh !important;
        min-height: 100vh !important;

        margin: 0 !important;
        padding: 40px 7% !important;

        display: flex !important;
        align-items: center !important;
        justify-content: flex-end !important;

        overflow: hidden !important;

        background: #000;

        z-index: 999;
    }

    .teacher-background-video {
        position: absolute !important;

        inset: 0 !important;

        width: 100% !important;
        height: 100% !important;

        z-index: 0 !important;

        overflow: hidden;
    }

    .teacher-background-video video {
        position: absolute;

        inset: 0;

        width: 100% !important;
        height: 100% !important;

        object-fit: cover !important;
        object-position: center center;

        display: block;
    }

    .teacher-video-overlay {
        position: absolute !important;

        inset: 0 !important;

        background: rgba(0, 0, 0, 0.18) !important;

        z-index: 1 !important;
    }

    .teacher-login-wrapper {
        position: relative;

        width: 100% !important;
        max-width: 520px !important;

        z-index: 2 !important;
    }

    .teacher-login-wrapper .login-card {
        width: 100%;

        background: rgba(255, 255, 255, 0.24) !important;

        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);

        border: 1px solid rgba(255, 255, 255, 0.35) !important;

        box-shadow:
            0 25px 70px rgba(0, 0, 0, 0.28) !important;
    }

    .teacher-login-wrapper .admin-login-option {
        position: relative;
        z-index: 3;
    }

    .login-footer:has(+ *) {
        display: none;
    }

    @@media (max-width: 700px) {

        body:has(.teacher-video-page) {
            overflow-y: auto;
        }

        .teacher-video-page {
            position: relative !important;

            min-height: 100vh !important;
            height: auto !important;

            padding: 25px 20px !important;

            justify-content: center !important;
        }

        .teacher-login-wrapper {
            max-width: 100% !important;
        }

    }



    /* =========================================================
       ÖĞRETMEN GİRİŞİ - SON YERLEŞİM AYARI
       ========================================================= */

    .teacher-video-page {
        justify-content: flex-end !important;
        padding-right: 9% !important;
    }

    .teacher-login-wrapper {
        max-width: 460px !important;
    }

    .teacher-login-wrapper .login-card {
        padding: 32px 30px !important;
        border-radius: 26px !important;

        background: rgba(255, 255, 255, 0.30) !important;

        box-shadow:
            0 25px 70px rgba(0, 0, 0, 0.32) !important;
    }

    /* Yönetici giriş bölümü */

    .teacher-login-wrapper .admin-login-option {
        margin-top: 14px !important;
        margin-bottom: 0 !important;

        text-align: center;

        color: white;
    }

    .teacher-login-wrapper .admin-option-text {
        margin-bottom: 8px !important;

        color: rgba(255, 255, 255, 0.85) !important;
    }

    .teacher-login-wrapper .admin-option-button {
        width: 100% !important;

        background: rgba(255, 255, 255, 0.82) !important;

        border-radius: 14px !important;

        padding: 14px 20px !important;
    }

    /* Kart içindeki elemanları biraz kompakt yap */

    .teacher-login-wrapper .login-icon {
        width: 68px !important;
        height: 68px !important;

        margin-bottom: 14px !important;
    }

    .teacher-login-wrapper .login-title {
        font-size: 27px !important;
    }

    .teacher-login-wrapper .login-description {
        margin-bottom: 22px !important;
    }

    @@media (max-width: 700px) {

        .teacher-video-page {
            padding: 25px 18px !important;
        }

        .teacher-login-wrapper {
            max-width: 100% !important;
        }

        .teacher-login-wrapper .login-card {
            padding: 28px 20px !important;
        }
    }




    /* =========================================================
       ÖĞRETMEN VİDEO TASARIMI - SON DÜZENLEME
       ========================================================= */

    body:has(.teacher-video-page) {
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
        background: #000 !important;
    }

    body:has(.teacher-video-page) .login-page {
        margin: 0 !important;
        padding: 0 !important;
        min-height: 100vh !important;
        width: 100% !important;
        background: transparent !important;
    }

