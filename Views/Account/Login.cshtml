@{
    ViewData["Title"] = "Giriş";

    var girisTuru = Context.Request.Query["GirisTuru"].ToString();

    bool adminGiris = girisTuru.Equals(
        "Admin",
        StringComparison.OrdinalIgnoreCase
    );
}

<style>

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(
            135deg,
            #ecfdf5 0%,
            #f8fafc 50%,
            #eef2ff 100%
        );
        color: #1e293b;
    }


    /* =========================================================
       ANA SAYFA
       ========================================================= */

    .login-page {
        width: 100%;
        min-height: calc(100vh - 70px);

        display: flex;
        justify-content: center;
        align-items: center;

        padding: 45px 20px;
    }


    .login-wrapper {
        width: 100%;
        max-width: 520px;
    }


    /* =========================================================
       ANA GİRİŞ KARTI
       ========================================================= */

    .login-card {
        width: 100%;

        background: #ffffff;

        border-radius: 24px;

        padding: 40px 35px;

        border: 1px solid rgba(226, 232, 240, 0.9);

        box-shadow:
            0 25px 50px -12px rgba(15, 23, 42, 0.12),
            0 8px 20px rgba(15, 23, 42, 0.04);
    }


    /* =========================================================
       İKON
       ========================================================= */

    .login-icon {
        width: 76px;
        height: 76px;

        margin: 0 auto 18px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 20px;

        font-size: 34px;
    }


    .teacher-icon {
        background: #d1fae5;
        color: #059669;

        box-shadow:
            0 8px 20px rgba(5, 150, 105, 0.08);
    }


    .admin-icon {
        background: #dbeafe;
        color: #2563eb;

        box-shadow:
            0 8px 20px rgba(37, 99, 235, 0.08);
    }


    /* =========================================================
       BAŞLIK
       ========================================================= */

    .login-title {
        text-align: center;

        margin: 0 0 8px;

        color: #1e293b;

        font-size: 27px;

        font-weight: 700;

        line-height: 1.25;
    }


    /* =========================================================
       ALT BAŞLIK
       ========================================================= */

    .subtitle-wrapper {
        width: 100%;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 10px;

        margin-bottom: 12px;
    }


    .subtitle-line {
        width: 32px;
        height: 1px;

        flex-shrink: 0;
    }


    .teacher-line {
        background: #059669;
    }


    .admin-line {
        background: #2563eb;
    }


    .subtitle {
        font-size: 14px;

        font-weight: 700;

        white-space: nowrap;
    }


    .teacher-text {
        color: #059669;
    }


    .admin-text {
        color: #2563eb;
    }


    /* =========================================================
       AÇIKLAMA
       ========================================================= */

    .login-description {
        margin: 0 0 24px;

        text-align: center;

        color: #64748b;

        font-size: 13px;

        line-height: 1.5;
    }


    /* =========================================================
       ALERT
       ========================================================= */

    .login-alert {
        width: 100%;

        border-radius: 10px;

        padding: 11px 13px;

        margin-bottom: 16px;

        font-size: 13px;

        line-height: 1.4;
    }


    /* =========================================================
       INPUT
       ========================================================= */

    .input-group-custom {
        position: relative;

        width: 100%;

        margin-bottom: 15px;
    }


    .input-group-custom .input-icon {
        position: absolute;

        left: 15px;
        top: 50%;

        transform: translateY(-50%);

        color: #64748b;

        z-index: 2;

        font-size: 17px;

        pointer-events: none;
    }


    .input-group-custom input {
        width: 100%;
        height: 50px;

        padding: 0 48px 0 42px;

        border: 1px solid #e2e8f0;

        border-radius: 11px;

        outline: none;

        background: #ffffff;

        color: #334155;

        font-family: inherit;

        font-size: 14px;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }


    .input-group-custom input::placeholder {
        color: #64748b;
    }


    .input-group-custom input:focus {
        border-color: #94a3b8;

        box-shadow:
            0 0 0 3px rgba(148, 163, 184, 0.12);
    }


    /* =========================================================
       ŞİFRE GÖSTER / GİZLE
       ========================================================= */

    .password-toggle {
        position: absolute;

        right: 15px;
        top: 50%;

        transform: translateY(-50%);

        width: 24px;
        height: 24px;

        display: flex;
        align-items: center;
        justify-content: center;

        color: #64748b;

        cursor: pointer;

        z-index: 5;

        user-select: none;

        font-size: 17px;

        line-height: 1;
    }


    .password-toggle:hover {
        color: #334155;
    }


    /* =========================================================
       FORM AKSİYONLARI
       ========================================================= */

    .form-actions-custom {
        width: 100%;

        display: flex;

        justify-content: space-between;

        align-items: center;

        gap: 15px;

        margin-bottom: 20px;

        font-size: 13px;
    }


    .remember-label {
        display: flex;

        align-items: center;

        gap: 6px;

        color: #475569;

        cursor: pointer;

        white-space: nowrap;
    }


    .remember-label input {
        width: auto;

        height: auto;

        cursor: pointer;
    }


    .forgot-link {
        text-decoration: none;

        font-weight: 500;

        white-space: nowrap;
    }


    .teacher-link {
        color: #059669;
    }


    .admin-link {
        color: #2563eb;
    }


    .forgot-link:hover {
        text-decoration: underline;
    }


    /* =========================================================
       GİRİŞ BUTONU
       ========================================================= */

    .login-button {
        width: 100%;
        height: 50px;

        border: none;

        border-radius: 11px;

        color: #ffffff;

        font-family: inherit;

        font-size: 15px;

        font-weight: 600;

        cursor: pointer;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        transition:
            opacity 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }


    .login-button:hover {
        opacity: 0.92;

        transform: translateY(-1px);
    }


    .teacher-button {
        background: #059669;

        box-shadow:
            0 8px 16px rgba(5, 150, 105, 0.16);
    }


    .admin-button {
        background: #2563eb;

        box-shadow:
            0 8px 16px rgba(37, 99, 235, 0.16);
    }


    /* =========================================================
       AYIRICI
       ========================================================= */

    .divider-custom {
        width: 100%;

        display: flex;

        align-items: center;

        gap: 0;

        margin: 20px 0;

        color: #94a3b8;

        font-size: 12px;
    }


    .divider-custom::before,
    .divider-custom::after {
        content: "";

        flex: 1;

        height: 1px;

        background: #e2e8f0;
    }


    .divider-custom span {
        padding: 0 10px;

        white-space: nowrap;
    }


    /* =========================================================
       KAYIT BUTONU
       ========================================================= */

    .register-link {
        display: block;

        width: 100%;

        text-decoration: none;
    }


    .register-button {
        width: 100%;
        height: 46px;

        border-radius: 10px;

        background: #ffffff;

        font-family: inherit;

        font-size: 14px;

        font-weight: 600;

        cursor: pointer;

        display: flex;

        justify-content: center;

        align-items: center;

        gap: 8px;

        transition:
            background 0.2s ease,
            transform 0.2s ease;
    }


    .teacher-register {
        border: 1px solid #a7f3d0;

        color: #059669;
    }


    .admin-register {
        border: 1px solid #bfdbfe;

        color: #2563eb;
    }


    .register-button:hover {
        background: #f8fafc;

        transform: translateY(-1px);
    }


    /* =========================================================
       BİLGİ KUTUSU
       ========================================================= */

    .info-box {
        width: 100%;

        display: flex;

        align-items: flex-start;

        gap: 14px;

        margin-top: 22px;

        color: #475569;

        font-size: 12px;

        line-height: 1.6;
    }


    .info-icon {
        width: 38px;
        height: 38px;

        min-width: 38px;

        border-radius: 50%;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #d1fae5;

        color: #059669;

        font-size: 17px;
    }


    .admin-info {
        background: #dbeafe;

        color: #2563eb;
    }


    /* =========================================================
       YÖNETİCİYE GEÇİŞ
       ========================================================= */

    .admin-login-option {
        width: 100%;

        margin-top: 26px;

        text-align: center;
    }


    .admin-option-text {
        margin-bottom: 10px;

        color: #64748b;

        font-size: 14px;

        line-height: 1.4;
    }


    .admin-option-button {
        width: 100%;

        min-height: 48px;

        padding: 12px 20px;

        border: 1px solid #bfdbfe;

        border-radius: 11px;

        background: #ffffff;

        color: #2563eb;

        text-decoration: none;

        font-size: 14px;

        font-weight: 700;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        transition:
            background 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }


    .admin-option-button:hover {
        background: #eff6ff;

        border-color: #93c5fd;

        transform: translateY(-1px);
    }


    /* =========================================================
       ÖĞRETMENE GERİ DÖN
       ========================================================= */

    .teacher-login-option {
        width: 100%;

        margin-top: 26px;

        text-align: center;
    }


    .teacher-option-text {
        margin-bottom: 10px;

        color: #64748b;

        font-size: 14px;
    }


    .teacher-option-button {
        width: 100%;

        min-height: 48px;

        padding: 12px 20px;

        border: 1px solid #a7f3d0;

        border-radius: 11px;

        background: #ffffff;

        color: #059669;

        text-decoration: none;

        font-size: 14px;

        font-weight: 700;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        transition:
            background 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }


    .teacher-option-button:hover {
        background: #ecfdf5;

        border-color: #6ee7b7;

        transform: translateY(-1px);
    }


    /* =========================================================
       FOOTER
       ========================================================= */

    .login-footer {
        width: 100%;

        padding: 14px 20px;

        text-align: center;

        background: #ffffff;

        border-top: 1px solid #e2e8f0;

        color: #64748b;

        font-size: 12px;

        line-height: 1.5;
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 700px) {

        .login-page {
            min-height: auto;

            padding: 30px 16px;
        }

        .login-wrapper {
            max-width: 500px;
        }

        .login-card {
            padding: 32px 25px;

            border-radius: 20px;
        }

        .login-title {
            font-size: 24px;
        }

        .login-icon {
            width: 70px;
            height: 70px;

            font-size: 31px;
        }
    }


    /* =========================================================
       TELEFON
       ========================================================= */

    @@media (max-width: 500px) {

        .login-page {
            padding: 20px 12px;
        }

        .login-card {
            padding: 28px 18px;

            border-radius: 18px;
        }

        .login-title {
            font-size: 23px;
        }

        .subtitle {
            font-size: 13px;
        }

        .subtitle-line {
            width: 22px;
        }

        .form-actions-custom {
            flex-direction: column;

            align-items: flex-start;

            gap: 10px;
        }

        .forgot-link {
            align-self: flex-end;
        }

        .info-box {
            font-size: 11.5px;
        }

        .admin-option-button,
        .teacher-option-button {
            font-size: 13px;
        }
    }

</style>


<div class="login-page">

    <div class="login-wrapper">


        @if (!adminGiris)
        {
            <!-- =================================================
                 ÖĞRETMEN GİRİŞİ
                 ================================================= -->

            <div class="login-card">

                <div class="login-icon teacher-icon">
                    📖
                </div>


                <h1 class="login-title">
                    Okul Takip Sistemi
                </h1>


                <div class="subtitle-wrapper">

                    <div class="subtitle-line teacher-line"></div>

                    <div class="subtitle teacher-text">
                        Öğretmen Giriş Paneli
                    </div>

                    <div class="subtitle-line teacher-line"></div>

                </div>


                <p class="login-description">
                    Öğretmen hesabınızla giriş yapın
                </p>


                @if (ViewBag.Hata != null)
                {
                    <div class="alert alert-danger login-alert">
                        @ViewBag.Hata
                    </div>
                }


                @if (TempData["Basari"] != null)
                {
                    <div class="alert alert-success login-alert">
                        @TempData["Basari"]
                    </div>
                }


                <form method="post"
                      action="/Account/Login"
                      autocomplete="off">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="GirisTuru"
                           value="Ogretmen" />


                    <!-- KULLANICI ADI -->

                    <div class="input-group-custom">

                        <span class="input-icon">
                            👤
                        </span>

                        <input type="text"
                               name="KullaniciAdi"
                               placeholder="Kullanıcı adı"
                               autocomplete="username"
                               required />

                    </div>


                    <!-- ŞİFRE -->

                    <div class="input-group-custom">

                        <span class="input-icon">
                            🔒
                        </span>

                        <input type="password"
                               id="teacherPassword"
                               name="Sifre"
                               placeholder="Şifre"
                               autocomplete="current-password"
                               required />

                        <span class="password-toggle"
                              onclick="togglePassword('teacherPassword', this)"
                              title="Şifreyi göster">

                            👁

                        </span>

                    </div>


                    <!-- AKSİYONLAR -->

                    <div class="form-actions-custom">

                        <label class="remember-label">

                            <input type="checkbox"
                                   name="BeniHatirla"
                                   value="true" />

                            <span>
                                Beni Hatırla
                            </span>

                        </label>


                        <a href="/Account/SifremiUnuttum?GirisTuru=Ogretmen"
                           class="forgot-link teacher-link">

                            Şifremi unuttum?

                        </a>

                    </div>


                    <!-- GİRİŞ -->

                    <button type="submit"
                            class="login-button teacher-button">

                        <span>➜</span>

                        <span>Giriş Yap</span>

                    </button>

                </form>


                <!-- AYIRICI -->

                <div class="divider-custom">

                    <span>
                        veya
                    </span>

                </div>


                <!-- ÖĞRETMEN KAYDI -->

                <a href="/Account/Register"
                   class="register-link">

                    <button type="button"
                            class="register-button teacher-register">

                        <span>＋</span>

                        <span>Öğretmen Kaydı</span>

                    </button>

                </a>


                <!-- BİLGİ -->

                <div class="info-box">

                    <div class="info-icon">
                        🎓
                    </div>

                    <div>

                        Öğretmen paneli ile size atanan sınıfları
                        görüntüleyebilir, öğrencileri görebilir ve
                        yoklama alabilirsiniz.

                    </div>

                </div>

            </div>


            <!-- =================================================
                 YÖNETİCİYE GEÇİŞ
                 ================================================= -->

            <div class="admin-login-option">

                <div class="admin-option-text">
                    Yönetici misiniz?
                </div>


                <a href="/Account/AdminLogin"
                   class="admin-option-button">

                    <span>🛡️</span>

                    <span>Yönetici Giriş Paneli</span>

                </a>

            </div>
        }


        @if (adminGiris)
        {
            <!-- =================================================
                 YÖNETİCİ GİRİŞİ
                 ================================================= -->

            <div class="login-card">

                <div class="login-icon admin-icon">
                    🛡️
                </div>


                <h1 class="login-title">
                    Okul Takip Sistemi
                </h1>


                <div class="subtitle-wrapper">

                    <div class="subtitle-line admin-line"></div>

                    <div class="subtitle admin-text">
                        Yönetici Giriş Paneli
                    </div>

                    <div class="subtitle-line admin-line"></div>

                </div>


                <p class="login-description">
                    Yönetici hesabınızla giriş yapın
                </p>


                @if (ViewBag.Hata != null)
                {
                    <div class="alert alert-danger login-alert">
                        @ViewBag.Hata
                    </div>
                }


                @if (TempData["Basari"] != null)
                {
                    <div class="alert alert-success login-alert">
                        @TempData["Basari"]
                    </div>
                }


                <form method="post"
                      action="/Account/Login"
                      autocomplete="off">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="GirisTuru"
                           value="Admin" />


                    <!-- KULLANICI ADI -->

                    <div class="input-group-custom">

                        <span class="input-icon">
                            👤
                        </span>

                        <input type="text"
                               name="KullaniciAdi"
                               placeholder="Kullanıcı adı"
                               autocomplete="username"
                               required />

                    </div>


                    <!-- ŞİFRE -->

                    <div class="input-group-custom">

                        <span class="input-icon">
                            🔒
                        </span>

                        <input type="password"
                               id="adminPassword"
                               name="Sifre"
                               placeholder="Şifre"
                               autocomplete="current-password"
                               required />

                        <span class="password-toggle"
                              onclick="togglePassword('adminPassword', this)"
                              title="Şifreyi göster">

                            👁

                        </span>

                    </div>


                    <!-- AKSİYONLAR -->

                    <div class="form-actions-custom">

                        <label class="remember-label">

                            <input type="checkbox"
                                   name="BeniHatirla"
                                   value="true" />

                            <span>
                                Beni Hatırla
                            </span>

                        </label>


                        <a href="/Account/SifremiUnuttum?GirisTuru=Admin"
                           class="forgot-link admin-link">

                            Şifremi unuttum?

                        </a>

                    </div>


                    <!-- GİRİŞ -->

                    <button type="submit"
                            class="login-button admin-button">

                        <span>➜</span>

                        <span>Giriş Yap</span>

                    </button>

                </form>


                <!-- AYIRICI -->

                <div class="divider-custom">

                    <span>
                        veya
                    </span>

                </div>


                <!-- YÖNETİCİ KAYDI -->

                <a href="/Account/AdminRegister"
                   class="register-link">

                    <button type="button"
                            class="register-button admin-register">

                        <span>＋</span>

                        <span>Yönetici Kaydı</span>

                    </button>

                </a>


                <!-- BİLGİ -->

                <div class="info-box">

                    <div class="info-icon admin-info">
                        ⭐
                    </div>

                    <div>

                        Yönetici paneli ile okul, öğrenci,
                        öğretmen, ücret, ödeme, borç ve tüm
                        işlemleri yönetebilirsiniz.

                    </div>

                </div>

            </div>


            <!-- =================================================
                 ÖĞRETMENE GERİ DÖN
                 ================================================= -->

            <div class="teacher-login-option">

                <div class="teacher-option-text">
                    Öğretmen misiniz?
                </div>


                <a href="/Account/Login"
                   class="teacher-option-button">

                    <span>📖</span>

                    <span>Öğretmen Giriş Paneli</span>

                </a>

            </div>
        }

    </div>

</div>


<footer class="login-footer">

    🛡️ © 2026 Okul Takip Sistemi. Tüm hakları saklıdır.

</footer>


<script>

    function togglePassword(inputId, icon) {

        const input = document.getElementById(inputId);

        if (!input) {
            return;
        }


        if (input.type === "password") {

            input.type = "text";

            icon.textContent = "🙈";

            icon.setAttribute(
                "title",
                "Şifreyi gizle"
            );

        }
        else {

            input.type = "password";

            icon.textContent = "👁";

            icon.setAttribute(
                "title",
                "Şifreyi göster"
            );

        }

    }

</script>