        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        max-width: none !important;
    }

    body:has(.teacher-video-page) .login-footer {
        display: none !important;
    }


    .teacher-video-page {
        position: fixed !important;

        top: 0 !important;
