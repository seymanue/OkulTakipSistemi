@{
    ViewData["Title"] = "E-posta Doğrulama";

    string girisTuru = ViewBag.GirisTuru ?? "Ogretmen";
    bool adminMi = girisTuru == "Admin";
}

<style>
html, body {
    margin: 0;
    padding: 0;
}

body:has(.verify-page) {
    background: #493735 !important;
}

body:has(.verify-page) header,
body:has(.verify-page) nav {
    background: rgba(67, 43, 35, 0.96) !important;
    border-color: rgba(255,255,255,0.08) !important;
}

.verify-page {
    width: 100vw;
    min-height: calc(100vh - 64px);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px 20px;
    overflow: hidden;
    background:
        radial-gradient(
            ellipse at 10% 18%,
            rgba(226, 164, 104, 0.34),
            transparent 38%
        ),
        radial-gradient(
            ellipse at 88% 78%,
            rgba(73, 43, 35, 0.48),
            transparent 45%
        ),
        linear-gradient(
            120deg,
            #b87952 0%,
            #956049 42%,
            #67463d 72%,
            #493735 100%
        );
}

.verify-card {
    width: min(460px, 100%);
    box-sizing: border-box;
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,0.22);
    background: rgba(67, 43, 35, 0.58);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow:
        0 24px 60px rgba(35, 22, 18, 0.38),
        inset 0 1px 0 rgba(255,255,255,0.14);
}

.verify-header {
    padding: 25px 30px 20px;
    text-align: center;
    color: #fff8f2;
    background:
        linear-gradient(
            145deg,
            rgba(126, 78, 55, 0.82),
            rgba(91, 57, 45, 0.78)
        );
    border-bottom: 1px solid rgba(255,255,255,0.12);
}

.verify-icon {
    width: 68px;
    height: 68px;
    margin: 0 auto 12px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #e6b47c;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.16);
    box-shadow:
        0 8px 20px rgba(45, 27, 21, 0.22),
        inset 0 1px 0 rgba(255,255,255,0.12);
}

.verify-icon svg {
    width: 42px;
    height: 42px;
}

.verify-header h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    color: #fff8f2;
}

.verify-header p {
    margin: 7px 0 0;
    color: rgba(255,248,242,0.82);
    font-size: 13px;
    line-height: 1.5;
}

.verify-body {
    padding: 25px 30px 26px;
    background: rgba(50, 34, 29, 0.34);
}

.alert {
    padding: 11px 13px;
    border-radius: 11px;
    margin-bottom: 17px;
    font-size: 13px;
}

.alert-danger {
    background: rgba(127, 42, 32, 0.35);
    color: #ffd5cc;
    border: 1px solid rgba(255,150,130,0.25);
}

.field {
    margin-bottom: 18px;
}

.field label {
    display: block;
    margin-bottom: 7px;
    font-weight: 600;
    color: #f5dfcf;
}

.code-input {
    width: 100%;
    height: 56px;
    box-sizing: border-box;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 12px;
    padding: 0 15px;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 8px;
    text-align: center;
    color: #fff8f2;
    outline: none;
    background: rgba(255,255,255,0.10);
    transition: 0.2s;
}

.code-input::placeholder {
    color: rgba(255,242,232,0.42);
    font-size: 15px;
    letter-spacing: normal;
    font-weight: 400;
}

.code-input:focus {
    border-color: rgba(226,164,104,0.75);
    box-shadow: 0 0 0 3px rgba(226,164,104,0.14);
    background: rgba(255,255,255,0.13);
}

.verify-button {
    width: 100%;
    height: 48px;
    border: none;
    border-radius: 12px;
    background: linear-gradient(135deg, #b87952, #8f5a43);
    color: #fffaf6;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(57, 34, 27, 0.28);
    transition: 0.2s;
}

.verify-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(57, 34, 27, 0.36);
}

.back-link {
    display: block;
    margin-top: 18px;
    text-align: center;
    color: #e7b47f;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
}

.back-link:hover {
    color: #f2c99f;
    text-decoration: underline;
}

.verify-page {
    position: relative;
    isolation: isolate;
}

.verify-page::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.20;
    pointer-events: none;

    background-image:
        radial-gradient(circle at 12% 20%, rgba(255,235,215,0.55) 0 2px, transparent 3px),
        radial-gradient(circle at 82% 16%, rgba(255,235,215,0.45) 0 2px, transparent 3px),
        radial-gradient(circle at 25% 78%, rgba(255,235,215,0.40) 0 2px, transparent 3px),
        radial-gradient(circle at 75% 82%, rgba(255,235,215,0.40) 0 2px, transparent 3px),
        linear-gradient(135deg, transparent 0 48%, rgba(255,255,255,0.08) 49% 50%, transparent 51%),
        linear-gradient(45deg, transparent 0 48%, rgba(255,255,255,0.06) 49% 50%, transparent 51%);

    background-size:
        180px 180px,
        220px 220px,
        200px 200px,
        240px 240px,
        90px 90px,
        90px 90px;

    background-position:
        0 0,
        70px 30px,
        30px 100px,
        120px 80px,
        0 0,
        0 0;
}

.verify-page::after {
    content: "✦   □   ✎       ✦       ◇   ✦       □   ✎       ✦";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 42px;
    letter-spacing: 34px;
    line-height: 150px;
    color: rgba(255, 226, 201, 0.13);
    transform: rotate(-8deg) scale(1.15);
    white-space: normal;
}

@@media (max-width: 576px) {
    .verify-page {
        min-height: calc(100vh - 58px);
        padding: 18px 14px;
    }

    .verify-card {
        border-radius: 20px;
    }

    .verify-header {
        padding: 21px 20px 17px;
    }

    .verify-body {
        padding: 21px 20px 22px;
    }

    .code-input {
        font-size: 21px;
        letter-spacing: 6px;
    }
}
</style>

<div class="verify-page">

    <div class="verify-card">

        <div class="verify-header">

            <div class="verify-icon">
                <svg viewBox="0 0 64 64"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg"
                     aria-hidden="true">

                    <rect x="9" y="15"
                          width="46"
                          height="34"
                          rx="6"
                          stroke="currentColor"
                          stroke-width="3"/>

                    <path d="M11 19L29 34C30.8 35.5 33.2 35.5 35 34L53 19"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>

                    <circle cx="46" cy="45"
                            r="10"
                            fill="#493735"
                            stroke="currentColor"
                            stroke-width="3"/>

                    <path d="M46 40V46"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"/>

                    <circle cx="46" cy="50"
                            r="1.5"
                            fill="currentColor"/>
                </svg>
            </div>

            <h2>E-posta Doğrulama</h2>

            <p>
                E-posta adresinize gönderilen 6 haneli
                doğrulama kodunu giriniz.
            </p>

        </div>

        <div class="verify-body">

            @if (ViewBag.Hata != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Hata
                </div>
            }

            <form asp-controller="Account"
                  asp-action="SifreDogrula"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="GirisTuru"
                       value="@girisTuru" />

                <div class="field">

                    <label for="Kod">
                        Doğrulama Kodu
                    </label>

                    <input type="text"
                           id="Kod"
                           name="Kod"
                           class="code-input"
                           maxlength="6"
                           minlength="6"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           placeholder="6 haneli kod"
                           required />

                </div>

                <button type="submit"
                        class="verify-button">
                    Kodu Doğrula
                </button>

            </form>

            @if (adminMi)
            {
                <a asp-controller="Account"
                   asp-action="AdminLogin"
                   class="back-link">
                    ← Yönetici girişine dön
                </a>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="back-link">
                    ← Öğretmen girişine dön
                </a>
            }

        </div>

    </div>

</div>
