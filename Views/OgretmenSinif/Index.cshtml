@model IEnumerable<OkulTakipSistemi.Models.OgretmenSinif>

@{
    ViewData["Title"] = "Öğretmen-Sınıf Atamaları";
}

<style>
    .os-page {
        min-height: calc(100vh - 80px);
        padding: 30px 32px 50px;
        background: #f4f7fb;
    }

    .os-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .os-title {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .os-icon {
        width: 56px;
        height: 56px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 26px;
        background: linear-gradient(135deg, #60a5fa, #2563eb, #1e3a8a);
        box-shadow: 0 8px 20px rgba(37, 99, 235, .18);
    }

    .os-title h2 {
        margin: 0;
        color: #172554;
        font-size: 26px;
        font-weight: 750;
    }

    .os-title p {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 13px;
    }

    .os-add {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 43px;
        padding: 0 17px;
        border-radius: 11px;
        background: linear-gradient(135deg, #2563eb, #1e3a8a);
        color: #fff !important;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 7px 18px rgba(37, 99, 235, .20);
        transition: all .2s ease;
    }

    .os-add:hover {
        color: #fff !important;
        transform: translateY(-2px);
        box-shadow: 0 10px 23px rgba(37, 99, 235, .28);
    }

    .os-card {
        background: #fff;
        border: 1px solid #dbeafe;
        border-radius: 19px;
        overflow: hidden;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .055);
    }

    .os-card-head {
        min-height: 62px;
        padding: 0 21px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        background: linear-gradient(135deg, #f8fbff, #eff6ff);
        border-bottom: 1px solid #dbeafe;
    }

    .os-card-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #1e3a8a;
        font-size: 14px;
        font-weight: 750;
    }

    .os-card-title-icon {
        width: 29px;
        height: 29px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #dbeafe;
        font-size: 15px;
    }

    .os-count {
        padding: 5px 11px;
        border-radius: 20px;
        background: #dbeafe;
        color: #1d4ed8;
        font-size: 11px;
        font-weight: 750;
        white-space: nowrap;
    }

    .os-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .os-table {
        width: 100%;
        min-width: 850px;
        margin: 0;
        border-collapse: collapse;
    }

    .os-table th {
        padding: 13px 18px;
        background: #fbfdff;
        border-bottom: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 11px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .04em;
        white-space: nowrap;
        text-align: left;
    }

    .os-table td {
        padding: 15px 18px;
        border-bottom: 1px solid #eef2f7;
        color: #334155;
        font-size: 13px;
        vertical-align: middle;
    }

    .os-table tbody tr {
        transition: background .18s ease;
    }

    .os-table tbody tr:hover {
        background: #f8fbff;
    }

    .os-table tbody tr:last-child td {
        border-bottom: none;
    }
    .os-teacher {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #1e293b !important;
        font-weight: 700;
        white-space: nowrap;
    }

    .os-avatar {
        width: 37px;
        height: 37px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: linear-gradient(135deg, #dbeafe, #bfdbfe);
        color: #1d4ed8;
        font-size: 13px;
        font-weight: 800;
    }

    .os-class {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 8px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        color: #1d4ed8;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .os-school {
        color: #475569 !important;
        font-weight: 600;
        white-space: nowrap;
    }

    .os-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .os-edit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 10px;
        border-radius: 9px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        color: #1d4ed8 !important;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        transition: all .2s ease;
    }

    .os-edit:hover {
        background: #dbeafe;
        transform: translateY(-1px);
    }

    .os-delete {
        border: 1px solid #fecaca;
        padding: 7px 10px;
        border-radius: 9px;
        background: #fef2f2;
        color: #b91c1c;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s ease;
    }

    .os-delete:hover {
        background: #fee2e2;
        transform: translateY(-1px);
    }

    .os-empty {
        padding: 50px 20px !important;
        text-align: center;
        color: #94a3b8 !important;
    }

    .os-empty-icon {
        display: block;
        margin-bottom: 9px;
        font-size: 31px;
    }

    .os-back {
        margin-top: 18px;
    }

    .os-back a {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        border-radius: 9px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #64748b !important;
        text-decoration: none;
        font-size: 12px;
        font-weight: 650;
        transition: all .2s ease;
    }

    .os-back a:hover {
        background: #eff6ff;
        border-color: #dbeafe;
        color: #1d4ed8 !important;
        transform: translateY(-1px);
    }

    @@media (max-width: 700px) {
        .os-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .os-add {
            width: 100%;
        }

        .os-title h2 {
            font-size: 23px;
        }
    }

    .page-title-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
        padding: 26px 30px;
        border: 1px solid #d9eaf8;
        border-radius: 20px;
        background: linear-gradient(135deg, #eaf5ff 0%, #d8ecff 55%, #c7e3fb 100%);
        box-shadow: 0 8px 25px rgba(26, 64, 99, 0.07);
    }

    .page-title-content {
        display: flex;
        align-items: center;
        gap: 17px;
        min-width: 0;
    }

    .page-title-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 54px;
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 5px 15px rgba(25, 87, 145, 0.10);
        font-size: 26px;
    }

    .page-title-box h1,
    .page-title-box h2 {
        margin: 0 0 5px;
        color: #163b61;
        font-size: 27px;
        font-weight: 800;
    }

    .page-title-box p {
        margin: 0;
        color: #607b95;
        font-size: 14px;
    }

    .page-title-action {
        flex-shrink: 0;
    }

    @@media (max-width: 700px) {
        .page-title-box {
            align-items: flex-start;
            flex-direction: column;
            padding: 22px;
        }

        .page-title-action {
            width: 100%;
        }
    }

</style>

<div class="os-page">

    <div class="page-title-box">

        <div class="page-title-content">

            <div class="page-title-icon">
                🔗
            </div>

            <div>
                <h2>Öğretmen - Sınıf</h2>
                <p>Öğretmenlerin görev yapacağı sınıfları yönetin.</p>
            </div>

        </div>

        <div class="page-title-action">
            <a asp-action="Create" class="os-add">
                ＋ Sınıf Ata
            </a>
        </div>

    </div>

    <div class="os-card">

        <div class="os-card-head">

            <div class="os-card-title">
                <span class="os-card-title-icon">🔗</span>
                Atama Listesi
            </div>

            <div class="os-count">
                @Model.Count() Atama
            </div>

        </div>

        <div class="os-table-wrap">

            <table class="os-table">

                <thead>
                    <tr>
                        <th>Öğretmen</th>
                        <th>Sınıf</th>
                        <th>Okul</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var adSoyad = item.Ogretmen?.AdSoyad ?? "Öğretmen";
                            var ilkHarf = string.IsNullOrWhiteSpace(adSoyad)
                                ? "Ö"
                                : adSoyad.Substring(0, 1).ToUpper();

                            <tr>
                                <td>
                                    <div class="os-teacher">
                                        <span class="os-avatar">
                                            @ilkHarf
                                        </span>
                                        <span>@adSoyad</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="os-class">
                                        🎓 @(item.Sinif?.Ad ?? "Sınıf belirtilmemiş")
                                    </span>
                                </td>

                                <td class="os-school">
                                    🏫 @(item.Sinif?.Okul?.Ad ?? "Okul belirtilmemiş")
                                </td>

                                <td>

                                    <div class="os-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="os-edit">
                                            ✏️ Düzenle
                                        </a>

                                        <form asp-action="Delete"
                                              method="post"
                                              style="display:inline;"
                                              onsubmit="return confirm('Bu atamayı silmek istediğinize emin misiniz?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="os-delete">
                                                🗑️ Sil
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="os-empty">
                                <span class="os-empty-icon">🔗</span>
                                Henüz öğretmen-sınıf ataması bulunmuyor.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>



</div>
