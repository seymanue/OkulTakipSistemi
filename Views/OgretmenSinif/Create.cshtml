@model OkulTakipSistemi.Models.OgretmenSinif

@{
    ViewData["Title"] = "Öğretmene Sınıf Ata";
}

<style>
    .sinif-ata-page {
        min-height: calc(100vh - 80px);
        padding: 30px 32px 50px;
        background: #f4f7fb;
    }

    .sinif-ata-header {
        display: flex;
        align-items: center;
        gap: 17px;
        margin-bottom: 26px;
        padding: 26px 30px;
        border: 1px solid #d9eaf8;
        border-radius: 20px;
        background: linear-gradient(135deg, #eaf5ff 0%, #d8ecff 55%, #c7e3fb 100%);
        box-shadow: 0 8px 25px rgba(26, 64, 99, 0.07);
    }

    .sinif-ata-icon {
        width: 54px;
        height: 54px;
        flex: 0 0 54px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        background: #ffffff;
        box-shadow: 0 5px 15px rgba(25, 87, 145, 0.10);
    }

    .sinif-ata-title h2 {
        margin: 0;
        color: #172554;
        font-size: 27px;
        font-weight: 800;
    }

    .sinif-ata-title p {
        margin: 0;
        color: #607b95;
        font-size: 14px;
    }

    .sinif-ata-card {
        max-width: 1100px;
        background: #fff;
        border: 1px solid #dbeafe;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(26, 64, 99, 0.07);
    }

    .sinif-ata-card-head {
        min-height: 64px;
        padding: 0 25px;
        display: flex;
        align-items: center;
        gap: 9px;
        background: linear-gradient(135deg, #f8fbff, #eff6ff);
        border-bottom: 1px solid #dbeafe;
        color: #1e3a8a;
        font-size: 16px;
        font-weight: 800;
    }

    .sinif-ata-card-icon {
        width: 29px;
        height: 29px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #dbeafe;
        font-size: 15px;
    }

    .sinif-ata-body {
        padding: 30px;
    }

    .sinif-ata-info {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 13px 15px;
        margin-bottom: 25px;
        border-radius: 11px;
        background: #f8fbff;
        border: 1px solid #dbeafe;
        color: #475569;
        font-size: 13px;
        line-height: 1.5;
    }

    .sinif-ata-info-icon {
        width: 29px;
        height: 29px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #dbeafe;
        font-size: 14px;
    }

    .sinif-ata-field {
        margin-bottom: 20px;
    }

    .sinif-ata-field label {
        display: block;
        margin-bottom: 8px;
        color: #1e3a8a;
        font-size: 13px;
        font-weight: 700;
    }

    .sinif-ata-select {
        width: 100%;
        height: 48px;
        box-sizing: border-box;
        padding: 0 14px;
        border: 1px solid #cbd5e1;
        border-radius: 11px;
        outline: none;
        background: #fff;
        color: #1e293b;
        font-size: 14px;
        transition: all .2s ease;
    }

    .sinif-ata-select:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, .12);
    }

    .sinif-ata-validation {
        display: block;
        margin-top: 6px;
        color: #dc2626;
        font-size: 12px;
    }

    .sinif-ata-errors {
        margin-bottom: 18px;
        color: #b91c1c;
        font-size: 13px;
    }

    .sinif-ata-errors:empty {
        display: none;
    }

    .sinif-ata-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 27px;
        padding-top: 22px;
        border-top: 1px solid #eef2f7;
    }

    .sinif-ata-save,
    .sinif-ata-cancel {
        min-height: 44px;
        padding: 0 17px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: all .2s ease;
    }

    .sinif-ata-save {
        border: none;
        background: linear-gradient(135deg, #2563eb, #1e3a8a);
        color: #fff;
        box-shadow: 0 7px 18px rgba(37, 99, 235, .20);
        cursor: pointer;
    }

    .sinif-ata-save:hover {
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 10px 23px rgba(37, 99, 235, .28);
    }

    .sinif-ata-cancel {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569 !important;
    }

    .sinif-ata-cancel:hover {
        background: #eff6ff;
        border-color: #dbeafe;
        color: #1d4ed8 !important;
        transform: translateY(-1px);
    }

    @@media (max-width: 700px) {
        .sinif-ata-title h2 {
            font-size: 23px;
        }

        .sinif-ata-body {
            padding: 23px 20px 25px;
        }

        .sinif-ata-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .sinif-ata-save,
        .sinif-ata-cancel {
            width: 100%;
        }
    }
</style>

<div class="sinif-ata-page">

    <div class="sinif-ata-header">

        <div class="sinif-ata-icon">
            🔗
        </div>

        <div class="sinif-ata-title">
            <h2>Öğretmene Sınıf Ata</h2>
            <p>Öğretmenin görev yapacağı sınıfı belirleyin.</p>
        </div>

    </div>

    <div class="sinif-ata-card">

        <div class="sinif-ata-card-head">
            <span class="sinif-ata-card-icon">🔗</span>
            Yeni Öğretmen - Sınıf Ataması
        </div>

        <div class="sinif-ata-body">

            <div asp-validation-summary="All"
                 class="sinif-ata-errors">
            </div>

            <div class="sinif-ata-info">

                <span class="sinif-ata-info-icon">
                    ℹ️
                </span>

                <span>
                    Öğretmeni ve görev yapacağı sınıfı seçerek yeni bir atama oluşturabilirsiniz.
                </span>

            </div>

            <form asp-controller="OgretmenSinif"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="sinif-ata-field">

                    <label asp-for="OgretmenId">
                        Öğretmen
                    </label>

                    <select asp-for="OgretmenId"
                            class="sinif-ata-select">

                        <option value="0">
                            Öğretmen seçiniz
                        </option>

                        @foreach (var ogretmen in ViewBag.Ogretmenler)
                        {
                            <option value="@ogretmen.Id">
                                @ogretmen.AdSoyad
                            </option>
                        }

                    </select>

                    <span asp-validation-for="OgretmenId"
                          class="sinif-ata-validation">
                    </span>

                </div>

                <div class="sinif-ata-field">

                    <label asp-for="SinifId">
                        Sınıf
                    </label>

                    <select asp-for="SinifId"
                            class="sinif-ata-select">

                        <option value="0">
                            Sınıf seçiniz
                        </option>

                        @foreach (var sinif in ViewBag.Siniflar)
                        {
                            <option value="@sinif.Id">
                                @sinif.Ad - @sinif.Okul?.Ad
                            </option>
                        }

                    </select>

                    <span asp-validation-for="SinifId"
                          class="sinif-ata-validation">
                    </span>

                </div>

                <div class="sinif-ata-actions">

                    <button type="submit"
                            class="sinif-ata-save">
                        ✓ Sınıfı Ata
                    </button>

                    <a asp-controller="OgretmenSinif"
                       asp-action="Index"
                       class="sinif-ata-cancel">
                        ← İptal
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
