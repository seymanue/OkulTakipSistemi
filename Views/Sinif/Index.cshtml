@model IEnumerable<OkulTakipSistemi.Models.Sinif>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Sınıflar</h2>
            <p class="text-muted mb-0">
                Okullara bağlı sınıfları yönetin.
            </p>
        </div>

        <a asp-controller="Sinif"
           asp-action="Create"
           class="btn btn-primary">
            ➕ Yeni Sınıf Ekle
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-bordered table-hover align-middle">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Sınıf Adı</th>
                        <th>Okul</th>
                        <th>Durum</th>
                        <th style="width: 280px;">İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center">
                                Henüz sınıf bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var sinif in Model)
                        {
                            <tr>

                                <td>
                                    @sinif.Id
                                </td>

                                <td>
                                    <strong>@sinif.Ad</strong>
                                </td>

                                <td>
                                    @if (sinif.Okul != null)
                                    {
                                        @sinif.Okul.Ad
                                    }
                                    else
                                    {
                                        <span class="text-danger">
                                            Okul atanmadı
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (sinif.Aktif)
                                    {
                                        <span class="badge bg-success">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Pasif
                                        </span>
                                    }
                                </td>

                                <td>

                                    <a asp-controller="Sinif"
                                       asp-action="Edit"
                                       asp-route-id="@sinif.Id"
                                       class="btn btn-warning btn-sm">
                                        ✏️ Düzenle
                                    </a>

                                    <form asp-controller="Sinif"
                                          asp-action="AktifPasif"
                                          method="post"
                                          style="display:inline;">

                                        <input type="hidden"
                                               name="id"
                                               value="@sinif.Id" />

                                        @if (sinif.Aktif)
                                        {
                                            <button type="submit"
                                                    class="btn btn-secondary btn-sm">
                                                Pasif Yap
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-success btn-sm">
                                                Aktif Yap
                                            </button>
                                        }

                                    </form>

                                    <form asp-controller="Sinif"
                                          asp-action="Delete"
                                          method="post"
                                          style="display:inline;">

                                        <input type="hidden"
                                               name="id"
                                               value="@sinif.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Bu sınıfı silmek istediğinize emin misiniz?');">
                                            🗑️ Sil
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>