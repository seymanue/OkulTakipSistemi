@model OkulTakipSistemi.Models.Sinif

@{
    ViewData["Title"] = "Sınıf Ekle";
}

<style>
    .sinif-page {
        min-height: calc(100vh - 80px);
        padding: 30px 32px 50px;
        background: #f4f7fb;
    }

    /* =========================================================
       BAŞLIK
       ========================================================= */

    .sinif-page-header {
        display: flex;
        align-items: center;
        gap: 17px;
        margin-bottom: 26px;
        padding: 26px 30px;
        border: 1px solid #d9eaf8;
        border-radius: 20px;
        background: linear-gradient(
            135deg,
            #eaf5ff 0%,
            #d8ecff 55%,
            #c7e3fb 100%
        );
        box-shadow: 0 8px 25px rgba(26, 64, 99, 0.07);
    }

    .sinif-page-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 54px;
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 5px 15px rgba(25, 87, 145, 0.10);
        font-size: 26px;
    }

    .sinif-page-header h1 {
        margin: 0 0 5px;
        color: #163b61;
        font-size: 27px;
        font-weight: 800;
        line-height: 1.2;
    }

    .sinif-page-header p {
        margin: 0;
        color: #607b95;
        font-size: 14px;
    }

    /* =========================================================
       FORM KARTI
       ========================================================= */

    .sinif-form-wrapper {
        width: 100%;
        max-width: 1100px;
    }

    .sinif-form-card {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e3ebf3;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(26, 64, 99, 0.06);
        overflow: hidden;
    }

    .sinif-card-header {
        display: flex;
        align-items: center;
        min-height: 64px;
        padding: 0 26px;
        border-bottom: 1px solid #edf2f6;
        background: #ffffff;
    }

    .sinif-card-header-title {
        color: #294b6d;
        font-size: 15px;
        font-weight: 750;
    }

    .sinif-card-body {
        padding: 30px;
    }

    /* =========================================================
       FORM ALANLARI
       ========================================================= */

    .sinif-form-group {
        margin-bottom: 24px;
    }

    .sinif-form-label {
        display: block;
        margin-bottom: 9px;
        color: #38546f;
        font-size: 13px;
        font-weight: 700;
    }

    .sinif-form-control {
        width: 100%;
        min-height: 48px;
        padding: 11px 14px;
        border: 1px solid #d9e5ef;
        border-radius: 11px;
        background: #fbfdff;
        color: #34495e;
        font-size: 13px;
        outline: none;
        transition: border-color .2s ease,
                    box-shadow .2s ease,
                    background .2s ease;
    }

    .sinif-form-control:focus {
        border-color: #6aa9df;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(66, 141, 204, 0.10);
    }

    .sinif-form-control:disabled {
        background: #f1f5f8;
        color: #9aa8b5;
        cursor: not-allowed;
    }

    select.sinif-form-control {
        cursor: pointer;
    }

    select.sinif-form-control:disabled {
        cursor: not-allowed;
    }

    /* =========================================================
       MEVCUT SINIFLAR
       ========================================================= */

    .sinif-mevcut-card {
        display: none;
        margin-top: -3px;
        margin-bottom: 24px;
        padding: 18px;
        border: 1px solid #dceaf5;
        border-radius: 13px;
        background: #f7fbff;
    }

    .sinif-mevcut-baslik {
        margin-bottom: 12px;
        color: #526b82;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .55px;
    }

    .sinif-mevcut-liste {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .sinif-mevcut-item {
        display: inline-flex;
        align-items: center;
        min-height: 32px;
        padding: 6px 12px;
        border: 1px solid #d7e7f4;
        border-radius: 9px;
        background: #ffffff;
        color: #315f8d;
        font-size: 12px;
        font-weight: 650;
        box-shadow: 0 2px 7px rgba(30, 91, 153, 0.04);
    }

    .sinif-mevcut-yok {
        color: #91a0ae;
        font-size: 12px;
    }

    .sinif-info {
        display: none;
        margin-top: -10px;
        margin-bottom: 22px;
        color: #7b91a5;
        font-size: 12px;
    }

    /* =========================================================
       HATA
       ========================================================= */

    .sinif-validation {
        margin-bottom: 22px;
        padding: 12px 14px;
        border: 1px solid #f2d5d5;
        border-radius: 10px;
        background: #fff6f6;
        color: #b44a4a;
        font-size: 12px;
    }

    .sinif-validation:empty {
        display: none;
    }

    .sinif-field-error {
        display: block;
        margin-top: 6px;
        font-size: 11px;
    }

    /* =========================================================
       BUTONLAR
       ========================================================= */

    .sinif-form-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 8px;
        padding-top: 24px;
        border-top: 1px solid #edf2f6;
    }

    .sinif-save-btn,
    .sinif-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 44px;
        padding: 10px 18px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: transform .2s ease,
                    box-shadow .2s ease,
                    background .2s ease;
    }

    .sinif-save-btn {
        border: none;
        background: linear-gradient(135deg, #2878e8, #174ea6);
        color: #ffffff;
        box-shadow: 0 6px 16px rgba(23, 78, 166, 0.18);
    }

    .sinif-save-btn:hover:not(:disabled) {
        transform: translateY(-1px);
        color: #ffffff;
        box-shadow: 0 9px 22px rgba(23, 78, 166, 0.24);
    }

    .sinif-save-btn:disabled {
        background: #b8c6d3;
        color: #ffffff;
        cursor: not-allowed;
        box-shadow: none;
    }

    .sinif-back-btn {
        border: 1px solid #d9e5ef;
        background: #f7fafd;
        color: #526b82;
    }

    .sinif-back-btn:hover {
        background: #edf4fa;
        color: #315f8d;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 900px) {
        .sinif-page {
            padding: 24px 20px 40px;
        }

        .sinif-page-header {
            padding: 22px;
        }

        .sinif-form-wrapper {
            max-width: 100%;
        }
    }

    @@media (max-width: 700px) {
        .sinif-page {
            padding: 20px 16px 30px;
        }

        .sinif-page-header {
            align-items: flex-start;
            padding: 20px;
        }

        .sinif-page-icon {
            flex: 0 0 48px;
            width: 48px;
            height: 48px;
            font-size: 23px;
        }

        .sinif-page-header h1 {
            font-size: 23px;
        }

        .sinif-page-header p {
            font-size: 13px;
        }

        .sinif-card-body {
            padding: 22px;
        }

        .sinif-form-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .sinif-save-btn,
        .sinif-back-btn {
            width: 100%;
        }
    }
</style>

<div class="sinif-page">

    <!-- =====================================================
         BAŞLIK
         ===================================================== -->

    <div class="sinif-page-header">

        <div class="sinif-page-icon">
            📚
        </div>

        <div>
            <h1>Sınıf Ekle</h1>

            <p>
                Önce okulu seçin, ardından yeni sınıfı ekleyin.
            </p>
        </div>

    </div>


    <!-- =====================================================
         FORM
         ===================================================== -->

    <div class="sinif-form-wrapper">

        <div class="sinif-form-card">

            <div class="sinif-card-header">
                <div class="sinif-card-header-title">
                    Sınıf Bilgileri
                </div>
            </div>

            <div class="sinif-card-body">

                <form asp-controller="Sinif"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="sinif-validation">
                    </div>


                    <!-- OKUL -->

                    <div class="sinif-form-group">

                        <label asp-for="OkulId"
                               class="sinif-form-label">
                            Okul
                        </label>

                        <select asp-for="OkulId"
                                id="okulSelect"
                                class="sinif-form-control">

                            <option value="">
                                -- Önce Okul Seçiniz --
                            </option>

                            @foreach (var okul in ViewBag.Okullar)
                            {
                                if (Model != null && Model.OkulId == okul.Id)
                                {
                                    <option value="@okul.Id" selected>
                                        @okul.Ad — @okul.Adres
                                    </option>
                                }
                                else
                                {
                                    <option value="@okul.Id">
                                        @okul.Ad — @okul.Adres
                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="OkulId"
                              class="text-danger sinif-field-error">
                        </span>

                    </div>


                    <!-- MEVCUT SINIFLAR -->

                    <div id="mevcutSiniflar"
                         class="sinif-mevcut-card">

                        <div class="sinif-mevcut-baslik">
                            Bu okuldaki mevcut sınıflar
                        </div>

                        <div id="sinifListesi"
                             class="sinif-mevcut-liste">
                        </div>

                    </div>


                    <!-- SINIF ADI -->

                    <div class="sinif-form-group">

                        <label asp-for="Ad"
                               class="sinif-form-label">
                            Yeni Sınıf Adı
                        </label>

                        <input asp-for="Ad"
                               id="sinifAd"
                               class="sinif-form-control"
                               placeholder="Önce okul seçiniz"
                               disabled />

                        <span asp-validation-for="Ad"
                              class="text-danger sinif-field-error">
                        </span>

                    </div>


                    <div id="sinifInfo"
                         class="sinif-info">
                        Seçtiğiniz okula yeni bir sınıf ekliyorsunuz.
                    </div>


                    <!-- BUTONLAR -->

                    <div class="sinif-form-actions">

                        <button type="submit"
                                id="kaydetBtn"
                                class="sinif-save-btn"
                                disabled>
                            💾 Sınıfı Kaydet
                        </button>

                        <a asp-controller="Sinif"
                           asp-action="Index"
                           class="sinif-back-btn">
                            ← İptal
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const okulSelect = document.getElementById("okulSelect");
        const sinifAd = document.getElementById("sinifAd");
        const kaydetBtn = document.getElementById("kaydetBtn");
        const mevcutSiniflar = document.getElementById("mevcutSiniflar");
        const sinifListesi = document.getElementById("sinifListesi");
        const sinifInfo = document.getElementById("sinifInfo");

        const siniflar = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                ((IEnumerable<OkulTakipSistemi.Models.Sinif>)ViewBag.Siniflar ?? Enumerable.Empty<OkulTakipSistemi.Models.Sinif>())
                    .Select(x => new { x.Id, x.Ad, x.OkulId })
            )
        );

        function okulDegisti() {

            const okulId = parseInt(okulSelect.value);

            sinifListesi.innerHTML = "";

            if (!okulId) {

                sinifAd.disabled = true;
                kaydetBtn.disabled = true;

                sinifAd.placeholder = "Önce okul seçiniz";
                mevcutSiniflar.style.display = "none";
                sinifInfo.style.display = "none";

                return;
            }

            sinifAd.disabled = false;
            kaydetBtn.disabled = false;
            sinifAd.placeholder = "Örn: 5-A";

            const okulSiniflari = siniflar.filter(
                x => x.OkulId === okulId
            );

            mevcutSiniflar.style.display = "block";
            sinifInfo.style.display = "block";

            if (okulSiniflari.length === 0) {

                sinifListesi.innerHTML =
                    '<span class="sinif-mevcut-yok">Bu okula ait henüz sınıf bulunmuyor.</span>';

                return;
            }

            okulSiniflari.forEach(function (sinif) {

                const item = document.createElement("span");

                item.className = "sinif-mevcut-item";
                item.textContent = sinif.Ad;

                sinifListesi.appendChild(item);
            });
        }

        okulSelect.addEventListener("change", okulDegisti);

        if (okulSelect.value) {
            okulDegisti();
        }

    });
</script>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
