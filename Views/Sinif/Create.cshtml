@model OkulTakipSistemi.Models.Sinif

@{
    ViewData["Title"] = "Sınıf Ekle";
}

<style>
    .sinif-form-page {
        padding: 30px 38px 40px;
    }

    .sinif-form-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 28px;
    }

    .sinif-form-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: linear-gradient(135deg, #62afe4, #1e5b99);
        color: white;
        font-size: 24px;
        box-shadow: 0 8px 20px rgba(30, 91, 153, .18);
    }

    .sinif-form-title {
        margin: 0;
        color: #17375e;
        font-size: 27px;
        font-weight: 700;
    }

    .sinif-form-subtitle {
        margin: 5px 0 0;
        color: #8a9bad;
        font-size: 13px;
    }

    .sinif-form-card {
        max-width: 720px;
        background: white;
        border: 1px solid #e5edf4;
        border-radius: 17px;
        box-shadow: 0 7px 25px rgba(38, 67, 95, .07);
        padding: 28px;
    }

    .sinif-form-group {
        margin-bottom: 21px;
    }

    .sinif-form-label {
        display: block;
        margin-bottom: 8px;
        color: #38546f;
        font-size: 13px;
        font-weight: 650;
    }

    .sinif-form-control {
        width: 100%;
        min-height: 46px;
        padding: 10px 13px;
        border: 1px solid #dce6ef;
        border-radius: 10px;
        background: #fbfdff;
        color: #34495e;
        font-size: 13px;
        outline: none;
        transition: .2s ease;
    }

    .sinif-form-control:focus {
        border-color: #6aa9df;
        background: white;
        box-shadow: 0 0 0 3px rgba(66, 141, 204, .10);
    }

    .sinif-form-control:disabled {
        background: #f1f5f8;
        color: #9aa8b5;
        cursor: not-allowed;
    }

    .sinif-mevcut-card {
        display: none;
        margin-top: 4px;
        margin-bottom: 21px;
        padding: 15px;
        border-radius: 11px;
        background: #f5f9fd;
        border: 1px solid #e3edf5;
    }

    .sinif-mevcut-baslik {
        margin-bottom: 10px;
        color: #526b82;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .sinif-mevcut-liste {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }

    .sinif-mevcut-item {
        padding: 6px 10px;
        border-radius: 7px;
        background: white;
        border: 1px solid #dce8f1;
        color: #315f8d;
        font-size: 11px;
        font-weight: 600;
    }

    .sinif-mevcut-yok {
        color: #91a0ae;
        font-size: 11px;
    }

    .sinif-info {
        display: none;
        margin-top: -7px;
        margin-bottom: 20px;
        color: #8a9bad;
        font-size: 11px;
    }

    .sinif-form-actions {
        display: flex;
        gap: 10px;
        margin-top: 8px;
    }

    .sinif-save-btn,
    .sinif-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 42px;
        padding: 9px 17px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 650;
        cursor: pointer;
        transition: .2s ease;
    }

    .sinif-save-btn {
        border: none;
        background: linear-gradient(135deg, #2878e8, #174ea6);
        color: white;
        box-shadow: 0 6px 16px rgba(23, 78, 166, .18);
    }

    .sinif-save-btn:hover {
        transform: translateY(-1px);
        color: white;
        box-shadow: 0 8px 20px rgba(23, 78, 166, .24);
    }

    .sinif-back-btn {
        border: 1px solid #dce6ef;
        background: #f6f9fc;
        color: #526b82;
    }

    .sinif-back-btn:hover {
        background: #edf4fa;
        color: #315f8d;
    }

    .sinif-validation {
        margin-bottom: 18px;
        padding: 11px 13px;
        border-radius: 9px;
        background: #fff4f4;
        color: #b44a4a;
        font-size: 12px;
    }

    .sinif-field-error {
        display: block;
        margin-top: 6px;
        font-size: 11px;
    }

    @@media (max-width: 800px) {
        .sinif-form-page {
            padding: 22px 18px 30px;
        }

        .sinif-form-card {
            padding: 21px;
        }

        .sinif-form-actions {
            flex-direction: column;
        }

        .sinif-save-btn,
        .sinif-back-btn {
            width: 100%;
        }
    }
</style>

<div class="sinif-form-page">

    <div class="sinif-form-header">

        <div class="sinif-form-icon">
            📚
        </div>

        <div>
            <h1 class="sinif-form-title">
                Sınıf Ekle
            </h1>

            <p class="sinif-form-subtitle">
                Önce okulu seçin, ardından yeni sınıfı ekleyin.
            </p>
        </div>

    </div>


    <div class="sinif-form-card">

        <form asp-controller="Sinif"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="sinif-validation">
            </div>


            <!-- OKUL ÖNCE -->
            <div class="sinif-form-group">

                <label asp-for="OkulId"
                       class="sinif-form-label">
                    Okul
                </label>

                <select asp-for="OkulId"
                        id="okulSelect"
                        class="sinif-form-control">

                    <option value="">
                        -- Önce Okul Seçiniz --
                    </option>

                    @foreach (var okul in ViewBag.Okullar)
                    {
                        if (Model != null && Model.OkulId == okul.Id)
                        {
                            <option value="@okul.Id" selected>
                                @okul.Ad
                            </option>
                        }
                        else
                        {
                            <option value="@okul.Id">
                                @okul.Ad
                            </option>
                        }
                    }

                </select>

                <span asp-validation-for="OkulId"
                      class="text-danger sinif-field-error">
                </span>

            </div>


            <!-- MEVCUT SINIFLAR -->
            <div id="mevcutSiniflar"
                 class="sinif-mevcut-card">

                <div class="sinif-mevcut-baslik">
                    Bu okuldaki mevcut sınıflar
                </div>

                <div id="sinifListesi"
                     class="sinif-mevcut-liste">
                </div>

            </div>


            <!-- SINIF ADI -->
            <div class="sinif-form-group">

                <label asp-for="Ad"
                       class="sinif-form-label">
                    Yeni Sınıf Adı
                </label>

                <input asp-for="Ad"
                       id="sinifAd"
                       class="sinif-form-control"
                       placeholder="Önce okul seçiniz"
                       disabled />

                <span asp-validation-for="Ad"
                      class="text-danger sinif-field-error">
                </span>

            </div>


            <div id="sinifInfo"
                 class="sinif-info">
                Seçtiğiniz okula yeni bir sınıf ekliyorsunuz.
            </div>


            <div class="sinif-form-actions">

                <button type="submit"
                        id="kaydetBtn"
                        class="sinif-save-btn"
                        disabled>
                    💾 Sınıfı Kaydet
                </button>

                <a asp-controller="Sinif"
                   asp-action="Index"
                   class="sinif-back-btn">
                    ← Geri
                </a>

            </div>

        </form>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const okulSelect = document.getElementById("okulSelect");
        const sinifAd = document.getElementById("sinifAd");
        const kaydetBtn = document.getElementById("kaydetBtn");
        const mevcutSiniflar = document.getElementById("mevcutSiniflar");
        const sinifListesi = document.getElementById("sinifListesi");
        const sinifInfo = document.getElementById("sinifInfo");

        const siniflar = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                ((IEnumerable<OkulTakipSistemi.Models.Sinif>)ViewBag.Siniflar ?? Enumerable.Empty<OkulTakipSistemi.Models.Sinif>())
                    .Select(x => new { x.Id, x.Ad, x.OkulId })
            )
        );

        function okulDegisti() {

            const okulId = parseInt(okulSelect.value);

            sinifListesi.innerHTML = "";

            if (!okulId) {

                sinifAd.disabled = true;
                kaydetBtn.disabled = true;

                sinifAd.placeholder = "Önce okul seçiniz";
                mevcutSiniflar.style.display = "none";
                sinifInfo.style.display = "none";

                return;
            }

            sinifAd.disabled = false;
            kaydetBtn.disabled = false;
            sinifAd.placeholder = "Örn: 5-A";

            const okulSiniflari = siniflar.filter(x => x.OkulId === okulId);

            mevcutSiniflar.style.display = "block";
            sinifInfo.style.display = "block";

            if (okulSiniflari.length === 0) {

                sinifListesi.innerHTML =
                    '<span class="sinif-mevcut-yok">Bu okula ait henüz sınıf bulunmuyor.</span>';

                return;
            }

            okulSiniflari.forEach(function (sinif) {

                const item = document.createElement("span");

                item.className = "sinif-mevcut-item";
                item.textContent = sinif.Ad;

                sinifListesi.appendChild(item);
            });
        }

        okulSelect.addEventListener("change", okulDegisti);

        if (okulSelect.value) {
            okulDegisti();
        }

    });
</script>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
