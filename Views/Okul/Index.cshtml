@model IEnumerable<OkulTakipSistemi.Models.Okul>

@{
    ViewData["Title"] = "Okullar";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Okullar</h2>
            <p class="text-muted">Sistemde kayıtlı okulları yönetin.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Okul Ekle
        </a>
    </div>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Okul Adı</th>
                <th>Adres</th>
                <th>Telefon</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var okul in Model)
            {
                <tr>
                    <td>@okul.Id</td>
                    <td>@okul.Ad</td>
                    <td>@okul.Adres</td>
                    <td>@okul.Telefon</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@okul.Id"
                           class="btn btn-warning btn-sm">
                            ✏️ Düzenle
                        </a>

                        <form asp-action="Delete"
                              method="post"
                              style="display:inline;">

                            <input type="hidden"
                                   name="id"
                                   value="@okul.Id" />

                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Bu okulu silmek istediğinize emin misiniz?');">
                                🗑️ Sil
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
