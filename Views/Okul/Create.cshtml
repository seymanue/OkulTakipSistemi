@model OkulTakipSistemi.Models.Okul

@{
    ViewData["Title"] = "Okul Ekle";
}

<div class="container mt-4">

    <h2>Okul Ekle</h2>
    <p class="text-muted">Yeni okul bilgilerini girin.</p>

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label class="form-label">Okul Adı</label>
            <input asp-for="Ad"
                   class="form-control"
                   placeholder="Örneğin: İstanbul Özel Eğitim Merkezi" />
        </div>

        <div class="mb-3">
            <label class="form-label">Adres</label>
            <input asp-for="Adres"
                   class="form-control"
                   placeholder="Okul adresi" />
        </div>

        <div class="mb-3">
            <label class="form-label">Telefon</label>
            <input asp-for="Telefon"
                   class="form-control"
                   placeholder="0212 000 00 00" />
        </div>

        <button type="submit" class="btn btn-primary">
            Kaydet
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            İptal
        </a>

    </form>

</div>