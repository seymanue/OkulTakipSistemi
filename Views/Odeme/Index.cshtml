@model IEnumerable<OkulTakipSistemi.Models.Odeme>

@{
    ViewData["Title"] = "Ücret ve Ödemeler";

    var ogrenciler = ViewBag.Ogrenciler as List<OkulTakipSistemi.Models.Ogrenci>
                     ?? new List<OkulTakipSistemi.Models.Ogrenci>();

    var seciliOgrenciId = ViewBag.SeciliOgrenciId as int?;
    var ogrenci = ViewBag.Ogrenci as OkulTakipSistemi.Models.Ogrenci;
    var kayit = ViewBag.Kayit as OkulTakipSistemi.Models.OgrenciKaydi;
    var veli = ViewBag.Veli as OkulTakipSistemi.Models.Veli;

    var borclar = ViewBag.Borclar as List<OkulTakipSistemi.Models.AylikBorc>
                   ?? new List<OkulTakipSistemi.Models.AylikBorc>();

    decimal toplamBorc = ViewBag.ToplamBorc ?? 0m;
    decimal toplamOdenen = ViewBag.ToplamOdenen ?? 0m;
    decimal toplamKalan = ViewBag.ToplamKalan ?? 0m;

    int odenenSayisi = borclar.Count(x => x.Odendi);
    int bekleyenSayisi = borclar.Count(x => !x.Odendi);
}

<style>
    .ucret-page {
        padding: 30px;
        min-height: 100vh;
        background: linear-gradient(180deg, #f4f9ff 0%, #eef5fc 100%);
    }

    /* HEADER */
    .ucret-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
    }

    .ucret-title-area {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .ucret-title-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: linear-gradient(135deg, #1677d2, #0b4f91);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        box-shadow: 0 8px 20px rgba(11, 79, 145, .20);
    }

    .ucret-header h2 {
        margin: 0;
        font-size: 27px;
        font-weight: 750;
        color: #172033;
    }

    .ucret-header p {
        margin: 5px 0 0;
        color: #718096;
        font-size: 14px;
    }

    /* CARDS */
    .ucret-card {
        background: #ffffff;
        border: 1px solid #e4edf7;
        border-radius: 18px;
        box-shadow: 0 6px 22px rgba(34, 74, 120, .07);
        margin-bottom: 22px;
        overflow: hidden;
    }

    .ucret-card-header {
        padding: 18px 22px;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ucret-card-header h5 {
        margin: 0;
        font-weight: 700;
        color: #172033;
    }

    .ucret-card-body {
        padding: 22px;
    }

    /* ÖĞRENCİ SEÇİM */
    .secim-box {
        background: linear-gradient(135deg, #edf6ff, #f8fbff);
        border: 1px solid #dbeafa;
        border-radius: 14px;
        padding: 20px;
    }

    .form-label {
        color: #334155;
        font-size: 13px;
    }

    .form-select {
        border: 1px solid #d6e2ef;
        border-radius: 11px;
        min-height: 46px;
        box-shadow: none;
    }

    .form-select:focus {
        border-color: #2384dc;
        box-shadow: 0 0 0 3px rgba(35, 132, 220, .10);
    }

    .btn-ucret {
        border: 0;
        border-radius: 11px;
        min-height: 46px;
        font-weight: 650;
        background: linear-gradient(135deg, #1677d2, #0b579f);
        color: white;
        box-shadow: 0 5px 14px rgba(22, 119, 210, .20);
    }

    .btn-ucret:hover {
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 7px 18px rgba(22, 119, 210, .28);
    }

    .btn-odeme {
        border: 0;
        border-radius: 10px;
        padding: 9px 17px;
        font-weight: 650;
        background: linear-gradient(135deg, #168b62, #116b4d);
        color: white;
    }

    .btn-odeme:hover {
        color: white;
        transform: translateY(-1px);
    }

    /* ÖĞRENCİ BİLGİ */
    .ogrenci-panel {
        background: linear-gradient(135deg, #eaf5ff, #f8fbff);
        border: 1px solid #d9eafb;
        border-radius: 15px;
        padding: 22px;
    }

    .ogrenci-ana-bilgi {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 22px;
    }

    .ogrenci-avatar {
        width: 55px;
        height: 55px;
        flex-shrink: 0;
        border-radius: 15px;
        background: linear-gradient(135deg, #1c82d6, #0a579c);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .ogrenci-ana-bilgi h4 {
        margin: 0;
        color: #172033;
        font-weight: 750;
        font-size: 20px;
    }

    .ogrenci-ana-bilgi span {
        display: block;
        margin-top: 3px;
        color: #718096;
        font-size: 13px;
    }

    .bilgi-item {
        background: rgba(255,255,255,.75);
        border: 1px solid #e2edf7;
        border-radius: 11px;
        padding: 13px 15px;
        height: 100%;
    }

    .bilgi-label {
        display: block;
        color: #7a899b;
        font-size: 11px;
        font-weight: 650;
        text-transform: uppercase;
        letter-spacing: .3px;
        margin-bottom: 5px;
    }

    .bilgi-deger {
        color: #253449;
        font-size: 14px;
        font-weight: 650;
    }

    /* ÖZET */
    .ozet-card {
        background: #fff;
        border: 1px solid #e4edf7;
        border-radius: 16px;
        padding: 21px;
        box-shadow: 0 5px 18px rgba(34, 74, 120, .06);
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .ozet-card::after {
        content: "";
        position: absolute;
        right: -25px;
        top: -25px;
        width: 85px;
        height: 85px;
        border-radius: 50%;
        background: #edf6ff;
    }

    .ozet-icon {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #edf6ff;
        color: #1677d2;
        font-size: 19px;
        margin-bottom: 14px;
    }

    .ozet-label {
        color: #7a899b;
        font-size: 12px;
        font-weight: 650;
        margin-bottom: 5px;
    }

    .ozet-tutar {
        color: #172033;
        font-size: 24px;
        font-weight: 750;
    }

    .ozet-alt {
        margin-top: 5px;
        color: #8a97a8;
        font-size: 12px;
    }

    .ozet-odenen .ozet-icon {
        background: #e8f8f0;
        color: #16845c;
    }

    .ozet-kalan .ozet-icon {
        background: #fff0ef;
        color: #dc4c4c;
    }

    /* DURUM ÖZETİ */
    .durum-mini {
        display: flex;
        gap: 8px;
        margin-top: 7px;
        font-size: 12px;
    }

    .durum-mini span {
        padding: 4px 8px;
        border-radius: 7px;
        background: #f1f5f9;
        color: #64748b;
    }

    /* TABLO */
    .tablo-wrapper {
        overflow-x: auto;
    }

    .ucret-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .ucret-table thead th {
        background: #f5f8fc;
        color: #617086;
        font-size: 11px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .35px;
        padding: 15px 16px;
        border-bottom: 1px solid #e5edf5;
        white-space: nowrap;
    }

    .ucret-table tbody td {
        padding: 17px 16px;
        border-bottom: 1px solid #edf2f7;
        color: #334155;
        font-size: 13px;
        vertical-align: middle;
        white-space: nowrap;
    }

    .ucret-table tbody tr {
        transition: background .18s ease;
    }

    .ucret-table tbody tr:hover {
        background: #f8fbff;
    }

    .ucret-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .ay-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-weight: 700;
        color: #26364b;
    }

    .ay-nokta {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #2b86d3;
    }

    .tutar {
        font-weight: 700;
        color: #26364b;
    }

    .tutar-odenen {
        color: #16845c;
        font-weight: 700;
    }

    .tutar-kalan {
        color: #d94a4a;
        font-weight: 700;
    }

    .tarih {
        color: #596a7e;
    }

    .durum-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .durum-odendi {
        background: #e5f7ee;
        color: #16845c;
    }

    .durum-kismi {
        background: #fff4d6;
        color: #a16d00;
    }

    .durum-odenmedi {
        background: #ffe8e8;
        color: #d44747;
    }

    .aciklama {
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #69788a;
    }

    /* TOPLAM SATIR */
    .ucret-table tfoot td {
        padding: 16px;
        background: #f6f9fc;
        border-top: 1px solid #e5edf5;
        font-size: 13px;
        font-weight: 750;
    }

    /* BOŞ */
    .bos-alan {
        text-align: center;
        padding: 60px 20px;
    }

    .bos-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 15px;
        border-radius: 18px;
        background: #edf6ff;
        color: #1677d2;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
    }

    .bos-alan h5 {
        color: #334155;
        font-weight: 700;
    }

    .bos-alan p {
        color: #8290a0;
        font-size: 13px;
    }

    @@media (max-width: 768px) {
        .ucret-page {
            padding: 18px;
        }

        .ucret-header {
            align-items: flex-start;
        }

        .ucret-title-icon {
            width: 48px;
            height: 48px;
            font-size: 23px;
        }

        .ucret-header h2 {
            font-size: 22px;
        }

        .ucret-table thead th,
        .ucret-table tbody td {
            padding: 13px 11px;
        }
    }

    .page-title-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
        padding: 26px 30px;
        border: 1px solid #d9eaf8;
        border-radius: 20px;
        background: linear-gradient(135deg, #eaf5ff 0%, #d8ecff 55%, #c7e3fb 100%);
        box-shadow: 0 8px 25px rgba(26, 64, 99, 0.07);
    }

    .page-title-content {
        display: flex;
        align-items: center;
        gap: 17px;
        min-width: 0;
    }

    .page-title-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 54px;
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 5px 15px rgba(25, 87, 145, 0.10);
        font-size: 26px;
    }

    .page-title-box h1,
    .page-title-box h2 {
        margin: 0 0 5px;
        color: #163b61;
        font-size: 27px;
        font-weight: 800;
    }

    .page-title-box p {
        margin: 0;
        color: #607b95;
        font-size: 14px;
    }

    .page-title-action {
        flex-shrink: 0;
    }

    @@media (max-width: 700px) {
        .page-title-box {
            align-items: flex-start;
            flex-direction: column;
            padding: 22px;
        }

        .page-title-action {
            width: 100%;
        }
    }

</style>

<div class="container-fluid ucret-page">

    <!-- BAŞLIK -->
    <div class="page-title-box">

        <div class="page-title-content">

            <div class="page-title-icon">
                💰
            </div>

            <div>
                <h2>Ücret ve Ödemeler</h2>
                <p>Öğrencilerin aylık ücret ve ödeme durumlarını takip edin.</p>
            </div>

        </div>

    </div>


    <!-- MESAJLAR -->
    @if (TempData["Basarili"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm">
            ✓ @TempData["Basarili"]
        </div>
    }

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm">
            ⚠ @TempData["Hata"]
        </div>
    }


    <!-- ÖĞRENCİ SEÇ -->
    <div class="ucret-card">

        <div class="ucret-card-header">
            <h5>👤 Öğrenci Seç</h5>
        </div>

        <div class="ucret-card-body">

            <div class="secim-box">

                <form asp-action="Index" method="get">

                    <div class="row align-items-end g-3">

                        <div class="col-md-9">

                            <label class="form-label fw-semibold">
                                Öğrenci
                            </label>

                            <select name="ogrenciId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Öğrenci seçiniz
                                </option>

                                @foreach (var o in ogrenciler)
                                {
                                    if (seciliOgrenciId == o.Id)
                                    {
                                        <option value="@o.Id" selected>
                                            @o.AdSoyad - @o.OgrenciNo
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@o.Id">
                                            @o.AdSoyad - @o.OgrenciNo
                                        </option>
                                    }
                                }

                            </select>

                        </div>

                        <div class="col-md-3">

                            <button type="submit"
                                    class="btn btn-ucret w-100">
                                Öğrenciyi Getir
                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>


    @if (ogrenci != null)
    {
        <!-- ÖĞRENCİ BİLGİLERİ -->
        <div class="ucret-card">

            <div class="ucret-card-header">
                <h5>🎓 Öğrenci Bilgileri</h5>
            </div>

            <div class="ucret-card-body">

                <div class="ogrenci-panel">

                    <div class="ogrenci-ana-bilgi">

                        <div class="ogrenci-avatar">
                            👤
                        </div>

                        <div>
                            <h4>@ogrenci.AdSoyad</h4>
                            <span>Öğrenci No: @ogrenci.OgrenciNo</span>
                        </div>

                    </div>

                    <div class="row g-3">

                        <div class="col-md-4">
                            <div class="bilgi-item">
                                <span class="bilgi-label">Veli</span>
                                <span class="bilgi-deger">
                                    @(veli?.AdSoyad ?? "-")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="bilgi-item">
                                <span class="bilgi-label">Veli Telefonu</span>
                                <span class="bilgi-deger">
                                    @(veli?.Telefon ?? "-")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="bilgi-item">
                                <span class="bilgi-label">Sınıf</span>
                                <span class="bilgi-deger">
                                    @(kayit?.Sinif?.Ad ?? ogrenci.Sinif?.Ad ?? "-")
                                </span>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ÖZET KARTLARI -->
        <div class="row g-3 mb-4">

            <div class="col-md-4">

                <div class="ozet-card">

                    <div class="ozet-icon">
                        ₺
                    </div>

                    <div class="ozet-label">
                        TOPLAM BORÇ
                    </div>

                    <div class="ozet-tutar">
                        @toplamBorc.ToString("N2") ₺
                    </div>

                    <div class="ozet-alt">
                        Öğrencinin toplam ödeme planı
                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="ozet-card ozet-odenen">

                    <div class="ozet-icon">
                        ✓
                    </div>

                    <div class="ozet-label">
                        TOPLAM ÖDENEN
                    </div>

                    <div class="ozet-tutar text-success">
                        @toplamOdenen.ToString("N2") ₺
                    </div>

                    <div class="ozet-alt">
                        Gerçekleşen toplam ödeme
                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="ozet-card ozet-kalan">

                    <div class="ozet-icon">
                        !
                    </div>

                    <div class="ozet-label">
                        KALAN BORÇ
                    </div>

                    <div class="ozet-tutar text-danger">
                        @toplamKalan.ToString("N2") ₺
                    </div>

                    <div class="ozet-alt">
                        Henüz ödenmemiş tutar
                    </div>

                    <div class="durum-mini">
                        <span>✓ @odenenSayisi Ödendi</span>
                        <span>○ @bekleyenSayisi Bekliyor</span>
                    </div>

                </div>

            </div>

        </div>


        <!-- AYLIK ÖDEME DURUMU -->
        <div class="ucret-card">

            <div class="ucret-card-header">

                <div>
                    <h5>📋 Aylık Ödeme Durumu</h5>
                </div>

                <a asp-action="Create"
                   asp-route-ogrenciId="@ogrenci.Id"
                   class="btn btn-odeme">
                    + Ödeme Gir
                </a>

            </div>


            <div class="tablo-wrapper">

                @if (borclar.Any())
                {
                    <table class="table ucret-table mb-0">

                        <thead>

                            <tr>
                                <th>Ay</th>
                                <th>Ödeme Tutarı</th>
                                <th>Ödeme Tarihi</th>
                                <th>Ödenen</th>
                                <th>Kalan</th>
                                <th>Açıklama</th>
                                <th>Durum</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var borc in borclar)
                            {
                                var ayAdi = new DateTime(
                                    borc.Yil,
                                    borc.Ay,
                                    1
                                ).ToString(
                                    "MMMM",
                                    new System.Globalization.CultureInfo("tr-TR")
                                );

                                <tr>

                                    <td>
                                        <span class="ay-badge">
                                            <span class="ay-nokta"></span>
                                            @ayAdi
                                        </span>
                                    </td>

                                    <td class="tutar">
                                        @borc.Tutar.ToString("N2") ₺
                                    </td>

                                    <td class="tarih">
                                        @borc.OdemeTarihi.ToString("dd.MM.yyyy")
                                    </td>

                                    <td class="tutar-odenen">
                                        @borc.OdenenTutar.ToString("N2") ₺
                                    </td>

                                    <td class="tutar-kalan">
                                        @borc.KalanTutar.ToString("N2") ₺
                                    </td>

                                    <td class="aciklama">

                                        @{
                                            var aciklama = borc.OdemeDagilimlari
                                                .Select(x => x.Odeme?.Aciklama)
                                                .FirstOrDefault(
                                                    x => !string.IsNullOrWhiteSpace(x));
                                        }

                                        @(string.IsNullOrWhiteSpace(aciklama)
                                            ? "-"
                                            : aciklama)

                                    </td>

                                    <td>

                                        @if (borc.Odendi)
                                        {
                                            <span class="durum-badge durum-odendi">
                                                ✓ Ödendi
                                            </span>
                                        }
                                        else if (borc.OdenenTutar > 0)
                                        {
                                            <span class="durum-badge durum-kismi">
                                                ◐ Kısmi Ödeme
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="durum-badge durum-odenmedi">
                                                ○ Bekliyor
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                        <tfoot>

                            <tr>

                                <td>TOPLAM</td>

                                <td class="tutar">
                                    @toplamBorc.ToString("N2") ₺
                                </td>

                                <td></td>

                                <td class="tutar-odenen">
                                    @toplamOdenen.ToString("N2") ₺
                                </td>

                                <td class="tutar-kalan">
                                    @toplamKalan.ToString("N2") ₺
                                </td>

                                <td colspan="2"></td>

                            </tr>

                        </tfoot>

                    </table>
                }
                else
                {
                    <div class="bos-alan">

                        <div class="bos-icon">
                            💳
                        </div>

                        <h5>Henüz ödeme planı bulunmuyor.</h5>

                        <p class="mb-0">
                            Bu öğrenci için önce ödeme planı oluşturmalısınız.
                        </p>

                    </div>
                }

            </div>

        </div>
    }

</div>
