
<style>
.odeme-action-buttons {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 26px;
}

.odeme-back-button,
.odeme-save-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 20px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
}

.odeme-back-button {
    color: #5f6f82;
    background: #ffffff;
    border: 1px solid #cfd8e3;
    box-shadow: 0 3px 10px rgba(26, 64, 99, 0.06);
}

.odeme-back-button:hover {
    color: #163b61;
    background: #f4f8fc;
    border-color: #b8c9da;
    transform: translateY(-2px);
}

.odeme-save-button {
    color: #ffffff;
    background: linear-gradient(135deg, #1677f2 0%, #0d6efd 100%);
    border: 1px solid #0d6efd;
    box-shadow: 0 5px 15px rgba(13, 110, 253, 0.20);
    cursor: pointer;
}

.odeme-save-button:hover {
    background: linear-gradient(135deg, #0d6efd 0%, #0959c7 100%);
    box-shadow: 0 7px 18px rgba(13, 110, 253, 0.25);
    transform: translateY(-2px);
}

.odeme-back-button:active,
.odeme-save-button:active {
    transform: translateY(0);
}

@@media (max-width: 600px) {
    .odeme-action-buttons {
        flex-direction: column-reverse;
        align-items: stretch;
    }

    .odeme-back-button,
    .odeme-save-button {
        width: 100%;
    }
}
</style>


<style>
.page-title-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
    padding: 26px 30px;
    border: 1px solid #d9eaf8;
    border-radius: 20px;
    background: linear-gradient(135deg, #eaf5ff 0%, #d8ecff 55%, #c7e3fb 100%);
    box-shadow: 0 8px 25px rgba(26, 64, 99, 0.07);
}

.page-title-content {
    display: flex;
    align-items: center;
    gap: 17px;
    min-width: 0;
}

.page-title-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 54px;
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 5px 15px rgba(25, 87, 145, 0.10);
    font-size: 26px;
}

.page-title-box h1 {
    margin: 0 0 5px;
    color: #163b61;
    font-size: 27px;
    font-weight: 800;
}

.page-title-box p {
    margin: 0;
    color: #607b95;
    font-size: 14px;
}

@@media (max-width: 700px) {
    .page-title-box {
        align-items: flex-start;
        flex-direction: column;
        padding: 22px;
    }
}
</style>

@model OkulTakipSistemi.Models.Odeme

@{
    ViewData["Title"] = "Ödeme Ekle";
}

<div class="container py-4">

    <div class="page-title-box">
        <div class="page-title-content">
            <div class="page-title-icon">💳</div>
            <div>
                <h1>Yeni Ödeme</h1>
                <p>Öğrenciden alınan ödemeyi sisteme kaydedin. Ödeme, öğrencinin açık borçlarına otomatik olarak dağıtılacaktır.</p>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <!-- ÖĞRENCİ -->
                <div class="mb-3">

                    <label asp-for="OgrenciId"
                           class="form-label fw-semibold">
                        Öğrenci
                    </label>

                    <select asp-for="OgrenciId"
                            class="form-select"
                            required>

                        <option value="">
                            -- Öğrenci Seçiniz --
                        </option>

                        @foreach (var ogrenci in ViewBag.Ogrenciler)
                        {
                            <option value="@ogrenci.Id">
                                @ogrenci.AdSoyad
                                -
                                @ogrenci.OgrenciNo
                            </option>
                        }

                    </select>

                    <span asp-validation-for="OgrenciId"
                          class="text-danger"></span>

                </div>

                <!-- TUTAR -->
                <div class="mb-3">

                    <label asp-for="Tutar"
                           class="form-label fw-semibold">
                        Ödeme Tutarı
                    </label>

                    <div class="input-group">

                        <input asp-for="Tutar"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0.01"
                               placeholder="Örn: 30000" />

                        <span class="input-group-text">
                            ₺
                        </span>

                    </div>

                    <span asp-validation-for="Tutar"
                          class="text-danger"></span>

                    <div class="form-text">
                        Girilen ödeme, öğrencinin en eski açık borcundan
                        başlayarak otomatik olarak dağıtılır.
                    </div>

                </div>

                <!-- TARİH -->
                <div class="mb-3">

                    <label asp-for="OdemeTarihi"
                           class="form-label fw-semibold">
                        Ödeme Tarihi
                    </label>

                    <input asp-for="OdemeTarihi"
                           class="form-control"
                           type="date" />

                    <span asp-validation-for="OdemeTarihi"
                          class="text-danger"></span>

                </div>

                <!-- DURUM -->
                <div class="mb-3">

                    <label asp-for="Durum"
                           class="form-label fw-semibold">
                        Durum
                    </label>

                    <select asp-for="Durum"
                            class="form-select">

                        <option value="Ödendi">
                            Ödendi
                        </option>

                        <option value="Bekliyor">
                            Bekliyor
                        </option>

                        <option value="İptal">
                            İptal
                        </option>

                    </select>

                    <span asp-validation-for="Durum"
                          class="text-danger"></span>

                </div>

                <!-- AÇIKLAMA -->
                <div class="mb-4">

                    <label asp-for="Aciklama"
                           class="form-label fw-semibold">
                        Açıklama
                    </label>

                    <textarea asp-for="Aciklama"
                              class="form-control"
                              rows="3"
                              placeholder="Ödeme hakkında açıklama..."></textarea>

                    <span asp-validation-for="Aciklama"
                          class="text-danger"></span>

                </div>

                <!-- BUTONLAR -->
                <div class="odeme-action-buttons">

                    <a asp-action="Index"
                       class="odeme-back-button">
                        ← Geri
                    </a>

                    <button type="submit"
                            class="odeme-save-button">
                        Ödemeyi Kaydet
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
