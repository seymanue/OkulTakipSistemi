@model OkulTakipSistemi.Models.UcretYonetimiViewModel

@{
    ViewData["Title"] = "Ücret ve Ödemeler";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold">💰 Ücret ve Ödemeler</h2>
        <p class="text-muted mb-0">
            Okullar için yıllık ücret ve ödeme koşullarını tanımlayın.
        </p>
    </div>

    @if (TempData["Basarili"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Basarili"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Hata"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-1">
                🏫 Okul Ücret Tanımlama
            </h5>

            <small class="text-muted">
                Seçtiğiniz okulun veli ücretini ve ödeme koşullarını belirleyin.
            </small>
        </div>

        <div class="card-body">

            <!-- OKUL SEÇİMİ -->
            <form method="get"
                  asp-action="Index"
                  class="mb-4">

                <div class="col-md-6 px-0">

                    <label class="form-label fw-semibold">
                        Okul
                    </label>

                    <select name="okulId"
                            class="form-select"
                            onchange="this.form.submit()">

                        <option value="">
                            Okul seçiniz
                        </option>

                        @foreach (var okul in Model.Okullar)
                        {
                            if (Model.SeciliOkulId == okul.Id)
                            {
                                <option value="@okul.Id" selected>
                                    @okul.Ad
                                </option>
                            }
                            else
                            {
                                <option value="@okul.Id">
                                    @okul.Ad
                                </option>
                            }
                        }

                    </select>

                </div>

            </form>


            @if (Model.SeciliOkulId.HasValue)
            {
                <!-- ÜCRET TANIMLAMA -->
                <form asp-action="OkulUcretiKaydet"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="okulId"
                           value="@Model.SeciliOkulId" />

                    <div class="row g-4">

                        <!-- KURUM ÜCRETİ -->
                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Kurum İçin Belirlenen Ücret
                            </label>

                            <div class="input-group">

                                <input type="number"
                                       name="toplamUcret"
                                       class="form-control"
                                       min="0"
                                       step="0.01"
                                       value="@(Model.OkulUcreti?.ToplamUcret > 0 ? Model.OkulUcreti.ToplamUcret.ToString("0.##") : "")"
                                       placeholder="Örn: 120000" />

                                <span class="input-group-text">
                                    ₺
                                </span>

                            </div>

                            <small class="text-muted">
                                Okulun belirlediği toplam yıllık ücret.
                            </small>

                        </div>


                        <!-- STANDART VELİ ÜCRETİ -->
                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Standart Veli Ücreti
                            </label>

                            <div class="input-group">

                                <input type="number"
                                       name="standartVeliUcreti"
                                       class="form-control"
                                       min="0"
                                       step="0.01"
                                       value="@(Model.OkulUcreti?.StandartVeliUcreti > 0 ? Model.OkulUcreti.StandartVeliUcreti?.ToString("0.##") : "")"
                                       placeholder="Örn: 100000" />

                                <span class="input-group-text">
                                    ₺
                                </span>

                            </div>

                            <small class="text-muted">
                                Öğrenci kaydı sırasında veliye uygulanacak ücret.
                            </small>

                        </div>


                        <!-- ÖDEME ŞEKLİ -->
                        <div class="col-md-4">

                            <label class="form-label fw-semibold">
                                Ödeme Şekli
                            </label>

                            <select name="odemeSekli"
                                    id="odemeSekli"
                                    class="form-select">

                                @if (Model.OkulUcreti?.OdemeSekli == "Pesin")
                                {
                                    <option value="Pesin" selected>
                                        Peşin
                                    </option>
                                    <option value="Taksitli">
                                        Taksitli
                                    </option>
                                }
                                else
                                {
                                    <option value="Taksitli" selected>
                                        Taksitli
                                    </option>
                                    <option value="Pesin">
                                        Peşin
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- TAKSİT SAYISI -->
                        <div class="col-md-4"
                             id="taksitAlani">

                            <label class="form-label fw-semibold">
                                Taksit Sayısı
                            </label>

                            <select name="taksitAySayisi"
                                    class="form-select">

                                @for (int i = 1; i <= 8; i++)
                                {
                                    if (Model.OkulUcreti?.TaksitAySayisi == i)
                                    {
                                        <option value="@i" selected>
                                            @i Taksit
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@i">
                                            @i Taksit
                                        </option>
                                    }
                                }

                            </select>

                            <small class="text-muted">
                                Öğrenci kaydında ödeme planı için kullanılır.
                            </small>

                        </div>


                        <!-- BAŞLANGIÇ AYI -->
                        <div class="col-md-4"
                             id="baslangicAyiAlani">

                            <label class="form-label fw-semibold">
                                Başlangıç Ayı
                            </label>

                            <select name="baslangicAyi"
                                    class="form-select">

                                @{
                                    int baslangicAyi =
                                        Model.OkulUcreti?.BaslangicAyi > 0
                                            ? Model.OkulUcreti.BaslangicAyi
                                            : 10;
                                }

                                <option value="10" selected="@(baslangicAyi == 10)">
                                    Ekim
                                </option>

                                <option value="11" selected="@(baslangicAyi == 11)">
                                    Kasım
                                </option>

                                <option value="12" selected="@(baslangicAyi == 12)">
                                    Aralık
                                </option>

                            </select>

                            <small class="text-muted">
                                Ödeme planının başlayacağı ay.
                            </small>

                        </div>


                        <!-- AÇIKLAMA -->
                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Açıklama
                                <span class="text-muted fw-normal">
                                    (Opsiyonel)
                                </span>
                            </label>

                            <textarea name="aciklama"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Ücret hakkında açıklama yazabilirsiniz.">@Model.OkulUcreti?.Aciklama</textarea>

                        </div>

                    </div>


                    <!-- ÖNİZLEME -->
                    @if (Model.OkulUcreti != null &&
                         Model.OkulUcreti.UygulanacakStandartVeliUcreti > 0)
                    {
                        <div class="alert alert-light border mt-4 mb-0">

                            <div class="fw-bold mb-2">
                                📋 Ücret Özeti
                            </div>

                            <div class="row">

                                <div class="col-md-4">
                                    <small class="text-muted">
                                        Yıllık Veli Ücreti
                                    </small>
                                    <div class="fw-bold">
                                        @Model.OkulUcreti.UygulanacakStandartVeliUcreti.ToString("N2") ₺
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <small class="text-muted">
                                        Ödeme Şekli
                                    </small>
                                    <div class="fw-bold">
                                        @(Model.OkulUcreti.OdemeSekli == "Pesin"
                                            ? "Peşin"
                                            : $"{Model.OkulUcreti.TaksitAySayisi} Taksit")
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <small class="text-muted">
                                        Aylık Taksit
                                    </small>
                                    <div class="fw-bold">
                                        @Model.OkulUcreti.AylikUcret.ToString("N2") ₺
                                    </div>
                                </div>

                            </div>

                        </div>
                    }


                    <div class="mt-4">

                        <button type="submit"
                                class="btn btn-primary px-4">

                            💾 Ücreti Kaydet

                        </button>

                    </div>

                </form>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <strong>Okul seçiniz.</strong>
                    Ücret tanımlamak için yukarıdaki listeden bir okul seçin.
                </div>
            }

        </div>

    </div>

</div>

<script>
    function odemeSekliGuncelle() {
        const secim = document.getElementById("odemeSekli");
        const taksitAlani = document.getElementById("taksitAlani");
        const baslangicAlani = document.getElementById("baslangicAyiAlani");

        if (!secim) return;

        if (secim.value === "Pesin") {
            taksitAlani.style.display = "none";
            baslangicAlani.style.display = "none";
        } else {
            taksitAlani.style.display = "";
            baslangicAlani.style.display = "";
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const secim = document.getElementById("odemeSekli");

        if (secim) {
            secim.addEventListener("change", odemeSekliGuncelle);
            odemeSekliGuncelle();
        }
    });
</script>
