@model OkulTakipSistemi.Models.OgrenciUcretDurumu

@{
    ViewData["Title"] = "Yeni Öğrenci Ücret Durumu";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Yeni Öğrenci Ücret Durumu</h2>

        <p class="text-muted">
            Öğrencinin indirim, özel fiyat veya ücretsiz kontenjan durumunu belirleyin.
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row g-3">

                    <!-- ÖĞRENCİ -->
                    <div class="col-12">

                        <label asp-for="OgrenciKaydiId"
                               class="form-label fw-semibold">
                            Öğrenci
                        </label>

                        <select asp-for="OgrenciKaydiId"
                                class="form-select">

                            <option value="">
                                Öğrenci seçiniz
                            </option>

                            @foreach (var kayit in ViewBag.OgrenciKayitlari)
                            {
                                <option value="@kayit.Id">
                                    @kayit.Ogrenci?.AdSoyad
                                    -
                                    @kayit.Ogrenci?.OgrenciNo
                                    |
                                    @kayit.Okul?.Ad
                                    |
                                    @kayit.Sinif?.Ad
                                </option>
                            }

                        </select>

                        <span asp-validation-for="OgrenciKaydiId"
                              class="text-danger"></span>

                    </div>

                    <!-- İNDİRİMLİ -->
                    <div class="col-md-4">

                        <div class="form-check mt-4">

                            <input asp-for="Indirimli"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="Indirimli"
                                   class="form-check-label fw-semibold">
                                İndirimli
                            </label>

                        </div>

                    </div>

                    <!-- İNDİRİM ORANI -->
                    <div class="col-md-4">

                        <label asp-for="IndirimOrani"
                               class="form-label fw-semibold">
                            İndirim Oranı (%)
                        </label>

                        <input asp-for="IndirimOrani"
                               class="form-control"
                               type="number"
                               min="0"
                               max="100"
                               step="0.01" />

                        <span asp-validation-for="IndirimOrani"
                              class="text-danger"></span>

                    </div>

                    <!-- ÜCRETSİZ -->
                    <div class="col-md-4">

                        <div class="form-check mt-4">

                            <input asp-for="Ucretsiz"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="Ucretsiz"
                                   class="form-check-label fw-semibold">
                                Ücretsiz
                            </label>

                        </div>

                    </div>

                    <!-- ÖZEL FİYAT -->
                    <div class="col-md-6">

                        <label asp-for="OzelFiyat"
                               class="form-label fw-semibold">
                            Özel Fiyat (₺)
                        </label>

                        <input asp-for="OzelFiyat"
                               class="form-control"
                               type="number"
                               min="0"
                               step="0.01"
                               placeholder="Özel fiyat yoksa boş bırakın" />

                        <span asp-validation-for="OzelFiyat"
                              class="text-danger"></span>

                    </div>

                    <!-- AÇIKLAMA -->
                    <div class="col-12">

                        <label asp-for="Aciklama"
                               class="form-label fw-semibold">
                            Açıklama
                        </label>

                        <textarea asp-for="Aciklama"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Ücret durumu ile ilgili açıklama..."></textarea>

                        <span asp-validation-for="Aciklama"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="d-flex justify-content-between mt-4">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        ← Geri
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Kaydet
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
